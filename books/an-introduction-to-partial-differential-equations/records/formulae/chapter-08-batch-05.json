    {
      "formula_id": "math:integration-operator-full-example:011",
      "source_latex": "\\[\\begin{aligned}\n\\|\\mathcal{I}(f)\\|_{L^2(0,L)}^2&=\\int_0^L|\\mathcal{I}(f)(x)|^2\\,\\mathrm{d}x\\\\\n&=\\int_0^L\\left(\\int_0^xf(s)\\,\\mathrm{d}s\\right)^2\\,\\mathrm{d}x\\\\\n&\\leq\\int_0^L\\left\\{\\int_0^x\\mathrm{d}s\\right\\}\\left\\{\\int_0^xf(s)^2\\,\\mathrm{d}s\\right\\}\\,\\mathrm{d}x\\\\\n&\\leq\\dfrac{L^2}{2}\\int_0^Lf(s)^2\\,\\mathrm{d}s\\\\\n&=\\dfrac{L^2}{2}\\|f\\|_{L^2(0,L)}^2.\n\\end{aligned}\\]",
      "kind": "display",
