    {
      "formula_id": "math:interior-regularity-full-formal-boundary-integration-chain:001",
      "source_latex": "\\[\\begin{aligned}\n\\int_\\Omega|\\Delta u|^2\\,\\mathrm{d}\\bm{x}\n&=\\sum_{i,j=1}^n\\int_\\Omega u_{x_ix_i}u_{x_jx_j}\\,\\mathrm{d}\\bm{x}\\\\\n&=-\\sum_{i,j=1}^n\\int_\\Omega u_{x_i}u_{x_jx_ix_j}\\,\\mathrm{d}\\bm{x}\\\\\n&\\quad+\\sum_{i,j=1}^n\\int_{\\partial\\Omega}u_{x_i}u_{x_jx_j}\\eta_i\\,\\mathrm{d}S\\\\\n&=\\sum_{i,j=1}^n\\int_\\Omega u_{x_ix_j}u_{x_jx_i}\\,\\mathrm{d}\\bm{x}\\\\\n&\\quad+\\sum_{i,j=1}^n\\int_{\\partial\\Omega}u_{x_i}u_{x_jx_j}\\eta_i-u_{x_i}u_{x_ix_j}\\eta_j\\,\\mathrm{d}S.\n\\end{aligned}\\]",
