    {
      "formula_id": "math:wave-fundamental-solution-example:008",
      "source_latex": "\\begin{equation}\\label{eq:second-order-evolution-fundamental-solution-formula}\n\\begin{aligned}\nu(\\bm{x},t)&=\\int_{\\mathbb{R}^m}G_t(\\bm{x}-\\bm{y},t)u_0(\\bm{y})\\,\\mathrm{d}\\bm{y}\n+\\int_{\\mathbb{R}^m}G(\\bm{x}-\\bm{y},t)u_1(\\bm{y})\\,\\mathrm{d}\\bm{y}\\\\\n&\\quad+\\int_0^t\\int_{\\mathbb{R}^m}G(\\bm{x}-\\bm{y},t-s)f(\\bm{y},s)\\,\\mathrm{d}\\bm{y}\\,\\mathrm{d}s.\n\\end{aligned}\n\\end{equation}",
      "kind": "display",
