      "source_latex": "\\begin{equation}\\label{eq:first-five-legendre-polynomials}\n\\begin{gathered}\nP_0(x)=1,\\quad P_1(x)=x,\\quad P_2(x)=\\dfrac32x^2-\\dfrac12,\\\\\nP_3(x)=\\dfrac52x^3-\\dfrac32x,\\quad P_4(x)=\\dfrac{35}8x^4-\\dfrac{15}4x^2+\\dfrac38.\n\\end{gathered}\n\\end{equation}",
