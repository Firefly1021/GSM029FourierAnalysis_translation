    {
      "formula_id": "math:integral-kernel-row-column-boundedness-full-proof:001",
      "source_latex": "\\[\\begin{aligned}\n\\|Ku\\|_{L^2(\\Omega)}^2&=\\int_{\\Omega}\\left(\\int_{\\Omega}k(\\bm{x},\\bm{y})u(\\bm{y})\\,\\mathrm{d}\\bm{y}\\right)^2\\,\\mathrm{d}\\bm{x}\\\\\n&\\leq\\int_{\\Omega}\\left(\\int_{\\Omega}\\sqrt{|k(\\bm{x},\\bm{y})|}\\sqrt{|k(\\bm{x},\\bm{y})|}u(\\bm{y})\\,\\mathrm{d}\\bm{y}\\right)^2\\,\\mathrm{d}\\bm{x}\\\\\n&\\leq\\int_{\\Omega}\\left\\{\\int_{\\Omega}|k(\\bm{x},\\bm{y})|\\,\\mathrm{d}\\bm{y}\\right\\}\\left\\{\\int_{\\Omega}|k(\\bm{x},\\bm{y})|u(\\bm{y})^2\\,\\mathrm{d}\\bm{y}\\right\\}\\,\\mathrm{d}\\bm{x}\\\\\n&\\leq k_1\\int_{\\Omega}\\int_{\\Omega}|k(\\bm{x},\\bm{y})|u(\\bm{y})^2\\,\\mathrm{d}\\bm{y}\\,\\mathrm{d}\\bm{x}\\\\\n&=k_1\\int_{\\Omega}u(\\bm{y})^2\\int_{\\Omega}|k(\\bm{x},\\bm{y})|\\,\\mathrm{d}\\bm{x}\\,\\mathrm{d}\\bm{y}\\\\\n&\\leq k_1k_2\\|u\\|_{L^2(\\Omega)}^2.\n\\end{aligned}\\]",
      "kind": "display",
