          "image_crop": "workspace/crops/structure/equivalent-integral-equation-p0012.png",
          "raw_ocr": "workspace/raw-text/pdf-0012.txt"
        }
      ],
      "formula_ids": [
        "math:equivalent-integral-equation:001",
