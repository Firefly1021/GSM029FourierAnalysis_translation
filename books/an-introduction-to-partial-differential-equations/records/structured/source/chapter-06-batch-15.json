    {
      "id": "linear-mapping-continuity-boundedness-introduction",
      "type": "ordinary-paragraph",
      "regions": [
        [
          204,
          80,
          535,
          955,
          595
        ]
      ],
      "en": "For linear mappings, the ideas of continuity and boundedness are essentially the same.",
      "zh": "对线性映射, 连续性和有界性的概念本质上相同.",
      "label": null,
      "render_role": "ordinary-paragraph",
      "source_locations": [
        {
          "pdf_page": 204,
          "printed_page": 194,
          "bbox": [
            31.980547112462006,
            213.8918509159823,
            381.7677811550152,
            237.87972204674668
          ],
          "bbox_precision": "visually selected parent block, top-left PDF points",
          "crop": "workspace/crops/chapter-06-batch-15/linear-mapping-continuity-boundedness-introduction-204.png",
          "raw_ocr": "workspace/raw-text/pdf-0204.txt"
        }
