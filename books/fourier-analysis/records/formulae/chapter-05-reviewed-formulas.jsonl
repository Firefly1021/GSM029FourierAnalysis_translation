{"id": "formula-chapter-05-p111-004-dfb931e0a1e67845", "chapter": 5, "source_pdf_page": 111, "tex_file": "tex/chapters/chapter-05/section-05-03.tex", "tex_line": 31, "display_type": "numbered-equation", "source_number": "5.12", "label": "eq:ch5-standard-kernel-size", "latex": "\\begin{equation}\n\\label{eq:ch5-standard-kernel-size}\n |K(x,y)|\\le\\frac C{|x-y|^n},\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p111-005-31ac57085cf1dc61", "chapter": 5, "source_pdf_page": 111, "tex_file": "tex/chapters/chapter-05/section-05-03.tex", "tex_line": 35, "display_type": "numbered-equation", "source_number": "5.13", "label": "eq:ch5-standard-kernel-y-regularity", "latex": "\\begin{equation}\n\\label{eq:ch5-standard-kernel-y-regularity}\n |K(x,y)-K(x,z)|\\le C\\frac{|y-z|^\\delta}{|x-y|^{n+\\delta}},\n \\qquad |x-y|>2|y-z|,\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p111-006-9a6f404ef62ea990", "chapter": 5, "source_pdf_page": 111, "tex_file": "tex/chapters/chapter-05/section-05-03.tex", "tex_line": 40, "display_type": "numbered-equation", "source_number": "5.14", "label": "eq:ch5-standard-kernel-x-regularity", "latex": "\\begin{equation}\n\\label{eq:ch5-standard-kernel-x-regularity}\n |K(x,y)-K(w,y)|\\le C\\frac{|x-w|^\\delta}{|x-y|^{n+\\delta}},\n \\qquad |x-y|>2|x-w|,\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p111-007-e2dc44abdd9d39e0", "chapter": 5, "source_pdf_page": 111, "tex_file": "tex/chapters/chapter-05/section-05-03.tex", "tex_line": 50, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n C_\\Gamma f(z)=\\frac1{2\\pi i}\\int_{-\\infty}^\\infty\n \\frac{f(t)(1+ia(t))}{t+iA(t)-z}\\,dt\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p111-008-ba66746ad414b112", "chapter": 5, "source_pdf_page": 111, "tex_file": "tex/chapters/chapter-05/section-05-03.tex", "tex_line": 55, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n Tf(x)=\\lim_{\\varepsilon\\to0}\\int_{|x-y|>\\varepsilon}\n \\frac{f(y)}{x-y+i(A(x)-A(y))}\\,dy,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p111-009-470ce4bdf07fa950", "chapter": 5, "source_pdf_page": 111, "tex_file": "tex/chapters/chapter-05/section-05-03.tex", "tex_line": 60, "display_type": "numbered-equation", "source_number": "5.15", "label": "eq:ch5-cauchy-lipschitz-kernel", "latex": "\\begin{equation}\n\\label{eq:ch5-cauchy-lipschitz-kernel}\n K(x,y)=\\frac1{x-y+i(A(x)-A(y))}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p112-001-b0ace879b5a0fce0", "chapter": 5, "source_pdf_page": 112, "tex_file": "tex/chapters/chapter-05/section-05-03.tex", "tex_line": 68, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n T_kf(x)=\\lim_{\\varepsilon\\to0}\\int_{|x-y|>\\varepsilon}\n \\left(\\frac{A(x)-A(y)}{x-y}\\right)^k\\frac{f(y)}{x-y}\\,dy.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
