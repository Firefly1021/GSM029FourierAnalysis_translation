{"id": "formula-chapter-05-p111-002-a1674b7b38e83180", "chapter": 5, "source_pdf_page": 111, "tex_file": "tex/chapters/chapter-05/section-05-03.tex", "tex_line": 17, "display_type": "numbered-equation", "source_number": "5.10", "label": "eq:ch5-generalized-hormander-y", "latex": "\\begin{equation}\n\\label{eq:ch5-generalized-hormander-y}\n \\int_{|x-y|>2|y-z|}|K(x,y)-K(x,z)|\\,dx\\le C,\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
