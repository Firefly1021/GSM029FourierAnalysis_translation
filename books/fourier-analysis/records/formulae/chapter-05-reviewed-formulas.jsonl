{"id": "formula-chapter-05-p108-002-ba301b3ef3794f1e", "chapter": 5, "source_pdf_page": 108, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 70, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\operatorname{p.v.}K(\\varphi)\n =\\lim_{\\varepsilon\\to0}\\int_{|x|>\\varepsilon}K(x)\\varphi(x)\\,dx\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p108-003-6a2143e1e0dff614", "chapter": 5, "source_pdf_page": 108, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 79, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\lim_{\\varepsilon\\to0}\\int_{\\varepsilon<|x|<1}K(x)\\,dx\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p108-004-bb2e1398e6a76b50", "chapter": 5, "source_pdf_page": 108, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 89, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\operatorname{p.v.}K(\\varphi)=\\varphi(0)L\n +\\int_{|x|<1}K(x)[\\varphi(x)-\\varphi(0)]\\,dx\n +\\int_{|x|>1}K(x)\\varphi(x)\\,dx.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p109-001-6a2143e1e0dff614", "chapter": 5, "source_pdf_page": 109, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 101, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\lim_{\\varepsilon\\to0}\\int_{\\varepsilon<|x|<1}K(x)\\,dx\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p109-002-c7ed8fa22eadb91d", "chapter": 5, "source_pdf_page": 109, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 105, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n Tf(x)=\\lim_{\\varepsilon\\to0}\\int_{|y|>\\varepsilon}K(y)f(x-y)\\,dy\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p109-003-57841b4368881fa9", "chapter": 5, "source_pdf_page": 109, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 114, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\left|\\int_{a<|x|<b}\\frac{dx}{|x|^{n+it}}\\right|\n =|S^{n-1}|\\left|\\frac{b^{-it}-a^{-it}}{-it}\\right|\n \\le\\frac2{|t|}|S^{n-1}|,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p109-004-0a43e0e960668468", "chapter": 5, "source_pdf_page": 109, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 119, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\int_{a<|x|<2a}\\frac{dx}{|x|^n}=|S^{n-1}|\\log2,\n \\qquad\n |\\nabla K(x)|\\le\\frac{|n+it|}{|x|^{n+1}}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p109-005-38bff898428651d2", "chapter": 5, "source_pdf_page": 109, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 125, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\int_{\\varepsilon<|x|<1}\\frac{dx}{|x|^{n+it}}\n =|S^{n-1}|\\frac{1-\\varepsilon^{-it}}{-it},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p109-006-a28a0676c8a3e7eb", "chapter": 5, "source_pdf_page": 109, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 130, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\operatorname{p.v.}\\frac1{|x|^{n+it}}(\\varphi)\n =\\int_{|x|<1}\\frac{\\varphi(x)-\\varphi(0)}{|x|^{n+it}}\\,dx\n +\\int_{|x|>1}\\frac{\\varphi(x)}{|x|^{n+it}}\\,dx.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p110-001-b4898cf9ddc6bbce", "chapter": 5, "source_pdf_page": 110, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 139, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\frac1{|x|^z}(\\varphi)\n =\\int_{|x|<1}\\frac{\\varphi(x)-\\varphi(0)}{|x|^z}\\,dx\n +\\int_{|x|>1}\\frac{\\varphi(x)}{|x|^z}\\,dx\n +\\frac{|S^{n-1}|}{n-z}\\varphi(0),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p110-002-a0c90a250c8176af", "chapter": 5, "source_pdf_page": 110, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 146, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\left(\\operatorname{p.v.}\\frac1{|x|^{n+it}}\\right)^{\\!\\wedge}(\\xi)\n =\\pi^{n/2+it}\\frac{\\Gamma(-it/2)}{\\Gamma((n+it)/2)}\n |\\xi|^{it}+\\frac1{it}|S^{n-1}|,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
