{"id": "formula-chapter-05-p114-005-4739fc3d0046be2e", "chapter": 5, "source_pdf_page": 114, "tex_file": "tex/chapters/chapter-05/section-05-04.tex", "tex_line": 74, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\int_E|Sf|^\\nu\n =\\nu\\int_0^\\infty\\lambda^{\\nu-1}\n |\\{x\\in E:|Sf(x)|>\\lambda\\}|\\,d\\lambda\n \\le\\nu\\int_0^\\infty\\lambda^{\\nu-1}\n \\min\\left(|E|,\\frac C\\lambda\\|f\\|_1\\right)d\\lambda.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
