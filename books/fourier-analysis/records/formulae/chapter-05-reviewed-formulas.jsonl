{"id": "formula-chapter-05-p103-002-60dff56101e87584", "chapter": 5, "source_pdf_page": 103, "tex_file": "tex/chapters/chapter-05/section-05-01.tex", "tex_line": 14, "display_type": "numbered-equation", "source_number": "5.2", "label": "eq:ch5-hormander-condition", "latex": "\\begin{equation}\n\\label{eq:ch5-hormander-condition}\n \\int_{|x|>2|y|}|K(x-y)-K(x)|\\,dx\\le B,\n \\qquad y\\in\\mathbb R^n.\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
