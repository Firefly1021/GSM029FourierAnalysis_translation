{"id": "formula-chapter-05-p104-001-d1ace7579d9177fb", "chapter": 5, "source_pdf_page": 104, "tex_file": "tex/chapters/chapter-05/section-05-01.tex", "tex_line": 36, "display_type": "numbered-equation", "source_number": "5.3", "label": "eq:ch5-gradient-condition", "latex": "\\begin{equation}\n\\label{eq:ch5-gradient-condition}\n |\\nabla K(x)|\\le\\frac C{|x|^{n+1}},\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p104-002-426f518812fd3abb", "chapter": 5, "source_pdf_page": 104, "tex_file": "tex/chapters/chapter-05/section-05-01.tex", "tex_line": 49, "display_type": "numbered-equation", "source_number": "5.4", "label": "eq:ch5-bad-part-outside-cubes", "latex": "\\begin{equation}\n\\label{eq:ch5-bad-part-outside-cubes}\n \\int_{\\mathbb R^n\\setminus Q_j^*}|Tb_j(x)|\\,dx\n \\le C\\int_{Q_j}|b_j(x)|\\,dx,\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p104-003-9694111a3eb6e3f4", "chapter": 5, "source_pdf_page": 104, "tex_file": "tex/chapters/chapter-05/section-05-01.tex", "tex_line": 55, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n Tb_j(x)=\\int_{Q_j}[K(x-y)-K(x-c_j)]b_j(y)\\,dy.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p104-004-f6fdc7168363ef38", "chapter": 5, "source_pdf_page": 104, "tex_file": "tex/chapters/chapter-05/section-05-01.tex", "tex_line": 62, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\omega_\\Omega(t)=\\sup\\{|\\Omega(u_1)-\\Omega(u_2)|:\n |u_1-u_2|<t,\\ u_1,u_2\\in S^{n-1}\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p105-001-5292ef4ab1baed4f", "chapter": 5, "source_pdf_page": 105, "tex_file": "tex/chapters/chapter-05/section-05-01.tex", "tex_line": 71, "display_type": "numbered-equation", "source_number": "5.5", "label": "eq:ch5-dini-condition", "latex": "\\begin{equation}\n\\label{eq:ch5-dini-condition}\n \\int_0^1\\omega_\\Omega(t)\\frac{dt}{t}<\\infty,\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p105-002-fa90bc79f4ff4265", "chapter": 5, "source_pdf_page": 105, "tex_file": "tex/chapters/chapter-05/section-05-01.tex", "tex_line": 82, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n |K(x-y)-K(x)|\n \\le\\frac{|\\Omega((x-y)')-\\Omega(x')|}{|x-y|^n}\n +|\\Omega(x')|\\left|\\frac1{|x-y|^n}-\\frac1{|x|^n}\\right|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p105-003-823675f3054e408b", "chapter": 5, "source_pdf_page": 105, "tex_file": "tex/chapters/chapter-05/section-05-01.tex", "tex_line": 88, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n 2^n|S^{n-1}|\\int_0^2\\omega_\\Omega(t)\\frac{dt}{t}<\\infty.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
