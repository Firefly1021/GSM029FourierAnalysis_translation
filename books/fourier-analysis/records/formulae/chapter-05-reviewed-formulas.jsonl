{"id": "formula-chapter-05-p106-003-ddd7759a9dff1f43", "chapter": 5, "source_pdf_page": 106, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 19, "display_type": "numbered-equation", "source_number": "5.8", "label": "eq:ch5-kernel-difference-condition", "latex": "\\begin{equation}\n\\label{eq:ch5-kernel-difference-condition}\n \\int_{|x|>2|y|}|K(x-y)-K(x)|\\,dx\\le C,\n \\qquad y\\in\\mathbb R^n.\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p106-004-ec099a4e0ff80982", "chapter": 5, "source_pdf_page": 106, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 28, "display_type": "numbered-equation", "source_number": "5.9", "label": "eq:ch5-first-moment-size", "latex": "\\begin{equation}\n\\label{eq:ch5-first-moment-size}\n \\int_{|x|<a}|x|\\,|K(x)|\\,dx\\le B'a,\n \\qquad a>0.\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-05-p107-001-6e2ced8de640f9d3", "chapter": 5, "source_pdf_page": 107, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 43, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|K_{\\varepsilon,R}*f\\|_p\\le C_p\\|f\\|_p,\n \\qquad 1<p<\\infty,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
