{"id": "formula-chapter-05-p107-003-8141d9759604174d", "chapter": 5, "source_pdf_page": 107, "tex_file": "tex/chapters/chapter-05/section-05-02.tex", "tex_line": 56, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\int_{|x|>2|y|}|K_{\\varepsilon,R}(x-y)-K_{\\varepsilon,R}(x)|\\,dx\\le C.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
