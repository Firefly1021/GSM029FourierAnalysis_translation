{"id": "formula-chapter-06-p127-001-18a0007b6dd2b041", "chapter": 6, "source_pdf_page": 127, "tex_file": "tex/chapters/chapter-06/section-06-01.tex", "tex_line": 10, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\int_Qa(x)\\,dx=0,\n \\qquad\n \\|a\\|_\\infty\\le\\frac1{|Q|}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p127-002-7c98c088512c1695", "chapter": 6, "source_pdf_page": 127, "tex_file": "tex/chapters/chapter-06/section-06-01.tex", "tex_line": 20, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|Ta\\|_1\\le C.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p127-003-4e77638fffb8e688", "chapter": 6, "source_pdf_page": 127, "tex_file": "tex/chapters/chapter-06/section-06-01.tex", "tex_line": 27, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\int_{Q^*}|Ta(x)|\\,dx\n \\le |Q^*|^{1/2}\\left(\\int_{Q^*}|Ta(x)|^2\\,dx\\right)^{1/2}\n \\le C|Q|^{1/2}\\left(\\int_Q|a(x)|^2\\,dx\\right)^{1/2}\n \\le C.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p127-004-3e90012aac9ed3c6", "chapter": 6, "source_pdf_page": 127, "tex_file": "tex/chapters/chapter-06/section-06-01.tex", "tex_line": 34, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n \\int_{\\mathbb R^n\\setminus Q^*}|Ta(x)|\\,dx\n &=\\int_{\\mathbb R^n\\setminus Q^*}\n   \\left|\\int_QK(x,y)a(y)\\,dy\\right|dx\\\\\n &=\\int_{\\mathbb R^n\\setminus Q^*}\n   \\left|\\int_Q[K(x,y)-K(x,c_Q)]a(y)\\,dy\\right|dx\\\\\n &\\le\\int_Q\\int_{\\mathbb R^n\\setminus Q^*}\n   |K(x,y)-K(x,c_Q)|\\,dx\\,|a(y)|\\,dy\n \\le C.\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p128-001-18722ae9ddca1561", "chapter": 6, "source_pdf_page": 128, "tex_file": "tex/chapters/chapter-06/section-06-01.tex", "tex_line": 50, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n H^1_{\\mathrm{at}}(\\mathbb R^n)\n =\\left\\{\\sum_j\\lambda_ja_j:\n a_j\\text{ 是原子},\\ \\lambda_j\\in\\mathbb C,\\ \\sum_j|\\lambda_j|<\\infty\\right\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p128-002-174784864d0e631e", "chapter": 6, "source_pdf_page": 128, "tex_file": "tex/chapters/chapter-06/section-06-01.tex", "tex_line": 56, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|f\\|_{H^1_{\\mathrm{at}}}\n =\\inf\\left\\{\\sum_j|\\lambda_j|:f=\\sum_j\\lambda_ja_j\\right\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p128-003-a88e49f012fe76bc", "chapter": 6, "source_pdf_page": 128, "tex_file": "tex/chapters/chapter-06/section-06-01.tex", "tex_line": 65, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|Tf\\|_1\\le C\\|f\\|_{H^1_{\\mathrm{at}}}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p128-004-aab0312aae8b7c19", "chapter": 6, "source_pdf_page": 128, "tex_file": "tex/chapters/chapter-06/section-06-01.tex", "tex_line": 71, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n H^1(\\mathbb R^n)\n =\\{f\\in L^1(\\mathbb R^n):R_jf\\in L^1(\\mathbb R^n),\\ 1\\le j\\le n\\},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p128-005-f405249436cfecfc", "chapter": 6, "source_pdf_page": 128, "tex_file": "tex/chapters/chapter-06/section-06-01.tex", "tex_line": 76, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|f\\|_{H^1}=\\|f\\|_1+\\sum_{j=1}^n\\|R_jf\\|_1.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p129-001-f6fc3b4d2b9d69f4", "chapter": 6, "source_pdf_page": 129, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 6, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n f_Q=\\frac1{|Q|}\\int_Qf.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p129-002-512498e324af5d12", "chapter": 6, "source_pdf_page": 129, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 10, "display_type": "numbered-equation", "source_number": "6.1", "label": "eq:ch6-sharp-maximal-function", "latex": "\\begin{equation}\n\\label{eq:ch6-sharp-maximal-function}\n M^\\#f(x)=\\sup_{Q\\ni x}\\frac1{|Q|}\\int_Q|f-f_Q|,\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p129-003-8feeeff3d34ab46b", "chapter": 6, "source_pdf_page": 129, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 15, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\mathrm{BMO}=\\{f\\in L^1_{\\mathrm{loc}}:M^\\#f\\in L^\\infty\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p129-004-94b8c2af7112a8da", "chapter": 6, "source_pdf_page": 129, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 19, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|f\\|_*=\\|M^\\#f\\|_\\infty.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p129-005-e84cfe05ad609cc2", "chapter": 6, "source_pdf_page": 129, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 25, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n M^\\#f(x)\\le C_nMf(x),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p129-006-a71ce6bb26ba5691", "chapter": 6, "source_pdf_page": 129, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 33, "display_type": "numbered-equation", "source_number": "6.2", "label": "eq:ch6-bmo-infimum-equivalence", "latex": "\\begin{equation}\n\\label{eq:ch6-bmo-infimum-equivalence}\n \\frac12\\|f\\|_*\n \\le\\sup_Q\\inf_{a\\in\\mathbb C}\\frac1{|Q|}\\int_Q|f(x)-a|\\,dx\n \\le\\|f\\|_*,\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p129-007-7282d22e29a45ce2", "chapter": 6, "source_pdf_page": 129, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 40, "display_type": "numbered-equation", "source_number": "6.3", "label": "eq:ch6-absolute-value-sharp-maximal", "latex": "\\begin{equation}\n\\label{eq:ch6-absolute-value-sharp-maximal}\n M^\\#(|f|)(x)\\le2M^\\#f(x).\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p130-001-0d9d70667962ff4b", "chapter": 6, "source_pdf_page": 130, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 49, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\int_Q|f(x)-f_Q|\\,dx\n \\le\\int_Q|f(x)-a|\\,dx+\\int_Q|a-f_Q|\\,dx\n \\le2\\int_Q|f(x)-a|\\,dx.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p130-002-5383d39e6366a3b8", "chapter": 6, "source_pdf_page": 130, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 57, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\frac1{|Q|}\\int_Q\\bigl||f(x)|-|f_Q|\\bigr|\\,dx\n \\le\\frac1{|Q|}\\int_Q|f(x)-f_Q|\\,dx,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p130-003-3b358094dfbc7876", "chapter": 6, "source_pdf_page": 130, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 65, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\frac1{|Q|}\\int_Q|f(x)-a|\\,dx\\le C,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p130-004-e6d8d25733132036", "chapter": 6, "source_pdf_page": 130, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 71, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n f(x)=\n \\begin{cases}\n  \\log(1/|x|),&|x|<1,\\\\\n  0,&|x|\\ge1.\n \\end{cases}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p130-005-5dd856dafe8b163d", "chapter": 6, "source_pdf_page": 130, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 85, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|Tf\\|_*\\le C\\|f\\|_\\infty.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p131-001-f59d3f6d26dc8a9c", "chapter": 6, "source_pdf_page": 131, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 95, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n \\frac1{|Q|}\\int_Q|Tf(x)-a|\\,dx\n &\\le\\frac1{|Q|}\\int_Q|Tf_1(x)|\\,dx\n +\\frac1{|Q|}\\int_Q|Tf_2(x)-Tf_2(c_Q)|\\,dx\\\\\n &\\le\\left(\\frac1{|Q|}\\int_Q|Tf_1(x)|^2\\,dx\\right)^{1/2}\\\\\n &\\quad+\\frac1{|Q|}\\int_Q\\left|\\int_{\\mathbb R^n\\setminus Q^*}\n [K(x,y)-K(c_Q,y)]f(y)\\,dy\\right|dx\\\\\n &\\le C\\left(\\frac1{|Q|}\\int_{Q^*}|f(x)|^2\\,dx\\right)^{1/2}\\\\\n &\\quad+\\frac1{|Q|}\\int_Q\\int_{\\mathbb R^n\\setminus Q^*}\n |K(x,y)-K(c_Q,y)|\\,dy\\,dx\\,\\|f\\|_\\infty\\\\\n &\\le C\\|f\\|_\\infty.\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p131-002-5e16da9e85390003", "chapter": 6, "source_pdf_page": 131, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 114, "display_type": "numbered-equation", "source_number": "6.4", "label": "eq:ch6-linfty-extension", "latex": "\\begin{equation}\n\\label{eq:ch6-linfty-extension}\n Tf(x)=Tf_1(x)+\\int_{\\mathbb R^n}[K(x,y)-K(0,y)]f_2(y)\\,dy.\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p131-003-63955c93cc6147be", "chapter": 6, "source_pdf_page": 131, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 119, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|f\\|_\\infty\\int_{\\mathbb R^n\\setminus Q^*}|K(x,y)-K(0,y)|\\,dy.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p131-004-56a76e72bb2dc20a", "chapter": 6, "source_pdf_page": 131, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 124, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n T(f_1-\\widetilde f_1)(x)\n &+\\int_{\\mathbb R^n\\setminus Q^*}[K(x,y)-K(0,y)]f(y)\\,dy\\\\\n &-\\int_{\\mathbb R^n\\setminus\\widetilde Q^*}[K(x,y)-K(0,y)]f(y)\\,dy\n =-\\int_{\\widetilde Q^*\\setminus Q^*}K(0,y)f(y)\\,dy.\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p132-001-590c68067855f793", "chapter": 6, "source_pdf_page": 132, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 137, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\int_{\\mathbb R^n\\setminus Q^*}K(0,y)f(y)\\,dy\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p132-002-6f8aa700c61e8607", "chapter": 6, "source_pdf_page": 132, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 145, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n \\pi Hf(x)\n &=\\operatorname{p.v.}\\int_{-a}^a\\frac{\\operatorname{sgn}(y)}{x-y}\\,dy\n +\\lim_{N\\to\\infty}\\left(\\int_{-N}^{-a}+\\int_a^N\\right)\n \\left(\\frac1{x-y}+\\frac1y\\right)\\operatorname{sgn}(y)\\,dy\\\\\n &=2\\log|x|-2\\log(a).\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p132-003-1d819624da008e0b", "chapter": 6, "source_pdf_page": 132, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 155, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n H(\\operatorname{sgn}(x))=\\frac2\\pi\\log|x|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p132-004-28703134a80e4bc0", "chapter": 6, "source_pdf_page": 132, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 159, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n i\\log(iz)=i\\log(-y+ix)=i\\log(x^2+y^2)^{1/2}+\\arctan(x/y).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p132-005-b0771ead46610d2d", "chapter": 6, "source_pdf_page": 132, "tex_file": "tex/chapters/chapter-06/section-06-02.tex", "tex_line": 163, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\frac\\pi2\\operatorname{sgn}(x)+i\\log|x|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p133-001-711db27bef358cfd", "chapter": 6, "source_pdf_page": 133, "tex_file": "tex/chapters/chapter-06/section-06-03.tex", "tex_line": 17, "display_type": "numbered-equation", "source_number": "6.5", "label": "eq:ch6-dyadic-sharp-norm", "latex": "\\begin{equation}\n\\label{eq:ch6-dyadic-sharp-norm}\n \\int_{\\mathbb R^n}M_df(x)^p\\,dx\n \\le C\\int_{\\mathbb R^n}M^\\#f(x)^p\\,dx,\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p133-002-10abd6e09bcf41f0", "chapter": 6, "source_pdf_page": 133, "tex_file": "tex/chapters/chapter-06/section-06-03.tex", "tex_line": 32, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\bigl|\\{x\\in\\mathbb R^n:M_df(x)>2\\lambda,\\ M^\\#f(x)\\le\\gamma\\lambda\\}\\bigr|\n \\le2^n\\gamma\\bigl|\\{x\\in\\mathbb R^n:M_df(x)>\\lambda\\}\\bigr|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p133-003-01d579f3cd912d90", "chapter": 6, "source_pdf_page": 133, "tex_file": "tex/chapters/chapter-06/section-06-03.tex", "tex_line": 40, "display_type": "numbered-equation", "source_number": "6.6", "label": "eq:ch6-good-lambda-cube", "latex": "\\begin{equation}\n\\label{eq:ch6-good-lambda-cube}\n |\\{x\\in Q:M_df(x)>2\\lambda,\\ M^\\#f(x)\\le\\gamma\\lambda\\}|\n \\le2^n\\gamma|Q|.\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p133-004-a6227c0fac40b481", "chapter": 6, "source_pdf_page": 133, "tex_file": "tex/chapters/chapter-06/section-06-03.tex", "tex_line": 47, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n M_d((f-f_{\\widetilde Q})\\chi_Q)(x)\n \\ge M_d(f\\chi_Q)(x)-f_{\\widetilde Q}>\\lambda.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p134-001-9d38cbc0f203848b", "chapter": 6, "source_pdf_page": 134, "tex_file": "tex/chapters/chapter-06/section-06-03.tex", "tex_line": 54, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n |\\{x\\in Q:M_d((f-f_{\\widetilde Q})\\chi_Q)(x)>\\lambda\\}|\n &\\le\\frac1\\lambda\\int_Q|f(x)-f_{\\widetilde Q}|\\,dx\\\\\n &\\le\\frac{2^n|Q|}{\\lambda}\\frac1{|\\widetilde Q|}\n \\int_{\\widetilde Q}|f(x)-f_{\\widetilde Q}|\\,dx\\\\\n &\\le\\frac{2^n|Q|}{\\lambda}\\inf_{x\\in Q}M^\\#f(x).\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p134-002-6a16768133cc09c3", "chapter": 6, "source_pdf_page": 134, "tex_file": "tex/chapters/chapter-06/section-06-03.tex", "tex_line": 68, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n I_N=\\int_0^Np\\lambda^{p-1}\n |\\{x\\in\\mathbb R^n:M_df(x)>\\lambda\\}|\\,d\\lambda.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p134-003-a7db4bd410a901fc", "chapter": 6, "source_pdf_page": 134, "tex_file": "tex/chapters/chapter-06/section-06-03.tex", "tex_line": 73, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n I_N\\le\\frac p{p_0}N^{p-p_0}\n \\int_0^Np_0\\lambda^{p_0-1}\n |\\{x\\in\\mathbb R^n:M_df(x)>\\lambda\\}|\\,d\\lambda,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p134-004-349881ebe8655dce", "chapter": 6, "source_pdf_page": 134, "tex_file": "tex/chapters/chapter-06/section-06-03.tex", "tex_line": 79, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n I_N\n &=2^p\\int_0^{N/2}p\\lambda^{p-1}\n |\\{x\\in\\mathbb R^n:M_df(x)>2\\lambda\\}|\\,d\\lambda\\\\\n &\\le2^p\\int_0^{N/2}p\\lambda^{p-1}\n \\bigl(|\\{M_df>2\\lambda,\\ M^\\#f\\le\\gamma\\lambda\\}|\n +|\\{M^\\#f>\\gamma\\lambda\\}|\\bigr)\\,d\\lambda\\\\\n &\\le2^{p+n}\\gamma I_N\n +\\frac{2^p}{\\gamma^p}\\int_0^{\\gamma N/2}p\\lambda^{p-1}\n |\\{x\\in\\mathbb R^n:M^\\#f(x)>\\lambda\\}|\\,d\\lambda.\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p134-005-db63309b36362116", "chapter": 6, "source_pdf_page": 134, "tex_file": "tex/chapters/chapter-06/section-06-03.tex", "tex_line": 93, "display_type": "numbered-equation", "source_number": "6.7", "label": "eq:ch6-truncated-distribution-bound", "latex": "\\begin{equation}\n\\label{eq:ch6-truncated-distribution-bound}\n I_N\\le\\frac{2^{p+1}}{\\gamma^p}\\int_0^{\\gamma N/2}p\\lambda^{p-1}\n |\\{x\\in\\mathbb R^n:M^\\#f(x)>\\lambda\\}|\\,d\\lambda.\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p134-006-33bf325ede3b46fa", "chapter": 6, "source_pdf_page": 134, "tex_file": "tex/chapters/chapter-06/section-06-03.tex", "tex_line": 103, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|M^\\#(Tf)\\|_\\infty=\\|Tf\\|_*\\le C\\|f\\|_\\infty.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p135-001-da8f1a7ad406811a", "chapter": 6, "source_pdf_page": 135, "tex_file": "tex/chapters/chapter-06/section-06-03.tex", "tex_line": 110, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n \\int_{\\mathbb R^n}|Tf(x)|^p\\,dx\n &\\le\\int_{\\mathbb R^n}M_d(Tf)(x)^p\\,dx\\\\\n &\\le C\\int_{\\mathbb R^n}M^\\#(Tf)(x)^p\\,dx\n \\le C\\int_{\\mathbb R^n}|f(x)|^p\\,dx.\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p135-002-f430670a9718bc55", "chapter": 6, "source_pdf_page": 135, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 5, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n |\\log(1/|x|)-(1-\\log a)|>\\lambda\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p135-003-c8294a21c4f88b48", "chapter": 6, "source_pdf_page": 135, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 13, "display_type": "numbered-equation", "source_number": "6.8", "label": "eq:ch6-john-nirenberg", "latex": "\\begin{equation}\n\\label{eq:ch6-john-nirenberg}\n |\\{x\\in Q:|f(x)-f_Q|>\\lambda\\}|\n \\le C_1e^{-C_2\\lambda/\\|f\\|_*}|Q|.\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p135-004-f2d92940e776ce79", "chapter": 6, "source_pdf_page": 135, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 22, "display_type": "numbered-equation", "source_number": "6.9", "label": "eq:ch6-normalized-mean-oscillation", "latex": "\\begin{equation}\n\\label{eq:ch6-normalized-mean-oscillation}\n \\frac1{|Q|}\\int_Q|f(x)-f_Q|\\,dx\\le1.\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p135-005-00c5e62d3949abda", "chapter": 6, "source_pdf_page": 135, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 27, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n 2<\\frac1{|Q_{1,j}|}\\int_{Q_{1,j}}|f(x)-f_Q|\\,dx\\le2^{n+1},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p136-001-299d353f4688e423", "chapter": 6, "source_pdf_page": 136, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 34, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\sum_j|Q_{1,j}|\n \\le\\frac12\\int_Q|f(x)-f_Q|\\,dx\n \\le\\frac12|Q|,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p136-002-f1cec425d1f5ad7f", "chapter": 6, "source_pdf_page": 136, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 40, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n |f_{Q_{1,j}}-f_Q|\n =\\left|\\frac1{|Q_{1,j}|}\\int_{Q_{1,j}}(f(x)-f_Q)\\,dx\\right|\n \\le2^{n+1}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p136-003-b3b60258f9569dfc", "chapter": 6, "source_pdf_page": 136, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 47, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n |f_{Q_{1,j,k}}-f_{Q_{1,j}}|\\le2^{n+1},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p136-004-d466fa0c2c33f326", "chapter": 6, "source_pdf_page": 136, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 50, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n |f(x)-f_{Q_{1,j}}|\\le2\n \\quad\\text{若 }x\\in Q_{1,j}\\setminus\\bigcup_kQ_{1,j,k},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p136-005-afe0a13fc861f03f", "chapter": 6, "source_pdf_page": 136, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 55, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\sum_k|Q_{1,j,k}|\\le\\frac12|Q_{1,j}|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p136-006-da0e89936ce6d51e", "chapter": 6, "source_pdf_page": 136, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 60, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\sum_j|Q_{2,j}|\\le\\frac14|Q|,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p136-007-2b3e7f705e404076", "chapter": 6, "source_pdf_page": 136, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 64, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n |f(x)-f_Q|\n \\le|f(x)-f_{Q_{1,j}}|+|f_{Q_{1,j}}-f_Q|\n \\le2+2^{n+1}\\le2\\cdot2^{n+1}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p136-008-d289527e7212a955", "chapter": 6, "source_pdf_page": 136, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 71, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n |f(x)-f_Q|\\le N\\cdot2^{n+1},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p136-009-391d67ea2dbac0e1", "chapter": 6, "source_pdf_page": 136, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 75, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\sum_j|Q_{N,j}|\\le2^{-N}|Q|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p136-010-eedd8790e87cd789", "chapter": 6, "source_pdf_page": 136, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 80, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n N2^{n+1}\\le\\lambda<(N+1)2^{n+1}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p136-011-6a53a9355d65db8d", "chapter": 6, "source_pdf_page": 136, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 84, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n |\\{x\\in Q:|f(x)-f_Q|>\\lambda\\}|\n &\\le\\sum_j|Q_{N,j}|\\le2^{-N}|Q|\\\\\n &=e^{-N\\log2}|Q|\\le e^{-C_2\\lambda}|Q|,\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p137-001-cfa41c07046fc789", "chapter": 6, "source_pdf_page": 137, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 94, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n |\\{x\\in Q:|f(x)-f_Q|>\\lambda\\}|\n \\le|Q|\\le e^{\\log\\sqrt2-C_2\\lambda}|Q|\n =\\sqrt2e^{-C_2\\lambda}|Q|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p137-002-3c1bfaf9cb8561f5", "chapter": 6, "source_pdf_page": 137, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 105, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|f\\|_{*,p}\n =\\sup_Q\\left(\\frac1{|Q|}\\int_Q|f(x)-f_Q|^p\\,dx\\right)^{1/p}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p137-003-1105d782e75a920a", "chapter": 6, "source_pdf_page": 137, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 114, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n \\int_Q|f(x)-f_Q|^p\\,dx\n &=\\int_0^\\infty p\\lambda^{p-1}\n |\\{x\\in Q:|f(x)-f_Q|>\\lambda\\}|\\,d\\lambda\\\\\n &\\le C_1|Q|\\int_0^\\infty p\\lambda^{p-1}\n e^{-C_2\\lambda/\\|f\\|_*}\\,d\\lambda.\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p137-004-bf12b0d9f5e33b26", "chapter": 6, "source_pdf_page": 137, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 124, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n \\frac1{|Q|}\\int_Q|f(x)-f_Q|^p\\,dx\n &\\le C_1p\\left(\\frac{\\|f\\|_*}{C_2}\\right)^p\n \\int_0^\\infty s^{p-1}e^{-s}\\,ds\\\\\n &=C_1pC_2^{-p}\\Gamma(p)\\|f\\|_*^p,\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p137-005-6d94f384a6d79e5b", "chapter": 6, "source_pdf_page": 137, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 140, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\frac1{|Q|}\\int_Qe^{\\lambda|f(x)-f_Q|}\\,dx<\\infty.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p137-006-9487a4f9085cbf6c", "chapter": 6, "source_pdf_page": 137, "tex_file": "tex/chapters/chapter-06/section-06-04.tex", "tex_line": 150, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n |\\{x\\in Q:|f(x)-f_Q|>\\lambda\\}|\n \\le C_1e^{-C_2\\lambda/K}|Q|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-06-p138-001-65581a4686b5dd8a", "chapter": 6, "source_pdf_page": 138, "tex_file": "tex/chapters/chapter-06/section-06-05.tex", "tex_line": 17, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\sup_{0<r<1}\\int_{-\\pi}^\\pi|F(re^{i\\theta})|^p\\,d\\theta<\\infty,\n \\qquad 0<p<\\infty,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
