\def\AJXint#1{\mathchoice
  {\AJXXint\displaystyle\textstyle{#1}}%
  {\AJXXint\textstyle\scriptstyle{#1}}%
  {\AJXXint\scriptstyle\scriptscriptstyle{#1}}%
  {\AJXXint\scriptscriptstyle\scriptscriptstyle{#1}}%
  \!\int}
