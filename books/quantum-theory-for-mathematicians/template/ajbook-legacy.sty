\providecolor{BianKuang}{gray}{0.45}
\ExecuteBibliographyOptions{sorting=nty,backref=false}

% Keep the old optional [name] grammar, and the original refstepcounter.
% Do not consume a following group: in these accepted files it is body text.
\newcommand{\AJLegacyStatement}[3]{%
  \refstepcounter{\AJLegacyCounter}%
  #3\AJStatementBegin{#1}{\ \csname the\AJLegacyCounter\endcsname}{#2}%
}
\newcommand{\AJLegacyNewStatement}[3]{%
  \NewDocumentEnvironment{#1}{o}{\AJLegacyStatement{#2}{##1}{#3}}%
    {\AJStatementEnd}%
}
\AJLegacyNewStatement{Theorem}{Theorem}{\fangsong}
\AJLegacyNewStatement{Definition}{Definition}{\fangsong}
\AJLegacyNewStatement{Lemma}{Lemma}{\fangsong}
\AJLegacyNewStatement{Proposition}{Proposition}{\fangsong}
\AJLegacyNewStatement{Corollary}{Corollary}{\fangsong}
\AJLegacyNewStatement{Example}{Example}{\songti}
\AJLegacyNewStatement{Remark}{Remark}{\songti}
\AJLegacyNewStatement{Exercise}{Exercise}{\songti}
\newenvironment{Proof}{\AJProofBegin}{\AJProofEnd}
\endinput
