{"id": "formula-7e8398f634685212", "source_latex": "\\label{eq:residual-quadratic-problem}\n\\begin{aligned}\n\\min_{\\bm x_n\\in\\bm x_0+\\mathcal K_n(A,\\bm r_0)}\\|\\bm b-A\\bm x_n\\|^2\n&=\\min_{\\bm c_n\\in\\mathbb C^n}\\|\\bm r_0-AV_n\\bm c_n\\|^2\\\\\n&=\\min_{\\bm c_n\\in\\mathbb C^n}(\\bm r_0-AV_n\\bm c_n)^{\\mathrm H}(\\bm r_0-AV_n\\bm c_n).\n\\end{aligned}\n", "tokens": ["\\begin", "{", "a", "l", "i", "g", "n", "e", "d", "}", "\\min", "_", "{", "\\bmx", "_", "n", "\\in", "\\bmx", "_", "0", "+", "\\mathcalK", "_", "n", "(", "A", ",", "\\bmr", "_", "0", ")", "}", "\\", "|", "\\bmb", "-", "A", "\\bmx", "_", "n", "\\", "|", "^", "2", "&", "=", "\\min", "_", "{", "\\bmc", "_", "n", "\\in", "\\mathbbC", "^", "n", "}", "\\", "|", "\\bmr", "_", "0", "-", "A", "V", "_", "n", "\\bmc", "_", "n", "\\", "|", "^", "2", "\\", "\\", "&", "=", "\\min", "_", "{", "\\bmc", "_", "n", "\\in", "\\mathbbC", "^", "n", "}", "(", "\\bmr", "_", "0", "-", "A", "V", "_", "n", "\\bmc", "_", "n", ")", "^", "{", "\\mathrmH", "}", "(", "\\bmr", "_", "0", "-", "A", "V", "_", "n", "\\bmc", "_", "n", ")", ".", "\\end", "{", "a", "l", "i", "g", "n", "e", "d", "}"], "label": "eq:residual-quadratic-problem", "number": "1.30", "source_location": {"page": 34, "bbox": [53, 463.1722780456181, 386, 526.1722780456181]}, "confidence": 1.0, "review_status": "reviewed"}
