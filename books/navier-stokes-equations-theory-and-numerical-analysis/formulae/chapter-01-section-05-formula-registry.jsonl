{"id": "formula-chapter-01-section-05-5-1", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.1", "source_pdf_page": 107, "label": "eq:ch1-uzawa-initial-pressure", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 20, "latex": "\\begin{equation}\np^0\\in L^2(\\Omega).\n\\label{eq:ch1-uzawa-initial-pressure}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-2", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.2", "source_pdf_page": 107, "label": "eq:ch1-uzawa-velocity-step", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 25, "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&u^{m+1}\\in\\mathbf H_0^1(\\Omega),\\\\\n&\\nu((u^{m+1},v))-(p^m,\\operatorname{div}v)=(f,v),\n\\qquad \\forall v\\in\\mathbf H_0^1(\\Omega),\n\\end{aligned}\n\\right.\n\\label{eq:ch1-uzawa-velocity-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-3", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.3", "source_pdf_page": 107, "label": "eq:ch1-uzawa-pressure-step", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 35, "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&p^{m+1}\\in L^2(\\Omega),\\\\\n&(p^{m+1}-p^m,q)+\\rho(\\operatorname{div}u^{m+1},q)=0,\n\\qquad \\forall q\\in L^2(\\Omega).\n\\end{aligned}\n\\right.\n\\label{eq:ch1-uzawa-pressure-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-4", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.4", "source_pdf_page": 107, "label": "eq:ch1-uzawa-dirichlet-step", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 48, "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&u^{m+1}\\in\\mathbf H_0^1(\\Omega),\\\\\n&-\\nu\\Delta u^{m+1}=\\operatorname{grad}p^m+f\\in\\mathbf H^{-1}(\\Omega)\n\\end{aligned}\n\\right.\n\\label{eq:ch1-uzawa-dirichlet-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-5", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.5", "source_pdf_page": 107, "label": "eq:ch1-uzawa-pressure-update", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 58, "latex": "\\begin{equation}\np^{m+1}=p^m-\\rho\\operatorname{div}u^{m+1}\\in L^2(\\Omega).\n\\label{eq:ch1-uzawa-pressure-update}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-6", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.6", "source_pdf_page": 107, "label": "eq:ch1-uzawa-step-condition", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 69, "latex": "\\begin{equation}\n0<\\rho<2\\nu,\n\\label{eq:ch1-uzawa-step-condition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-7", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.7", "source_pdf_page": 107, "label": "eq:ch1-uzawa-exact-variational-equation", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 78, "latex": "\\begin{equation}\n\\nu((u,v))-(p,\\operatorname{div}v)=(f,v),\n\\qquad \\forall v\\in\\mathbf H_0^1(\\Omega).\n\\label{eq:ch1-uzawa-exact-variational-equation}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-8", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.8", "source_pdf_page": 108, "label": "eq:ch1-uzawa-error-identity", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 88, "latex": "\\begin{equation}\n\\nu\\lVert v^{m+1}\\rVert^2=(q^m,\\operatorname{div}v^{m+1}),\n\\label{eq:ch1-uzawa-error-identity}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-9", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.9", "source_pdf_page": 108, "label": "eq:ch1-uzawa-velocity-error", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 93, "latex": "\\begin{equation}\nv^{m+1}=u^{m+1}-u,\n\\label{eq:ch1-uzawa-velocity-error}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-10", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.10", "source_pdf_page": 108, "label": "eq:ch1-uzawa-pressure-error", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 97, "latex": "\\begin{equation}\nq^m=p^m-p.\n\\label{eq:ch1-uzawa-pressure-error}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-11", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.11", "source_pdf_page": 108, "label": "eq:ch1-uzawa-pressure-energy", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 106, "latex": "\\begin{equation}\n\\lvert q^{m+1}\\rvert^2-\\lvert q^m\\rvert^2\n+\\lvert q^{m+1}-q^m\\rvert^2\n=-2\\rho(\\operatorname{div}v^{m+1},q^{m+1}).\n\\label{eq:ch1-uzawa-pressure-energy}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-12", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.12", "source_pdf_page": 108, "label": "eq:ch1-uzawa-combined-energy", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 113, "latex": "\\begin{equation}\n\\begin{aligned}\n&\\lvert q^{m+1}\\rvert^2-\\lvert q^m\\rvert^2\n+\\lvert q^{m+1}-q^m\\rvert^2\n+2\\rho\\nu\\lVert v^{m+1}\\rVert^2\\\\\n&\\hspace{4em}=-2\\rho(\\operatorname{div}v^{m+1},q^{m+1}-q^m).\n\\end{aligned}\n\\label{eq:ch1-uzawa-combined-energy}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-13", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.13", "source_pdf_page": 108, "label": "eq:ch1-divergence-norm-bound", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 127, "latex": "\\begin{equation}\n\\lvert\\operatorname{div}v\\rvert\\leq\\lVert v\\rVert,\n\\qquad \\forall v\\in\\mathbf H_0^1(\\Omega),\n\\label{eq:ch1-divergence-norm-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-14", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.14", "source_pdf_page": 108, "label": "eq:ch1-uzawa-one-step-bound", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 147, "latex": "\\begin{equation}\n\\lvert q^{m+1}\\rvert^2-\\lvert q^m\\rvert^2\n+(1-\\delta)\\lvert q^{m+1}-q^m\\rvert^2\n+\\rho\\left(2\\nu-\\frac{\\rho}{\\delta}\\right)\\lVert v^{m+1}\\rVert^2\\leq0.\n\\label{eq:ch1-uzawa-one-step-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-15", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.15", "source_pdf_page": 108, "label": "eq:ch1-uzawa-summed-bound", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 154, "latex": "\\begin{equation}\n\\lvert q^{N+1}\\rvert^2\n+(1-\\delta)\\sum_{m=0}^{N}\\lvert q^{m+1}-q^m\\rvert^2\n+\\left(2\\nu-\\frac{\\rho}{\\delta}\\right)\\rho\n\\sum_{m=1}^{N}\\lVert v^{m+1}\\rVert^2\n\\leq\\lvert q^0\\rvert^2.\n\\label{eq:ch1-uzawa-summed-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-16", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.16", "source_pdf_page": 109, "label": "eq:ch1-uzawa-error-convergence", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 171, "latex": "\\begin{equation}\n\\begin{aligned}\n\\lvert q^{m+1}-q^m\\rvert^2\n&=\\lvert p^{m+1}-p^m\\rvert^2\\longrightarrow0\n&&\\text{当 }m\\to\\infty,\\\\\n\\lVert v^{m+1}\\rVert^2\n&=\\lVert u^{m+1}-u\\rVert^2\\longrightarrow0\n&&\\text{当 }m\\to\\infty.\n\\end{aligned}\n\\label{eq:ch1-uzawa-error-convergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-17", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.17", "source_pdf_page": 109, "label": "eq:ch1-arrow-hurwicz-initial-data", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 225, "latex": "\\begin{equation}\nu^0\\in\\mathbf H_0^1(\\Omega),\n\\qquad p^0\\in L^2(\\Omega).\n\\label{eq:ch1-arrow-hurwicz-initial-data}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-18", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.18", "source_pdf_page": 109, "label": "eq:ch1-arrow-hurwicz-velocity-step", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 231, "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&u^{m+1}\\in\\mathbf H_0^1(\\Omega),\\\\\n&((u^{m+1}-u^m,v))+\\rho\\nu((u^m,v))\n-\\rho(p^m,\\operatorname{div}v)=\\rho(f,v),\\\\\n&\\hspace{18em}\\forall v\\in\\mathbf H_0^1(\\Omega),\n\\end{aligned}\n\\right.\n\\label{eq:ch1-arrow-hurwicz-velocity-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-19", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.19", "source_pdf_page": 109, "label": "eq:ch1-arrow-hurwicz-pressure-step", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 242, "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&p^{m+1}\\in L^2(\\Omega),\\\\\n&\\alpha(p^{m+1}-p^m,q)+\\rho(\\operatorname{div}u^{m+1},q)=0,\n\\qquad \\forall q\\in L^2(\\Omega).\n\\end{aligned}\n\\right.\n\\label{eq:ch1-arrow-hurwicz-pressure-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-20", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.20", "source_pdf_page": 110, "label": "eq:ch1-arrow-hurwicz-dirichlet-step", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 255, "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n-\\Delta u^{m+1}\n&=-\\Delta u^m+\\rho\\nu\\Delta u^m\n-\\rho\\operatorname{grad}p^m+\\rho f,\\\\\nu^{m+1}&\\in\\mathbf H_0^1(\\Omega)\n\\end{aligned}\n\\right.\n\\label{eq:ch1-arrow-hurwicz-dirichlet-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-21", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.21", "source_pdf_page": 110, "label": "eq:ch1-arrow-hurwicz-pressure-update", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 267, "latex": "\\begin{equation}\np^{m+1}=p^m-\\frac{\\rho}{\\alpha}\\operatorname{div}u^{m+1}\n\\in L^2(\\Omega).\n\\label{eq:ch1-arrow-hurwicz-pressure-update}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-22", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.22", "source_pdf_page": 110, "label": "eq:ch1-arrow-hurwicz-step-condition", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 279, "latex": "\\begin{equation}\n0<\\rho<\\frac{2\\alpha\\nu}{\\alpha\\nu^2+1},\n\\label{eq:ch1-arrow-hurwicz-step-condition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-23", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.23", "source_pdf_page": 110, "label": "eq:ch1-arrow-hurwicz-velocity-error", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 288, "latex": "\\begin{equation}\nv^m=u^m-u,\n\\label{eq:ch1-arrow-hurwicz-velocity-error}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-24", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.24", "source_pdf_page": 110, "label": "eq:ch1-arrow-hurwicz-pressure-error", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 292, "latex": "\\begin{equation}\nq^m=p^m-p.\n\\label{eq:ch1-arrow-hurwicz-pressure-error}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-25", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.25", "source_pdf_page": 110, "label": "eq:ch1-arrow-hurwicz-velocity-energy", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 303, "latex": "\\begin{equation}\n\\begin{aligned}\n&\\lVert v^{m+1}\\rVert^2-\\lVert v^m\\rVert^2\n+\\lVert v^{m+1}-v^m\\rVert^2\n+2\\rho\\nu\\lVert v^{m+1}\\rVert^2\\\\\n&\\quad=2\\rho\\nu((v^{m+1},v^{m+1}-v^m))\n+2\\rho(q^m,\\operatorname{div}v^{m+1})\\\\\n&\\quad\\leq\\delta\\lVert v^{m+1}-v^m\\rVert^2\n+\\frac{\\rho^2\\nu^2}{\\delta}\\lVert v^{m+1}\\rVert^2\n+2\\rho(q^m,\\operatorname{div}v^{m+1}),\n\\end{aligned}\n\\label{eq:ch1-arrow-hurwicz-velocity-energy}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-26", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.26", "source_pdf_page": 110, "label": "eq:ch1-arrow-hurwicz-pressure-energy", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 333, "latex": "\\begin{equation}\n\\begin{aligned}\n\\alpha\\lvert q^{m+1}\\rvert^2-\\alpha\\lvert q^m\\rvert^2\n+\\alpha\\lvert q^{m+1}-q^m\\rvert^2\n\\leq{}&-2\\rho(q^m,\\operatorname{div}v^{m+1})\\\\\n&+\\alpha\\delta\\lvert q^{m+1}-q^m\\rvert^2\n+\\frac{\\rho^2}{\\alpha\\delta}\\lVert v^{m+1}\\rVert^2.\n\\end{aligned}\n\\label{eq:ch1-arrow-hurwicz-pressure-energy}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-27", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.27", "source_pdf_page": 111, "label": "eq:ch1-arrow-hurwicz-combined-energy", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 344, "latex": "\\begin{equation}\n\\begin{aligned}\n&\\alpha\\lvert q^{m+1}\\rvert^2+\\lVert v^{m+1}\\rVert^2\n-\\alpha\\lvert q^m\\rvert^2-\\lVert v^m\\rVert^2\n+\\alpha(1-\\delta)\\lvert q^{m+1}-q^m\\rvert^2\\\\\n&\\quad +(1-\\delta)\\lVert v^{m+1}-v^m\\rVert^2\n+\\rho\\left(2\\nu-\\frac{\\rho\\nu^2}{\\delta}\n-\\frac{\\rho}{\\alpha\\delta}\\right)\\lVert v^{m+1}\\rVert^2\\leq0.\n\\end{aligned}\n\\label{eq:ch1-arrow-hurwicz-combined-energy}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-28", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.28", "source_pdf_page": 111, "label": "eq:ch1-arrow-hurwicz-positive-coefficient", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 364, "latex": "\\begin{equation}\n\\rho\\left(2\\nu-\\frac{\\rho\\nu^2}{\\delta}\n-\\frac{\\rho}{\\alpha\\delta}\\right)>0.\n\\label{eq:ch1-arrow-hurwicz-positive-coefficient}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-29", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.29", "source_pdf_page": 111, "label": "eq:ch1-discrete-algorithm-velocity-expansion", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 384, "latex": "\\begin{equation}\nu_h^m=\\sum_{M\\in\\mathring\\Omega_{1h}}\\xi_Mw_{hM},\n\\qquad \\xi_M\\in\\mathbb R^n\n\\quad(\\text{即 }u_h^m\\in W_h),\n\\label{eq:ch1-discrete-algorithm-velocity-expansion}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-30", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.30", "source_pdf_page": 111, "label": "eq:ch1-discrete-algorithm-pressure-expansion", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 390, "latex": "\\begin{equation}\n\\pi_h^m=\\sum_{M\\in\\mathring\\Omega_{1h}}\\eta_Mw_{hM},\n\\qquad \\eta_M\\in\\mathbb R,\n\\label{eq:ch1-discrete-algorithm-pressure-expansion}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-31", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.31", "source_pdf_page": 111, "label": "eq:ch1-discrete-uzawa-velocity-step", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 400, "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&u_h^{m+1}\\in W_h,\\\\\n&\\nu((u_h^{m+1},v_h))_h-(\\pi_h^m,D_hv_h)_h=(f,v_h),\n\\qquad\\forall v_h\\in W_h,\n\\end{aligned}\n\\right.\n\\label{eq:ch1-discrete-uzawa-velocity-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-32", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.32", "source_pdf_page": 111, "label": "eq:ch1-discrete-uzawa-pressure-step", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 410, "latex": "\\begin{equation}\n\\pi_h^{m+1}(M)=\\pi_h^m(M)-\\rho(D_hu_h^{m+1})(M),\n\\label{eq:ch1-discrete-uzawa-pressure-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-33", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.33", "source_pdf_page": 111, "label": "eq:ch1-discrete-uzawa-velocity-convergence", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 417, "latex": "\\begin{equation}\nu_h^m\\longrightarrow u_h\\quad\\text{在 }W_h\\text{ 中},\n\\label{eq:ch1-discrete-uzawa-velocity-convergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-34", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.34", "source_pdf_page": 111, "label": "eq:ch1-discrete-uzawa-pressure-convergence", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 421, "latex": "\\begin{equation}\n\\pi_h^m\\longrightarrow\\pi_h\\quad\\text{相差一个常数},\n\\label{eq:ch1-discrete-uzawa-pressure-convergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-35", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.35", "source_pdf_page": 112, "label": "eq:ch1-discrete-arrow-hurwicz-velocity-step", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 430, "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&u_h^{m+1}\\in W_h,\\\\\n&((u_h^{m+1}-u_h^m,v_h))_h\n+\\rho\\nu((u_h^m,v_h))_h\n-\\rho(\\pi_h^m,D_hv_h)_h=(f,v_h),\\\\\n&\\hspace{18em}\\forall v_h\\in W_h,\n\\end{aligned}\n\\right.\n\\label{eq:ch1-discrete-arrow-hurwicz-velocity-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-36", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.36", "source_pdf_page": 112, "label": "eq:ch1-discrete-arrow-hurwicz-pressure-step", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 442, "latex": "\\begin{equation}\n\\pi_h^{m+1}(M)=\\pi_h^m(M)\n-\\frac{\\rho}{\\alpha}D_hu_h^{m+1}(M),\n\\qquad\\forall M\\in\\mathring\\Omega_{1h}.\n\\label{eq:ch1-discrete-arrow-hurwicz-pressure-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-37", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.37", "source_pdf_page": 112, "label": "eq:ch1-explicit-discrete-arrow-hurwicz-step", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 455, "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&u_h^{m+1}\\in W_h,\\\\\n&(u_h^{m+1}-u_h^m,v_h)\n+\\rho\\nu((u_h^m,v_h))_h\n-\\rho(\\pi_h^m,D_hv_h)_h=\\rho(f,v_h),\\\\\n&\\hspace{18em}\\forall v_h\\in W_h,\n\\end{aligned}\n\\right.\n\\label{eq:ch1-explicit-discrete-arrow-hurwicz-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-38", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.38", "source_pdf_page": 112, "label": "eq:ch1-explicit-discrete-arrow-hurwicz-pointwise", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 468, "latex": "\\begin{equation}\n\\begin{aligned}\nu_h^{m+1}(M)=u_h^m(M)\n&+\\rho\\nu\\sum_{i=1}^{n}(\\delta_{ih}^2u_h^m)(M)\\\\\n&-\\rho(\\overline\\nabla_h\\pi_h^m)(M)\n+\\rho f_h(M),\n\\qquad\\forall M\\in\\mathring\\Omega_{1h},\n\\end{aligned}\n\\label{eq:ch1-explicit-discrete-arrow-hurwicz-pointwise}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-39", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.39", "source_pdf_page": 112, "label": "eq:ch1-discrete-norm-equivalence", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 481, "latex": "\\begin{equation}\n\\lVert u_h\\rVert_h\\leq S(h)\\lvert u_h\\rvert,\n\\qquad\\forall u_h\\in W_h.\n\\label{eq:ch1-discrete-norm-equivalence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-40", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.40", "source_pdf_page": 112, "label": "eq:ch1-explicit-discrete-arrow-hurwicz-step-condition", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 491, "latex": "\\begin{equation}\n0<\\rho<\\frac{2\\alpha\\nu}{\\alpha\\nu^2S^2(h)+1},\n\\label{eq:ch1-explicit-discrete-arrow-hurwicz-step-condition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-41", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.41", "source_pdf_page": 113, "label": "eq:ch1-explicit-discrete-arrow-hurwicz-velocity-energy", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 498, "latex": "\\begin{equation}\n\\begin{aligned}\n&\\lvert v_h^{m+1}\\rvert^2-\\lvert v_h^m\\rvert^2\n+\\lvert v_h^{m+1}-v_h^m\\rvert\n+2\\rho\\nu\\lVert v_h^{m+1}\\rVert_h^2\\\\\n&\\quad=2\\rho\\nu((v_h^{m+1},v_h^{m+1}-v_h^m))_h\n+2\\rho(\\kappa_h^m,D_hv_h^{m+1})_h\\\\\n&\\quad\\leq2\\rho\\nu\\lVert v_h^{m+1}\\rVert_h\n\\lVert v_h^{m+1}-v_h^m\\rVert_h\n+2\\rho(\\kappa_h^m,D_hv_h^{m+1})_h\\\\\n&\\quad\\leq2\\rho\\nu S(h)\\lVert v_h^{m+1}\\rVert_h\n\\lvert v_h^{m+1}-v_h^m\\rvert\n+2\\rho(\\kappa_h^m,D_hv_h^{m+1})_h\\\\\n&\\quad\\leq\\delta\\lvert v_h^{m+1}-v_h^m\\rvert^2\n+\\frac{\\rho^2\\nu^2S^2(h)}{\\delta}\\lVert v_h^{m+1}\\rVert_h^2\n+2\\rho(\\kappa_h^m,D_hv_h^{m+1})_h.\n\\end{aligned}\n\\label{eq:ch1-explicit-discrete-arrow-hurwicz-velocity-energy}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-05-5-42", "batch_id": "chapter-01-section-05", "source_pdf_pages": "106--113", "source_number": "5.42", "source_pdf_page": 113, "label": "eq:ch1-explicit-discrete-arrow-hurwicz-combined-energy", "tex_file": "tex/chapters/chapter-01/section-05.tex", "tex_line": 518, "latex": "\\begin{equation}\n\\begin{aligned}\n&\\alpha\\lvert\\kappa_h^{m+1}\\rvert^2+\\lvert v_h^{m+1}\\rvert^2\n-\\alpha\\lvert\\kappa_h^m\\rvert^2-\\lvert v_h^m\\rvert^2\n+\\alpha(1-\\delta)\\lvert\\kappa_h^{m+1}-\\kappa_h^m\\rvert^2\\\\\n&\\quad +(1-\\delta)\\lvert v_h^{m+1}-v_h^m\\rvert^2\n+\\rho\\left(2\\nu-\\frac{\\rho\\nu^2S^2(h)}{\\delta}\n-\\frac{\\rho}{\\alpha\\delta}\\right)\\lVert v_h^{m+1}\\rVert_h^2\\leq0.\n\\end{aligned}\n\\label{eq:ch1-explicit-discrete-arrow-hurwicz-combined-energy}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
