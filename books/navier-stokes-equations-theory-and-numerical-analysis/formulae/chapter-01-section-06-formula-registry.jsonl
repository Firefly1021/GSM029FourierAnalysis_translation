{"id": "formula-chapter-01-section-06-6-1", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.1", "source_pdf_page": 113, "label": "eq:ch1-penalty-momentum", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 6, "latex": "\\begin{equation}\n-\\nu\\Delta u_\\varepsilon\n-\\frac{1}{\\varepsilon}\\operatorname{grad}\\operatorname{div}u_\\varepsilon=f\n\\quad\\text{在 }\\Omega\\text{ 中},\n\\label{eq:ch1-penalty-momentum}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-2", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.2", "source_pdf_page": 113, "label": "eq:ch1-penalty-boundary", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 12, "latex": "\\begin{equation}\nu_\\varepsilon=0\\quad\\text{在 }\\partial\\Omega\\text{ 上},\n\\label{eq:ch1-penalty-boundary}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-3", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.3", "source_pdf_page": 114, "label": "eq:ch1-penalty-velocity-convergence", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 29, "latex": "\\begin{equation}\nu_\\varepsilon\\longrightarrow u\n\\quad\\text{在 }\\mathbf H_0^1(\\Omega)\\text{ 的范数中},\n\\label{eq:ch1-penalty-velocity-convergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-4", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.4", "source_pdf_page": 114, "label": "eq:ch1-penalty-pressure-convergence", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 34, "latex": "\\begin{equation}\n-\\frac{\\operatorname{div}u_\\varepsilon}{\\varepsilon}\n\\longrightarrow p\n\\quad\\text{在 }L^2(\\Omega)\\text{ 的范数中},\n\\label{eq:ch1-penalty-pressure-convergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-5", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.5", "source_pdf_page": 114, "label": "eq:ch1-penalty-pressure-zero-mean", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 41, "latex": "\\begin{equation}\n\\int_\\Omega p(x)\\,dx=0.\n\\label{eq:ch1-penalty-pressure-zero-mean}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-6", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.6", "source_pdf_page": 114, "label": "eq:ch1-penalty-variational-problem", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 49, "latex": "\\begin{equation}\n\\nu((u_\\varepsilon,v))\n+\\frac{1}{\\varepsilon}(\\operatorname{div}u_\\varepsilon,\\operatorname{div}v)\n=(f,v),\n\\qquad\\forall v\\in\\mathbf H_0^1(\\Omega).\n\\label{eq:ch1-penalty-variational-problem}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-7", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.7", "source_pdf_page": 114, "label": "eq:ch1-penalty-error-equation", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 67, "latex": "\\begin{equation}\n-\\nu\\Delta(u_\\varepsilon-u)\n-\\frac{1}{\\varepsilon}\\operatorname{grad}\\operatorname{div}u_\\varepsilon\n=\\operatorname{grad}p,\n\\label{eq:ch1-penalty-error-equation}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-8", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.8", "source_pdf_page": 114, "label": "eq:ch1-penalty-error-variational", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 74, "latex": "\\begin{equation}\n\\nu((u_\\varepsilon-u,v))\n+\\frac{1}{\\varepsilon}(\\operatorname{div}u_\\varepsilon,\\operatorname{div}v)\n=-(p,\\operatorname{div}v),\n\\qquad\\forall v\\in\\mathbf H_0^1(\\Omega).\n\\label{eq:ch1-penalty-error-variational}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-9", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.9", "source_pdf_page": 114, "label": "eq:ch1-penalty-basic-estimate", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 93, "latex": "\\begin{equation}\n\\nu\\lVert u_\\varepsilon-u\\rVert^2\n+\\frac{1}{2\\varepsilon}\\lvert\\operatorname{div}u_\\varepsilon\\rvert^2\n\\leq\\frac{\\varepsilon}{2}\\lvert p\\rvert^2.\n\\label{eq:ch1-penalty-basic-estimate}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-10", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.10", "source_pdf_page": 114, "label": "eq:ch1-penalty-pressure-derivative-convergence", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 100, "latex": "\\begin{equation}\n\\frac{\\partial}{\\partial x_i}\n\\left(\\frac{\\operatorname{div}u_\\varepsilon}{\\varepsilon}\\right)\n\\longrightarrow-\\frac{\\partial p}{\\partial x_i}\n\\quad\\text{在 }H^{-1}(\\Omega)\\text{ 的范数中},\n\\quad i=1,\\ldots,n,\n\\label{eq:ch1-penalty-pressure-derivative-convergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-11", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.11", "source_pdf_page": 114, "label": "eq:ch1-penalty-pressure-lemma-application", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 111, "latex": "\\begin{equation}\n\\left\\lvert p+\\frac{\\operatorname{div}u_\\varepsilon}{\\varepsilon}\\right\\rvert\n\\leq\\sum_{i=1}^{n}\n\\left\\lVert\\frac{\\partial}{\\partial x_i}\n\\left(p+\\frac{\\operatorname{div}u_\\varepsilon}{\\varepsilon}\\right)\n\\right\\rVert_{H^{-1}(\\Omega)},\n\\label{eq:ch1-penalty-pressure-lemma-application}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-12", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.12", "source_pdf_page": 115, "label": "eq:ch1-negative-norm-pressure-estimate", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 130, "latex": "\\begin{equation}\n\\lvert\\sigma\\rvert_{L^2(\\Omega)}\n\\leq c(\\Omega)\\left\\{\n\\left\\lvert\\int_\\Omega\\sigma\\,dx\\right\\rvert\n+\\sum_{i=1}^{n}\n\\left\\lVert\\frac{\\partial\\sigma}{\\partial x_i}\\right\\rVert_{H^{-1}(\\Omega)}\n\\right\\}.\n\\label{eq:ch1-negative-norm-pressure-estimate}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-13", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.13", "source_pdf_page": 115, "label": "eq:ch1-negative-norm-upper-bound", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 145, "latex": "\\begin{equation}\n[\\sigma]\\leq c'(\\Omega)\\lvert\\sigma\\rvert_{L^2(\\Omega)},\n\\qquad\\forall\\sigma\\in L^2(\\Omega).\n\\label{eq:ch1-negative-norm-upper-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-14", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.14", "source_pdf_page": 115, "label": "eq:ch1-negative-norm-integral-limit", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 153, "latex": "\\begin{equation}\n\\int_\\Omega\\sigma_m\\,dx\\longrightarrow\\lambda\n\\quad\\text{当 }m\\to\\infty,\n\\label{eq:ch1-negative-norm-integral-limit}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-15", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.15", "source_pdf_page": 115, "label": "eq:ch1-negative-norm-derivative-limit", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 158, "latex": "\\begin{equation}\n\\frac{\\partial\\sigma_m}{\\partial x_i}\\longrightarrow\\chi_i\n\\quad\\text{当 }m\\to\\infty,\n\\quad\\text{在 }H^{-1}(\\Omega)\\text{ 中},\\quad1\\leq i\\leq n.\n\\label{eq:ch1-negative-norm-derivative-limit}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-16", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.16", "source_pdf_page": 116, "label": "eq:ch1-penalty-component-pressure-zero-mean", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 189, "latex": "\\begin{equation}\n\\int_{\\Omega_j}p\\,dx=0,\n\\qquad\\forall\\Omega_j.\n\\label{eq:ch1-penalty-component-pressure-zero-mean}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-17", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.17", "source_pdf_page": 116, "label": "eq:ch1-penalty-asymptotic-series", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 200, "latex": "\\begin{equation}\nu_\\varepsilon=u^0+\\varepsilon u^1+\\varepsilon^2u^2+\\cdots\n+\\varepsilon^Nu^N+\\cdots,\n\\label{eq:ch1-penalty-asymptotic-series}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-18", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.18", "source_pdf_page": 116, "label": "eq:ch1-penalty-base-pair", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 208, "latex": "\\begin{equation}\nu^0,p^0\\quad\\text{已经给定};\n\\label{eq:ch1-penalty-base-pair}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-19", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.19", "source_pdf_page": 116, "label": "eq:ch1-penalty-recursive-spaces", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 213, "latex": "\\begin{equation}\nu^m\\in\\mathbf H_0^1(\\Omega),\n\\qquad p^m\\in L^2(\\Omega),\n\\label{eq:ch1-penalty-recursive-spaces}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-20", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.20", "source_pdf_page": 116, "label": "eq:ch1-penalty-recursive-momentum", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 218, "latex": "\\begin{equation}\n-\\nu\\Delta u^m+\\operatorname{grad}p^m=0,\n\\label{eq:ch1-penalty-recursive-momentum}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-21", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.21", "source_pdf_page": 116, "label": "eq:ch1-penalty-recursive-divergence", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 222, "latex": "\\begin{equation}\n\\operatorname{div}u^m=-p^{m-1},\n\\label{eq:ch1-penalty-recursive-divergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-22", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.22", "source_pdf_page": 116, "label": "eq:ch1-penalty-recursive-pressure-zero-mean", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 226, "latex": "\\begin{equation}\n\\int_\\Omega p^m(x)\\,dx=0\n\\label{eq:ch1-penalty-recursive-pressure-zero-mean}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-23", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.23", "source_pdf_page": 116, "label": "eq:ch1-penalty-recursive-compatibility", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 231, "latex": "\\begin{equation}\n\\int_\\Omega\\operatorname{div}u^{m+1}\\,dx\n=\\int_\\Gamma u^{m+1}\\cdot\\nu\\,d\\Gamma\n=0=\\int_\\Omega p^m\\,dx.\n\\label{eq:ch1-penalty-recursive-compatibility}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-24", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.24", "source_pdf_page": 116, "label": "eq:ch1-penalty-velocity-partial-sum", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 239, "latex": "\\begin{equation}\nu_\\varepsilon^N=\\sum_{m=0}^{N}\\varepsilon^mu^m,\n\\label{eq:ch1-penalty-velocity-partial-sum}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-25", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.25", "source_pdf_page": 116, "label": "eq:ch1-penalty-pressure-partial-sum", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 243, "latex": "\\begin{equation}\np_\\varepsilon^N=\\sum_{m=0}^{N}\\varepsilon^mp^m.\n\\label{eq:ch1-penalty-pressure-partial-sum}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-26", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.26", "source_pdf_page": 116, "label": "eq:ch1-penalty-velocity-remainder", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 254, "latex": "\\begin{equation}\n\\frac{u_\\varepsilon-u_\\varepsilon^N}{\\varepsilon^N}\n\\longrightarrow0\n\\quad\\text{在 }\\mathbf H_0^1(\\Omega)\\text{ 的范数中},\n\\label{eq:ch1-penalty-velocity-remainder}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-27", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.27", "source_pdf_page": 116, "label": "eq:ch1-penalty-pressure-remainder", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 260, "latex": "\\begin{equation}\n\\frac{1}{\\varepsilon^N}\n\\left(-\\frac{\\operatorname{div}u_\\varepsilon}{\\varepsilon}\n-p_\\varepsilon^N\\right)\n\\longrightarrow0\n\\quad\\text{在 }L^2(\\Omega)\\text{ 的范数中}.\n\\label{eq:ch1-penalty-pressure-remainder}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-28", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.28", "source_pdf_page": 117, "label": "eq:ch1-penalty-remainder-spaces", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 284, "latex": "\\begin{equation}\nu_\\varepsilon-u_\\varepsilon^N\\in\\mathbf H_0^1(\\Omega),\n\\qquad p^N\\in L^2(\\Omega),\n\\label{eq:ch1-penalty-remainder-spaces}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-29", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.29", "source_pdf_page": 117, "label": "eq:ch1-penalty-remainder-equation", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 289, "latex": "\\begin{equation}\n-\\nu\\Delta(u_\\varepsilon-u_\\varepsilon^N)\n-\\frac{1}{\\varepsilon}\\operatorname{grad}\\operatorname{div}\n(u_\\varepsilon-u_\\varepsilon^N)\n=\\varepsilon^N\\operatorname{grad}p^N.\n\\label{eq:ch1-penalty-remainder-equation}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-30", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.30", "source_pdf_page": 117, "label": "eq:ch1-penalty-remainder-variational", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 297, "latex": "\\begin{equation}\n\\begin{aligned}\n&\\nu((u_\\varepsilon-u_\\varepsilon^N,v))\n+\\frac{1}{\\varepsilon}\n(\\operatorname{div}(u_\\varepsilon-u_\\varepsilon^N),\\operatorname{div}v)\\\\\n&\\hspace{14em}=-\\varepsilon^N(p^N,\\operatorname{div}v),\n\\qquad v\\in\\mathbf H_0^1(\\Omega).\n\\end{aligned}\n\\label{eq:ch1-penalty-remainder-variational}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-31", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.31", "source_pdf_page": 117, "label": "eq:ch1-penalty-remainder-estimate", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 322, "latex": "\\begin{equation}\n\\nu\\lVert u_\\varepsilon-u_\\varepsilon^N\\rVert^2\n+\\frac{1}{2\\varepsilon}\n\\lvert\\operatorname{div}(u_\\varepsilon-u_\\varepsilon^N)\\rvert^2\n\\leq\\frac{\\varepsilon^{2N+1}}{2}\\lvert p^N\\rvert^2.\n\\label{eq:ch1-penalty-remainder-estimate}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-32", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.32", "source_pdf_page": 117, "label": "eq:ch1-penalty-remainder-derivative-limit", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 330, "latex": "\\begin{equation}\n-\\frac{1}{\\varepsilon^{N+1}}\n\\frac{\\partial}{\\partial x_i}\n\\operatorname{div}(u_\\varepsilon-u_\\varepsilon^N)\n\\longrightarrow\\frac{\\partial p^N}{\\partial x_i}\n\\quad\\text{在 }H^{-1}(\\Omega)\\text{ 中},\n\\quad1\\leq i\\leq n.\n\\label{eq:ch1-penalty-remainder-derivative-limit}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-33", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.33", "source_pdf_page": 118, "label": "eq:ch1-penalty-recursive-component-zero-mean", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 365, "latex": "\\begin{equation}\n\\int_{\\Omega_j}p^m\\,dx=0\n\\label{eq:ch1-penalty-recursive-component-zero-mean}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-34", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.34", "source_pdf_page": 118, "label": "eq:ch1-penalty-algorithm-spaces", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 386, "latex": "\\begin{equation}\nv\\in\\mathbf H_0^1(\\Omega),\n\\qquad p\\in L^2(\\Omega),\n\\label{eq:ch1-penalty-algorithm-spaces}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-35", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.35", "source_pdf_page": 118, "label": "eq:ch1-penalty-algorithm-momentum", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 391, "latex": "\\begin{equation}\n-\\nu\\Delta v+\\operatorname{grad}p=0,\n\\label{eq:ch1-penalty-algorithm-momentum}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-36", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.36", "source_pdf_page": 118, "label": "eq:ch1-penalty-algorithm-divergence", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 395, "latex": "\\begin{equation}\n\\operatorname{div}v=\\phi,\n\\label{eq:ch1-penalty-algorithm-divergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-37", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.37", "source_pdf_page": 118, "label": "eq:ch1-penalty-algorithm-pressure-zero-mean", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 399, "latex": "\\begin{equation}\n\\int_\\Omega p(x)\\,dx=0,\n\\label{eq:ch1-penalty-algorithm-pressure-zero-mean}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-38", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.38", "source_pdf_page": 118, "label": "eq:ch1-penalty-algorithm-data-compatibility", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 404, "latex": "\\begin{equation}\n\\int_\\Omega\\phi(x)\\,dx=0.\n\\label{eq:ch1-penalty-algorithm-data-compatibility}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-39", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.39", "source_pdf_page": 118, "label": "eq:ch1-penalty-algorithm-initial-pressure", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 411, "latex": "\\begin{equation}\np^0\\in L^2(\\Omega),\n\\qquad\\int_\\Omega p^0(x)\\,dx=0.\n\\label{eq:ch1-penalty-algorithm-initial-pressure}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-40", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.40", "source_pdf_page": 118, "label": "eq:ch1-penalty-uzawa-velocity-step", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 417, "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&v^{m+1}\\in\\mathbf H_0^1(\\Omega),\\\\\n&\\nu((v^{m+1},w))-(p^m,\\operatorname{div}w)=0,\n\\qquad\\forall w\\in\\mathbf H_0^1(\\Omega),\n\\end{aligned}\n\\right.\n\\label{eq:ch1-penalty-uzawa-velocity-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-41", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.41", "source_pdf_page": 118, "label": "eq:ch1-penalty-uzawa-pressure-step", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 427, "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&p^{m+1}\\in L^2(\\Omega),\\\\\n&(p^{m+1}-p^m,\\theta)\n+\\rho(\\operatorname{div}v^{m+1}-\\phi,\\theta)=0,\n\\qquad\\forall\\theta\\in L^2(\\Omega).\n\\end{aligned}\n\\right.\n\\label{eq:ch1-penalty-uzawa-pressure-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-42", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.42", "source_pdf_page": 118, "label": "eq:ch1-penalty-uzawa-dirichlet-step", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 439, "latex": "\\begin{equation}\nv^{m+1}\\in\\mathbf H_0^1(\\Omega),\n\\qquad-\\nu\\Delta v^{m+1}=-\\operatorname{grad}p^m\n\\in\\mathbf H^{-1}(\\Omega),\n\\label{eq:ch1-penalty-uzawa-dirichlet-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-43", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.43", "source_pdf_page": 118, "label": "eq:ch1-penalty-uzawa-pressure-update", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 446, "latex": "\\begin{equation}\np^{m+1}=p^m-\\rho(\\operatorname{div}v^{m+1}-\\phi)\n\\in L^2(\\Omega).\n\\label{eq:ch1-penalty-uzawa-pressure-update}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-44", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.44", "source_pdf_page": 118, "label": "eq:ch1-penalty-uzawa-iterates-zero-mean", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 452, "latex": "\\begin{equation}\n\\int_\\Omega p^m\\,dx=0,\n\\qquad\\forall m\\geq0.\n\\label{eq:ch1-penalty-uzawa-iterates-zero-mean}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-01-section-06-6-45", "batch_id": "chapter-01-section-06", "source_pdf_pages": "113--119", "source_number": "6.45", "source_pdf_page": 119, "label": "eq:ch1-penalty-uzawa-step-condition", "tex_file": "tex/chapters/chapter-01/section-06.tex", "tex_line": 464, "latex": "\\begin{equation}\n0<\\rho<2\\nu,\n\\label{eq:ch1-penalty-uzawa-step-condition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
