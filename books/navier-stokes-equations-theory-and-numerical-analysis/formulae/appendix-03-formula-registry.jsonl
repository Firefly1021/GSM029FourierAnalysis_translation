{"id": "formula-appendix-03-p354-001-51f8bb391c0fb72f", "chapter": "appendix-03", "source_pdf_page": 354, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 51, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nx=(x_1,x_2,x_3),\n\\quad a=(a_1,a_2,a_3),\n\\quad u=(u_1,u_2,u_3).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p354-002-91ccec8cb9f69bce", "chapter": "appendix-03", "source_pdf_page": 354, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 57, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nu(x,t)=\\frac{\\partial\\Phi}{\\partial t}(a,t).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p354-003-dc47e8ba27baf4a2", "chapter": "appendix-03", "source_pdf_page": 354, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 61, "display_type": "numbered-equation", "source_number": "1", "label": "eq:app3-particle-trajectory", "latex": "\\begin{equation}\n\\frac{dx_a(t)}{dt}=u(x_a(t),t),\n\\qquad x_a(0)=a.\n\\label{eq:app3-particle-trajectory}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p354-004-7fa6dce8d11595cb", "chapter": "appendix-03", "source_pdf_page": 354, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 68, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\rho\\gamma_i=f_i+\\sigma_{ij,j},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p354-005-7fc1d9cf3aab4661", "chapter": "appendix-03", "source_pdf_page": 354, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 72, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\gamma_i=\\frac{\\partial u_i}{\\partial t}+u_ju_{i,j}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p354-006-70895f4d8c41405b", "chapter": "appendix-03", "source_pdf_page": 354, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 76, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\sigma_{ij}=2\\mu D_{ij}(u)+\\lambda\\operatorname{div}u\\,\\delta_{ij}-p\\delta_{ij},\n\\qquad\nD_{ij}(u)=\\frac12(u_{i,j}+u_{j,i}),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p354-007-0be62e8b1decd2f1", "chapter": "appendix-03", "source_pdf_page": 354, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 82, "display_type": "numbered-equation", "source_number": "2", "label": "eq:app3-general-nse", "latex": "\\begin{equation}\n\\rho\\left(\\frac{\\partial u_i}{\\partial t}+u_ju_{i,j}\\right)\n-\\mu\\Delta u_i-(\\lambda+\\mu)(\\operatorname{div}u)_{,i}+p_{,i}=f_i.\n\\label{eq:app3-general-nse}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p354-008-86e736c44f41fad1", "chapter": "appendix-03", "source_pdf_page": 354, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 88, "display_type": "numbered-equation", "source_number": "3", "label": "eq:app3-continuity", "latex": "\\begin{equation}\n\\frac{\\partial\\rho}{\\partial t}+\\operatorname{div}(\\rho u)=0.\n\\label{eq:app3-continuity}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p354-009-6abffabbd92aa4c4", "chapter": "appendix-03", "source_pdf_page": 354, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 93, "display_type": "numbered-equation", "source_number": "4", "label": "eq:app3-incompressibility", "latex": "\\begin{equation}\n\\operatorname{div}u=0.\n\\label{eq:app3-incompressibility}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p355-001-acd2dc7f543e56a1", "chapter": "appendix-03", "source_pdf_page": 355, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 102, "display_type": "numbered-equation", "source_number": "5", "label": "eq:app3-incompressible-nse-components", "latex": "\\begin{equation}\n\\frac{\\partial u_i}{\\partial t}+u_ju_{i,j}-\\nu\\Delta u_i+p_{,i}=f_i,\n\\label{eq:app3-incompressible-nse-components}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p355-002-ba28ac8cfa08139b", "chapter": "appendix-03", "source_pdf_page": 355, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 107, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\frac{\\partial u}{\\partial t}+(u\\cdot\\nabla)u-\\nu\\Delta u+\\nabla p=f.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p355-003-224f6c7d8a25fd6e", "chapter": "appendix-03", "source_pdf_page": 355, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 124, "display_type": "numbered-equation", "source_number": "6", "label": "eq:app3-no-slip-boundary", "latex": "\\begin{equation}\nu=0\\quad\\text{在 }\\Gamma\\text{ 上}\n\\label{eq:app3-no-slip-boundary}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p355-004-831190dd72fe5b62", "chapter": "appendix-03", "source_pdf_page": 355, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 129, "display_type": "numbered-equation", "source_number": "6'", "label": "eq:app3-periodic-boundary", "latex": "\\begin{equation*}\nu,p\\text{ 在 }x_i\\text{ 方向以 }L_i\\text{ 为周期},\n\\qquad i=1,2,3.\n\\tag{6'}\n\\label{eq:app3-periodic-boundary}\n\\end{equation*}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p356-001-350d31e7dfd83fec", "chapter": "appendix-03", "source_pdf_page": 356, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 143, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nu\\cdot n=0,\n\\qquad(\\sigma\\cdot n)_\\tau=0\n\\quad\\text{在 }\\Gamma\\text{ 上},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p356-002-a1fe145fe65cfb5d", "chapter": "appendix-03", "source_pdf_page": 356, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 150, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nn\\times\\operatorname{curl}u=0\n\\quad\\text{在 }\\Gamma\\text{ 上}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p356-003-2cf3770de8e2db63", "chapter": "appendix-03", "source_pdf_page": 356, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 155, "display_type": "numbered-equation", "source_number": "7", "label": "eq:app3-initial-velocity", "latex": "\\begin{equation}\nu(x,0)=u_0(x)\\quad(\\text{给定}),\n\\qquad x\\in\\Omega.\n\\label{eq:app3-initial-velocity}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p356-004-28d1db086d93899d", "chapter": "appendix-03", "source_pdf_page": 356, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 164, "display_type": "numbered-equation", "source_number": "8", "label": "eq:app3-pressure-poisson", "latex": "\\begin{equation}\n\\Delta p=\\operatorname{div}f-u_{j,i}u_{i,j}.\n\\label{eq:app3-pressure-poisson}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p356-005-ed34e9310f3c29e1", "chapter": "appendix-03", "source_pdf_page": 356, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 171, "display_type": "numbered-equation", "source_number": "9", "label": "eq:app3-pressure-neumann", "latex": "\\begin{equation}\n\\frac{\\partial p}{\\partial n}=f\\cdot n+\\nu\\Delta u\\cdot n\n\\quad\\text{在 }\\Gamma\\text{ 上}.\n\\label{eq:app3-pressure-neumann}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p356-006-cc93590b06f471cd", "chapter": "appendix-03", "source_pdf_page": 356, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 181, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\mathcal V=\\{v\\in C_0^\\infty(\\Omega)^d:\\operatorname{div}v=0\\},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p356-007-cc075172f66de1de", "chapter": "appendix-03", "source_pdf_page": 356, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 185, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n((u,v))=\\sum_{j=1}^d\\left(\\frac{\\partial u}{\\partial x_j},\\frac{\\partial v}{\\partial x_j}\\right),\n\\qquad\n\\lVert u\\rVert=((u,u))^{1/2}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p356-008-0ea8db7bef64fc5f", "chapter": "appendix-03", "source_pdf_page": 356, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 191, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n(f,g)=\\int_\\Omega f(x)g(x)\\,dx,\n\\qquad |f|=(f,f)^{1/2}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p357-001-a84a8bc4aa749f80", "chapter": "appendix-03", "source_pdf_page": 357, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 198, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nH=\\{v\\in L^2(\\Omega)^d:\\operatorname{div}v=0, v\\cdot n|_{\\partial\\Omega}=0\\},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p357-002-e1f3aff9f3a4274b", "chapter": "appendix-03", "source_pdf_page": 357, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 201, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nV=\\{v\\in H_0^1(\\Omega)^d:\\operatorname{div}v=0\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p357-003-07ca799873879e2a", "chapter": "appendix-03", "source_pdf_page": 357, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 211, "display_type": "numbered-equation", "source_number": "10", "label": "eq:app3-stokes-problem", "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n-\\Delta u+\\operatorname{grad}p&=f&&\\text{在 }\\Omega\\text{ 中},\\\\\n\\operatorname{div}u&=0&&\\text{在 }\\Omega\\text{ 中},\\\\\nu&=0&&\\text{在 }\\Gamma\\text{ 上}.\n\\end{aligned}\n\\right.\n\\label{eq:app3-stokes-problem}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p357-004-b0fb3a69d7b3dec7", "chapter": "appendix-03", "source_pdf_page": 357, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 224, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nAw_j=\\lambda_jw_j,\n\\qquad j\\geq1,\n\\qquad \\lambda_j\\to\\infty\\quad(j\\to\\infty).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p357-005-d9889b7a8958d6d2", "chapter": "appendix-03", "source_pdf_page": 357, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 233, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nu\\in V,\n\\qquad ((u,v))=(f,v),\n\\quad\\forall v\\in V.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p357-006-e51b407674ab0f3a", "chapter": "appendix-03", "source_pdf_page": 357, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 239, "display_type": "numbered-equation", "source_number": "11", "label": "eq:app3-gradient-distribution-characterization", "latex": "\\begin{equation}\nM\\in\\operatorname{grad}\\mathcal D'(\\Omega)\n\\quad\\Longleftrightarrow\\quad\n\\langle M,\\varphi\\rangle=0,\n\\quad\\forall\\varphi\\in\\mathcal V.\n\\label{eq:app3-gradient-distribution-characterization}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p358-001-d26ab13ae596cea3", "chapter": "appendix-03", "source_pdf_page": 358, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 252, "display_type": "numbered-equation", "source_number": "12", "label": "eq:app3-weak-nse", "latex": "\\begin{equation}\n\\frac d{dt}(u(t),v)+\\nu((u(t),v))+b(u(t),u(t),v)=(f(t),v),\n\\quad\\forall v\\in V,\n\\qquad u(0)=u_0.\n\\label{eq:app3-weak-nse}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p358-002-3fd8644d7492f5f2", "chapter": "appendix-03", "source_pdf_page": 358, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 259, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nb(u,v,w)=\\sum_{i,j=1}^d\\int_\\Omega u_i\\frac{\\partial v_j}{\\partial x_i}w_j\\,dx.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p359-001-9b851b85c7a65200", "chapter": "appendix-03", "source_pdf_page": 359, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 287, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\frac12\\frac d{dt}|A^{1/4}u|^2+\\nu|A^{3/4}u|^2\n=-b(u,u,A^{1/2}u)\n\\leq c_1|A^{1/4}u||A^{3/4}u|^2.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p360-001-a0464d7486d76c74", "chapter": "appendix-03", "source_pdf_page": 360, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 296, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\frac12\\frac d{dt}\\lVert u\\rVert^2+\\nu|Au|^2\n\\leq c_1|A^{1/4}u||Au|^2.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p360-002-318f07fa8308a6de", "chapter": "appendix-03", "source_pdf_page": 360, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 301, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lVert u_0\\rVert\\geq\\lambda_J^{1/4}|A^{1/4}u_0|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p360-003-4d2b6a8e6c6be6f5", "chapter": "appendix-03", "source_pdf_page": 360, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 314, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\{u\\in\\mathcal D'(\\Omega)^d:\\partial u_i/\\partial x_j\\in L^2(\\Omega),\\ i,j=1,\\ldots,d\\}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p362-001-dc7b7472dd2969d9", "chapter": "appendix-03", "source_pdf_page": 362, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 351, "display_type": "numbered-equation", "source_number": "13", "label": "eq:app3-singular-self-similar", "latex": "\\begin{equation}\nu(x,t)=\\frac1{\\sqrt{2a(T-t)}}\nU\\left(\\frac{x}{\\sqrt{2a(T-t)}}\\right),\n\\label{eq:app3-singular-self-similar}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p362-002-8d7f5344a5c45b27", "chapter": "appendix-03", "source_pdf_page": 362, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 357, "display_type": "numbered-equation", "source_number": "14", "label": "eq:app3-self-similar-profile", "latex": "\\begin{equation}\n-\\nu\\Delta U+aU+a(y\\cdot\\nabla)U+(U\\cdot\\nabla)U+\\nabla P=0,\n\\qquad\\operatorname{div}U=0\n\\label{eq:app3-self-similar-profile}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p364-001-48ce940281b74a33", "chapter": "appendix-03", "source_pdf_page": 364, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 393, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\frac d{dt}\\int_H\\Phi(u)\\,d\\mu_t(u)\n+\\int_H\\{((u,\\Phi'(u)))+b(u,u,\\Phi'(u))-(f,\\Phi'(u))\\}\\,d\\mu_t(u)=0,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p364-002-5e7b49817e9e8bd2", "chapter": "appendix-03", "source_pdf_page": 364, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 406, "display_type": "numbered-equation", "source_number": "15", "label": "eq:app3-time-average-velocity", "latex": "\\begin{equation}\n\\frac1T\\int_0^T u(\\cdot,t)\\,dt\n\\label{eq:app3-time-average-velocity}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p364-003-2df8bae0726b03de", "chapter": "appendix-03", "source_pdf_page": 364, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 411, "display_type": "numbered-equation", "source_number": "16", "label": "eq:app3-banach-limit-statistical-solution", "latex": "\\begin{equation}\n\\operatorname{LIM}_{T\\to\\infty}\\frac1T\\int_0^T\\Phi(u(t))\\,dt\n=\\int\\Phi(u)\\,d\\mu_f(u).\n\\label{eq:app3-banach-limit-statistical-solution}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p365-001-9fefb74f2d0ddf0b", "chapter": "appendix-03", "source_pdf_page": 365, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 422, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\int\\Phi(S(t)u)\\,d\\mu(u)=\\int\\Phi(u)\\,d\\mu(u),\n\\qquad\\forall t\\geq0.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p365-002-a4f35d278586b4af", "chapter": "appendix-03", "source_pdf_page": 365, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 427, "display_type": "numbered-equation", "source_number": "17", "label": "eq:app3-statistical-measure-attractor-support", "latex": "\\begin{equation}\n\\mu(H\\setminus\\mathcal A)=0.\n\\label{eq:app3-statistical-measure-attractor-support}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p365-003-7aae465f14d5de55", "chapter": "appendix-03", "source_pdf_page": 365, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 439, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nGr=|f|\\nu^{-2}L^{3-d/2},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p365-004-e5a7ce6d080e445c", "chapter": "appendix-03", "source_pdf_page": 365, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 445, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\dim\\mathcal A\\leq cGr^{2/3}(\\log Gr)^{1/3},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p366-001-da852abb02fa6278", "chapter": "appendix-03", "source_pdf_page": 366, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 461, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nE(k)=\\frac12\\sum_{\\substack{j\\in\\mathbb Z^d\\\\|j|\\geq k}}|\\widehat u_j|^2,\n\\qquad\nu=\\sum_{j\\in\\mathbb Z^d}\\widehat u_je^{ij\\cdot x},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p366-002-94498389cd4593f1", "chapter": "appendix-03", "source_pdf_page": 366, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 470, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nP_N(u_1(t)-u_2(t))\\to0\\quad(t\\to\\infty),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p366-003-f76323fa70d0bc8e", "chapter": "appendix-03", "source_pdf_page": 366, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 474, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nu_1(t)-u_2(t)\\to0\\quad(t\\to\\infty).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p369-001-446912be3f2a737c", "chapter": "appendix-03", "source_pdf_page": 369, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 534, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\Pi=k\\rho^\\gamma-(2\\mu_1+\\mu_2)\\operatorname{div}u\n\\in W_{\\mathrm{loc}}^{1,2}(\\Omega)\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p369-002-c4d5550ad0fd468b", "chapter": "appendix-03", "source_pdf_page": 369, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 539, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\rho v_i\\partial_i(-\\Delta)^{-1}\\partial_j(\\rho v_j)\n-\\partial_i(-\\Delta)^{-1}\\partial_j(\\rho v_iv_j).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p370-001-8e809c127d49cb11", "chapter": "appendix-03", "source_pdf_page": 370, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 564, "display_type": "numbered-equation", "source_number": "18", "label": "eq:app3-euler-nonpenetration", "latex": "\\begin{equation}\nu\\cdot n=0\n\\quad\\text{在 }\\Gamma\\text{ 上}.\n\\label{eq:app3-euler-nonpenetration}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p370-002-d694415213d744e7", "chapter": "appendix-03", "source_pdf_page": 370, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 577, "display_type": "numbered-equation", "source_number": "19", "label": "eq:app3-vorticity-equation", "latex": "\\begin{equation}\n\\frac{\\partial\\omega}{\\partial t}+(u\\cdot\\nabla)\\omega\n=(\\omega\\cdot\\nabla)u+\\operatorname{curl}f.\n\\label{eq:app3-vorticity-equation}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-03-p371-001-e1973ea8dce8fb2e", "chapter": "appendix-03", "source_pdf_page": 371, "tex_file": "tex/chapters/appendix-03.tex", "tex_line": 593, "display_type": "numbered-equation", "source_number": "20", "label": "eq:app3-euler-apriori-estimate", "latex": "\\begin{equation}\n\\frac d{dt}\\lVert u\\rVert_{H^m}\n\\leq c\\bigl(\\lVert u\\rVert_{H^s}\\lVert u\\rVert_{H^m}+\\lVert f\\rVert_{H^m}\\bigr),\n\\label{eq:app3-euler-apriori-estimate}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
