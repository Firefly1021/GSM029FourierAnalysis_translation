{"id":"formula-chapter-01-section-02-2-45","batch_id":"chapter-01-section-02","source_pdf_pages":"30--43","source_number":"2.45","label":"eq:ch1-stokes-regularity-conclusion","tex_file":"tex/chapters/chapter-01/section-02.tex","tex_line":578,"latex":"\\begin{equation}\nu\\in\\mathbf W^{m+2,\\alpha}(\\Omega),\\qquad\np\\in W^{m+1,\\alpha}(\\Omega),\n\\label{eq:ch1-stokes-regularity-conclusion}\n\\end{equation}","token_checks":{"subscripts":"visually-checked","superscripts":"visually-checked","relations":"visually-checked","signs":"visually-checked","delimiters":"visually-checked","domains_and_ranges":"visually-checked"},"review_status":"reviewed"}
