{"id": "formula-chapter-03-p238-009-2fece70e6b98c810", "chapter": 3, "source_pdf_page": 238, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 527, "display_type": "numbered-equation", "source_number": "4.50", "label": "eq:ch3-semidiscrete-discrete-energy-remark", "latex": "\\begin{equation}\n|u^r|^2+2k\\nu\\sum_{m=1}^r\\lVert u^m\\rVert^2\n\\leq|u_0|^2+2k\\sum_{m=1}^r\\langle f^m,u^m\\rangle.\n\\label{eq:ch3-semidiscrete-discrete-energy-remark}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p238-010-ba368ec4fd438a9e", "chapter": 3, "source_pdf_page": 238, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 533, "display_type": "numbered-equation", "source_number": "4.51", "label": "eq:ch3-semidiscrete-functional-energy-remark", "latex": "\\begin{equation}\n|u_k(t)|^2+2\\nu\\int_0^{t_k}\\lVert u_k(s)\\rVert^2\\,ds\n\\leq|u_0|^2+\\int_0^{t_k}\\langle f_k(s),u_k(s)\\rangle\\,ds,\n\\label{eq:ch3-semidiscrete-functional-energy-remark}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
