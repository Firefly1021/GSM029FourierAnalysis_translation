{"id": "formula-chapter-03-p231-001-f78885e0f8e927b9", "chapter": 3, "source_pdf_page": 231, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 11, "display_type": "numbered-equation", "source_number": "4.1", "label": "eq:ch3-semidiscrete-vs-definition", "latex": "\\begin{equation}\nV_s=\\overline{\\mathcal V}^{\\,\\mathbf H_0^1(\\Omega)\\cap\\mathbf H^s(\\Omega)},\n\\qquad s\\geq1.\n\\label{eq:ch3-semidiscrete-vs-definition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p232-001-510ff8368c4b6c33", "chapter": 3, "source_pdf_page": 232, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 19, "display_type": "numbered-equation", "source_number": "4.2", "label": "eq:ch3-semidiscrete-hs-norm", "latex": "\\begin{equation}\n\\lVert u\\rVert_{\\mathbf H^s(\\Omega)}=\n\\left\\{\\sum_{|j|\\leq s}|D^ju|^2\\right\\}^{1/2}\n\\qquad(s\\text{ 为整数}).\n\\label{eq:ch3-semidiscrete-hs-norm}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p232-002-03f9eb03baa2241b", "chapter": 3, "source_pdf_page": 232, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 26, "display_type": "numbered-equation", "source_number": "4.3", "label": "eq:ch3-semidiscrete-vs-embedding", "latex": "\\begin{equation}\nV_s\\subset V\n\\label{eq:ch3-semidiscrete-vs-embedding}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p232-003-09b2cda615e71970", "chapter": 3, "source_pdf_page": 232, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 36, "display_type": "numbered-equation", "source_number": "4.4", "label": "eq:ch3-semidiscrete-trilinear-estimate", "latex": "\\begin{equation}\n|b(u,v,w)|\\leq c|u|\\lVert v\\rVert\\lVert w\\rVert_{V_s}.\n\\label{eq:ch3-semidiscrete-trilinear-estimate}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p232-004-5912e9cc84f449a7", "chapter": 3, "source_pdf_page": 232, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 44, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n|b(u,v,w)|=|b(u,w,v)|\n&\\leq\\sum_{i,j=1}^n\\lVert u_i\\rVert_{L^2(\\Omega)}\n\\lVert D_iw_j\\rVert_{L^n(\\Omega)}\n\\lVert v_j\\rVert_{L^{2n/(n-2)}(\\Omega)}\\\\\n&\\leq c_0|u|\\lVert v\\rVert\\sum_{i,j=1}^n\n\\lVert D_iw_j\\rVert_{L^n(\\Omega)},\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p232-005-a31c9c5693a0b322", "chapter": 3, "source_pdf_page": 232, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 55, "display_type": "numbered-equation", "source_number": "4.5", "label": "eq:ch3-semidiscrete-sobolev-exponent", "latex": "\\begin{equation}\n\\frac1q=\\frac12-\\frac{s-1}{n},\n\\qquad q\\geq n.\n\\label{eq:ch3-semidiscrete-sobolev-exponent}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p232-006-d9f87be62b2aa696", "chapter": 3, "source_pdf_page": 232, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 61, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lVert D_iw_j\\rVert_{L^n(\\Omega)}\\leq c_1\\lVert w\\rVert_{V_s}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p232-007-0c8c2b0186f20bb5", "chapter": 3, "source_pdf_page": 232, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 65, "display_type": "numbered-equation", "source_number": "4.6", "label": "eq:ch3-semidiscrete-trilinear-estimate-dense", "latex": "\\begin{equation}\n|b(u,v,w)|\\leq c_2|u|\\lVert v\\rVert\\lVert w\\rVert_{V_s}.\n\\label{eq:ch3-semidiscrete-trilinear-estimate-dense}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p232-008-adc59d29400db65e", "chapter": 3, "source_pdf_page": 232, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 80, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n|\\langle Bu(t),v\\rangle|=|b(u(t),u(t),v)|\n\\leq c|u(t)|\\lVert u(t)\\rVert\\lVert v\\rVert_{V_s},\n\\qquad\\forall v\\in V_s.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p232-009-412d507bd503658d", "chapter": 3, "source_pdf_page": 232, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 86, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lVert Bu(t)\\rVert_{V_s'}\\leq c|u(t)|\\lVert u(t)\\rVert,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p233-001-ba468aaf89fb7257", "chapter": 3, "source_pdf_page": 233, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 98, "display_type": "numbered-equation", "source_number": "4.7", "label": "eq:ch3-semidiscrete-force", "latex": "\\begin{equation}\nf\\in L^2(0,T;V'),\n\\label{eq:ch3-semidiscrete-force}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p233-002-118d0801094723ae", "chapter": 3, "source_pdf_page": 233, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 102, "display_type": "numbered-equation", "source_number": "4.8", "label": "eq:ch3-semidiscrete-initial-data", "latex": "\\begin{equation}\nu_0\\in H,\n\\label{eq:ch3-semidiscrete-initial-data}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p233-003-1d68e5378ae7402b", "chapter": 3, "source_pdf_page": 233, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 107, "display_type": "numbered-equation", "source_number": "4.9", "label": "eq:ch3-semidiscrete-solution-space", "latex": "\\begin{equation}\nu\\in L^2(0,T;V)\\cap L^\\infty(0,T;H),\n\\label{eq:ch3-semidiscrete-solution-space}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p233-004-71f75acd98be7d43", "chapter": 3, "source_pdf_page": 233, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 111, "display_type": "numbered-equation", "source_number": "4.10", "label": "eq:ch3-semidiscrete-variational-equation", "latex": "\\begin{equation}\n\\frac d{dt}(u,v)+\\nu((u,v))+b(u,u,v)=\\langle f,v\\rangle,\n\\qquad\\forall v\\in V_s,quad s\\geq\\frac n2,\n\\label{eq:ch3-semidiscrete-variational-equation}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p233-005-e945e289477e3745", "chapter": 3, "source_pdf_page": 233, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 116, "display_type": "numbered-equation", "source_number": "4.11", "label": "eq:ch3-semidiscrete-initial-condition", "latex": "\\begin{equation}\nu(0)=u_0.\n\\label{eq:ch3-semidiscrete-initial-condition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p233-006-8e882063db05877a", "chapter": 3, "source_pdf_page": 233, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 121, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\frac d{dt}\\langle u,v\\rangle=\\langle g,v\\rangle,\n\\qquad\\forall v\\in V_s,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p233-007-22282dd25acc0cee", "chapter": 3, "source_pdf_page": 233, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 126, "display_type": "numbered-equation", "source_number": "4.12", "label": "eq:ch3-semidiscrete-g-space", "latex": "\\begin{equation}\ng\\in L^2(0,T;V_s').\n\\label{eq:ch3-semidiscrete-g-space}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p233-008-519bc0799b141976", "chapter": 3, "source_pdf_page": 233, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 131, "display_type": "numbered-equation", "source_number": "4.13", "label": "eq:ch3-semidiscrete-time-derivative", "latex": "\\begin{equation}\nu'\\in L^2(0,T;V_s'),\n\\qquad u'=f-\\nu Au-Bu.\n\\label{eq:ch3-semidiscrete-time-derivative}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p233-009-7be1e7dcb6c58d77", "chapter": 3, "source_pdf_page": 233, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 143, "display_type": "numbered-equation", "source_number": "4.14", "label": "eq:ch3-semidiscrete-operator-space", "latex": "\\begin{equation}\nu\\in L^2(0,T;V)\\cap L^\\infty(0,T;H),\n\\qquad u'\\in L^2(0,T;V_s'),quad s\\geq\\frac n2,\n\\label{eq:ch3-semidiscrete-operator-space}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p233-010-5a4d20140b120a19", "chapter": 3, "source_pdf_page": 233, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 148, "display_type": "numbered-equation", "source_number": "4.15", "label": "eq:ch3-semidiscrete-operator-equation", "latex": "\\begin{equation}\nu'+\\nu Au+Bu=f\\quad\\text{于 }(0,T),\n\\label{eq:ch3-semidiscrete-operator-equation}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p233-011-cac5fa768c3fea20", "chapter": 3, "source_pdf_page": 233, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 152, "display_type": "numbered-equation", "source_number": "4.16", "label": "eq:ch3-semidiscrete-operator-initial", "latex": "\\begin{equation}\nu(0)=u_0.\n\\label{eq:ch3-semidiscrete-operator-initial}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p234-001-c8e0b1932cf2d90b", "chapter": 3, "source_pdf_page": 234, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 170, "display_type": "numbered-equation", "source_number": "4.17", "label": "eq:ch3-semidiscrete-time-step", "latex": "\\begin{equation}\nk=\\frac TN.\n\\label{eq:ch3-semidiscrete-time-step}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p234-002-dbfe0425bd93ba70", "chapter": 3, "source_pdf_page": 234, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 177, "display_type": "numbered-equation", "source_number": "4.18", "label": "eq:ch3-semidiscrete-force-average", "latex": "\\begin{equation}\nf^m=\\frac1k\\int_{(m-1)k}^{mk}f(t)\\,dt,\n\\qquad m=1,\\ldots,N;quad f^m\\in V'.\n\\label{eq:ch3-semidiscrete-force-average}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p234-003-fbf8a2e36ccdbe30", "chapter": 3, "source_pdf_page": 234, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 183, "display_type": "numbered-equation", "source_number": "4.19", "label": "eq:ch3-semidiscrete-u0", "latex": "\\begin{equation}\nu^0=u_0\n\\label{eq:ch3-semidiscrete-u0}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p234-004-1b31a2543052c172", "chapter": 3, "source_pdf_page": 234, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 188, "display_type": "numbered-equation", "source_number": "4.20", "label": "eq:ch3-semidiscrete-recursion", "latex": "\\begin{equation}\n\\frac{u^m-u^{m-1}}k+\\nu Au^m+Bu^m=f^m\n\\label{eq:ch3-semidiscrete-recursion}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p234-005-08cdb87c6ac6334f", "chapter": 3, "source_pdf_page": 234, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 198, "display_type": "numbered-equation", "source_number": "4.21", "label": "eq:ch3-semidiscrete-step-energy", "latex": "\\begin{equation}\n|u^m|^2-|u^{m-1}|^2+|u^m-u^{m-1}|^2\n+2k\\nu\\lVert u^m\\rVert^2\\leq2k\\langle f^m,u^m\\rangle.\n\\label{eq:ch3-semidiscrete-step-energy}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p234-006-1d5520afe245ad86", "chapter": 3, "source_pdf_page": 234, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 206, "display_type": "numbered-equation", "source_number": "4.22", "label": "eq:ch3-semidiscrete-piecewise-constant", "latex": "\\begin{equation}\nu_k:[0,T]\\to V,\n\\qquad u_k(t)=u^m,quad t\\in[(m-1)k,mk],\\quad m=1,\\ldots,N,\n\\label{eq:ch3-semidiscrete-piecewise-constant}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p234-007-438328c9fffcd404", "chapter": 3, "source_pdf_page": 234, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 211, "display_type": "numbered-equation", "source_number": "4.23", "label": "eq:ch3-semidiscrete-piecewise-linear", "latex": "\\begin{equation}\nw_k:[0,T]\\to H,\n\\quad w_k\\text{ 连续且在每个 }[(m-1)k,mk]\\text{ 上线性},\n\\quad w_k(mk)=u^m,quad m=0,\\ldots,N.\n\\label{eq:ch3-semidiscrete-piecewise-linear}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p234-008-6875835cb7d68b67", "chapter": 3, "source_pdf_page": 234, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 221, "display_type": "numbered-equation", "source_number": "4.24", "label": "eq:ch3-semidiscrete-step-variational", "latex": "\\begin{equation}\n(u^m,v)+k\\nu((u^m,v))+kb(u^m,u^m,v)\n=\\langle u^{m-1}+kf^m,v\\rangle,\n\\qquad\\forall v\\in V_s.\n\\label{eq:ch3-semidiscrete-step-variational}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p234-009-bd82894997c41d0b", "chapter": 3, "source_pdf_page": 234, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 228, "display_type": "numbered-equation", "source_number": "4.25", "label": "eq:ch3-semidiscrete-galerkin-phi", "latex": "\\begin{equation}\n\\varphi_r=\\sum_{i=1}^r\\xi_{i,r}w_i,\n\\label{eq:ch3-semidiscrete-galerkin-phi}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p234-010-9875842d76d9a123", "chapter": 3, "source_pdf_page": 234, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 233, "display_type": "numbered-equation", "source_number": "4.26", "label": "eq:ch3-semidiscrete-galerkin-equation", "latex": "\\begin{equation}\n(\\varphi_r,v)+k\\nu((\\varphi_r,v))+kb(\\varphi_r,\\varphi_r,v)\n=\\langle u^{m-1}+kf^m,v\\rangle,\n\\quad\\forall v\\in\\operatorname{Sp}[w_1,\\ldots,w_r].\n\\label{eq:ch3-semidiscrete-galerkin-equation}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p235-001-fd594c0264184cd6", "chapter": 3, "source_pdf_page": 235, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 242, "display_type": "numbered-equation", "source_number": "4.27", "label": "eq:ch3-semidiscrete-galerkin-energy", "latex": "\\begin{equation}\n(\\varphi_r-u^{m-1},\\varphi_r)+k\\nu\\lVert\\varphi_r\\rVert^2\n=k\\langle f^m,\\varphi_r\\rangle.\n\\label{eq:ch3-semidiscrete-galerkin-energy}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p235-002-0427b9ce281d35f9", "chapter": 3, "source_pdf_page": 235, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 248, "display_type": "numbered-equation", "source_number": "4.28", "label": "eq:ch3-semidiscrete-polarization", "latex": "\\begin{equation}\n2(a-b,a)=|a|^2-|b|^2+|a-b|^2,\n\\qquad\\forall a,b\\in H,\n\\label{eq:ch3-semidiscrete-polarization}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p235-003-0ddac0924a232664", "chapter": 3, "source_pdf_page": 235, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 254, "display_type": "numbered-equation", "source_number": "4.29", "label": "eq:ch3-semidiscrete-galerkin-energy-bound", "latex": "\\begin{equation}\n\\begin{aligned}\n|\\varphi_r|^2+|\\varphi_r-u^{m-1}|^2+2k\\nu\\lVert\\varphi_r\\rVert^2\n&=|u^{m-1}|^2+2k\\langle f^m,\\varphi_r\\rangle\\\\\n&\\leq|u^{m-1}|^2+k\\nu\\lVert\\varphi_r\\rVert^2\n+\\frac k\\nu\\lVert f^m\\rVert_{V'}^2.\n\\end{aligned}\n\\label{eq:ch3-semidiscrete-galerkin-energy-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p235-004-146f40508c604fef", "chapter": 3, "source_pdf_page": 235, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 264, "display_type": "numbered-equation", "source_number": "4.30", "label": "eq:ch3-semidiscrete-galerkin-uniform-bound", "latex": "\\begin{equation}\n|\\varphi_r|^2+|\\varphi_r-u^{m-1}|^2+k\\nu\\lVert\\varphi_r\\rVert^2\n\\leq|u^{m-1}|^2+\\frac k\\nu\\lVert f^m\\rVert_{V'}^2.\n\\label{eq:ch3-semidiscrete-galerkin-uniform-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p235-005-46b842786673823b", "chapter": 3, "source_pdf_page": 235, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 270, "display_type": "numbered-equation", "source_number": "4.31", "label": "eq:ch3-semidiscrete-galerkin-weak-limit", "latex": "\\begin{equation}\n\\varphi_{r'}\\rightharpoonup\\varphi\\quad\\text{在 }V\\text{ 中},\n\\qquad r'\\to\\infty.\n\\label{eq:ch3-semidiscrete-galerkin-weak-limit}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p235-006-6497dff971d6b526", "chapter": 3, "source_pdf_page": 235, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 284, "display_type": "numbered-equation", "source_number": "4.32", "label": "eq:ch3-semidiscrete-um-bound", "latex": "\\begin{equation}\n|u^m|^2\\leq d_1,\n\\qquad m=1,\\ldots,N,\n\\label{eq:ch3-semidiscrete-um-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p235-007-83dba349cc535f12", "chapter": 3, "source_pdf_page": 235, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 289, "display_type": "numbered-equation", "source_number": "4.33", "label": "eq:ch3-semidiscrete-v-sum-bound", "latex": "\\begin{equation}\nk\\sum_{m=1}^N\\lVert u^m\\rVert^2\\leq\\frac{d_1}\\nu,\n\\label{eq:ch3-semidiscrete-v-sum-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p235-008-ecae3c3b51505bac", "chapter": 3, "source_pdf_page": 235, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 293, "display_type": "numbered-equation", "source_number": "4.34", "label": "eq:ch3-semidiscrete-increment-bound", "latex": "\\begin{equation}\n\\sum_{m=1}^N|u^m-u^{m-1}|^2\\leq d_1,\n\\label{eq:ch3-semidiscrete-increment-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p235-009-5b45c00ac83e68e5", "chapter": 3, "source_pdf_page": 235, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 298, "display_type": "numbered-equation", "source_number": "4.35", "label": "eq:ch3-semidiscrete-d1", "latex": "\\begin{equation}\nd_1=|u_0|^2+\\frac1\\nu\\int_0^T\\lVert f(s)\\rVert_{V'}^2\\,ds.\n\\label{eq:ch3-semidiscrete-d1}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p236-001-d65b50bd85e88990", "chapter": 3, "source_pdf_page": 236, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 309, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n2k\\lVert f^m\\rVert_{V'}\\lVert u^m\\rVert\n\\leq k\\nu\\lVert u^m\\rVert^2+\\frac k\\nu\\lVert f^m\\rVert_{V'}^2\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p236-002-3718b5661924572c", "chapter": 3, "source_pdf_page": 236, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 314, "display_type": "numbered-equation", "source_number": "4.36", "label": "eq:ch3-semidiscrete-step-energy-reduced", "latex": "\\begin{equation}\n|u^m|^2-|u^{m-1}|^2+|u^m-u^{m-1}|^2+k\\nu\\lVert u^m\\rVert^2\n\\leq\\frac k\\nu\\lVert f^m\\rVert_{V'}^2.\n\\label{eq:ch3-semidiscrete-step-energy-reduced}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p236-003-644e6274805c47c9", "chapter": 3, "source_pdf_page": 236, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 320, "display_type": "numbered-equation", "source_number": "4.37", "label": "eq:ch3-semidiscrete-global-energy", "latex": "\\begin{equation}\n|u^N|^2+\\sum_{m=1}^N|u^m-u^{m-1}|^2\n+k\\nu\\sum_{m=1}^N\\lVert u^m\\rVert^2\n\\leq|u_0|^2+\\frac k\\nu\\sum_{m=1}^N\\lVert f^m\\rVert_{V'}^2.\n\\label{eq:ch3-semidiscrete-global-energy}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p236-004-ecf9714584a8f512", "chapter": 3, "source_pdf_page": 236, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 327, "display_type": "numbered-equation", "source_number": "4.38", "label": "eq:ch3-semidiscrete-partial-energy", "latex": "\\begin{equation}\n|u^r|^2\\leq|u_0|^2+\\frac k\\nu\\sum_{m=1}^r\\lVert f^m\\rVert_{V'}^2\n\\leq|u_0|^2+\\frac k\\nu\\sum_{m=1}^N\\lVert f^m\\rVert_{V'}^2,\n\\quad r=1,\\ldots,N.\n\\label{eq:ch3-semidiscrete-partial-energy}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p236-005-b5626074d9bd0999", "chapter": 3, "source_pdf_page": 236, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 340, "display_type": "numbered-equation", "source_number": "4.39", "label": "eq:ch3-semidiscrete-force-average-estimate", "latex": "\\begin{equation}\nk\\sum_{m=1}^N\\lVert f^m\\rVert_{V'}^2\n\\leq\\int_0^T\\lVert f(t)\\rVert_{V'}^2\\,dt.\n\\label{eq:ch3-semidiscrete-force-average-estimate}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p236-006-ec5b16ac5c4ce04f", "chapter": 3, "source_pdf_page": 236, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 349, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lVert f^m\\rVert_{V'}^2\n=\\left\\lVert\\frac1k\\int_{(m-1)k}^{mk}f(t)\\,dt\\right\\rVert_{V'}^2\n\\leq\\frac1k\\int_{(m-1)k}^{mk}\\lVert f(t)\\rVert_{V'}^2\\,dt.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p236-007-3f04797d10243afa", "chapter": 3, "source_pdf_page": 236, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 361, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nk\\sum_{m=1}^N\n\\left\\lVert\\frac{u^m-u^{m-1}}k\\right\\rVert_{V_s'}^2\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p236-008-0bf384db63476078", "chapter": 3, "source_pdf_page": 236, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 370, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n\\left\\lVert\\frac{u^m-u^{m-1}}k\\right\\rVert_{V_s'}\n&\\leq\\lVert f^m\\rVert_{V_s'}+\\nu\\lVert Au^m\\rVert_{V_s'}\n+\\lVert Bu^m\\rVert_{V_s'}\\\\\n&\\leq c_1(\\lVert f^m\\rVert_{V'}+\\lVert u^m\\rVert)+\\lVert Bu^m\\rVert_{V_s'},\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p236-009-4b96aee258c0b607", "chapter": 3, "source_pdf_page": 236, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 379, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\left\\lVert\\frac{u^m-u^{m-1}}k\\right\\rVert_{V_s'}^2\n\\leq c_2\\{\\lVert f^m\\rVert_{V'}^2+\\lVert u^m\\rVert^2\n+\\lVert Bu^m\\rVert_{V_s'}^2\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p236-010-22353b9cdfe2da61", "chapter": 3, "source_pdf_page": 236, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 385, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lVert Bu^m\\rVert_{V_s'}^2\\leq c_3|u^m|^2\\lVert u^m\\rVert^2\n\\leq c_4\\lVert u^m\\rVert^2.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p237-001-affce0f19fdb66d1", "chapter": 3, "source_pdf_page": 237, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 392, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nk\\sum_{m=1}^N\n\\left\\lVert\\frac{u^m-u^{m-1}}k\\right\\rVert_{V_s'}^2\n\\leq c_5k\\sum_{m=1}^N(\\lVert f^m\\rVert_{V'}^2+\\lVert u^m\\rVert^2),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p237-002-bcd32197ebd4ce9d", "chapter": 3, "source_pdf_page": 237, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 406, "display_type": "numbered-equation", "source_number": "4.40", "label": "eq:ch3-semidiscrete-uk-wk-convergence", "latex": "\\begin{equation}\nu_k-w_k\\longrightarrow0\\quad\\text{在 }L^2(0,T;H)\\text{ 中},\n\\qquad k\\to0.\n\\label{eq:ch3-semidiscrete-uk-wk-convergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p237-003-52355ef83df59d72", "chapter": 3, "source_pdf_page": 237, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 421, "display_type": "numbered-equation", "source_number": "4.41", "label": "eq:ch3-semidiscrete-interpolation-distance-formula", "latex": "\\begin{equation}\n|u_k-w_k|_{L^2(0,T;H)}\n=\\left\\{\\frac k3\\sum_{m=1}^N|u^m-u^{m-1}|^2\\right\\}^{1/2}.\n\\label{eq:ch3-semidiscrete-interpolation-distance-formula}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p237-004-473dbdb624c0b1fb", "chapter": 3, "source_pdf_page": 237, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 430, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nw_k(t)-u_k(t)=\\frac{t-mk}{k}(u^m-u^{m-1}),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p237-005-60bbd28878c095ef", "chapter": 3, "source_pdf_page": 237, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 434, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\int_{(m-1)k}^{mk}|w_k(t)-u_k(t)|^2\\,dt\n=\\frac k3|u^m-u^{m-1}|^2.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p237-006-b17652f8f750f86a", "chapter": 3, "source_pdf_page": 237, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 444, "display_type": "numbered-equation", "source_number": "4.42", "label": "eq:ch3-semidiscrete-uk-weak-limits", "latex": "\\begin{equation}\nu_{k'}\\rightharpoonup u\\quad\\text{在 }L^2(0,T;V)\\text{ 中},\n\\qquad\nu_{k'}\\overset{*}{\\rightharpoonup}u\\quad\\text{在 }L^\\infty(0,T;H)\\text{ 中}.\n\\label{eq:ch3-semidiscrete-uk-weak-limits}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p237-007-1ee09e8a97a80d6e", "chapter": 3, "source_pdf_page": 237, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 451, "display_type": "numbered-equation", "source_number": "4.43", "label": "eq:ch3-semidiscrete-wk-weak-limits", "latex": "\\begin{equation}\nw_{k'}\\rightharpoonup u_*\\quad\\text{在 }L^2(0,T;V)\\text{ 中},\n\\qquad\nw_{k'}\\overset{*}{\\rightharpoonup}u_*quad\\text{在 }L^\\infty(0,T;H)\\text{ 中},\n\\label{eq:ch3-semidiscrete-wk-weak-limits}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p237-008-a23fb4265b5f2b24", "chapter": 3, "source_pdf_page": 237, "tex_file": "tex/chapters/chapter-03/section-04.tex", "tex_line": 457, "display_type": "numbered-equation", "source_number": "4.44", "label": "eq:ch3-semidiscrete-wk-derivative-limit", "latex": "\\begin{equation}\n\\frac{dw_{k'}}{dt}\\rightharpoonup u_*'\n\\quad\\text{在 }L^2(0,T;V_s')\\text{ 中}.\n\\label{eq:ch3-semidiscrete-wk-derivative-limit}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
