{"id": "formula-appendix-02-p336-001-6ac4448a25e4e3a2", "chapter": "appendix-02", "source_pdf_page": 336, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 31, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nC_1:x^2+y^2-25=0,\n\\qquad\nC_2:(x-1)^2+y^2-4=0\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p336-002-a20da3108cdad1a3", "chapter": "appendix-02", "source_pdf_page": 336, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 44, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nX(\\cdot),\\quad Y(\\cdot),\n\\qquad X(i),Y(i):\\text{第 }i\\text{ 个顶点的坐标},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p336-003-dbef835ed4d5986d", "chapter": "appendix-02", "source_pdf_page": 336, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 48, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nNu(\\cdot,\\cdot),\n\\qquad Nu(1,j),Nu(2,j),Nu(3,j):\\text{第 }j\\text{ 个三角形的顶点编号}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p337-001-067d5d34743fbb64", "chapter": "appendix-02", "source_pdf_page": 337, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 70, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n2C+C_B=3M,\n\\qquad C_B=N_1-N,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p337-002-642518199cfdc0e9", "chapter": "appendix-02", "source_pdf_page": 337, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 75, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nM'=k^2M,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p337-003-db5b85b9f42e7a0d", "chapter": "appendix-02", "source_pdf_page": 337, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 78, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nN'=\\frac{(k-1)(k-2)}2M\n+\\frac{(k-1)(3M+N-N_1)}2+N,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p337-004-a2a63070ff51dacd", "chapter": "appendix-02", "source_pdf_page": 337, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 82, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nN_1'=N'+k(N_1-N).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p338-001-5bb2fb213be2098a", "chapter": "appendix-02", "source_pdf_page": 338, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 88, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nM^n=k^{2n}M^0,\n\\qquad C_B^n=k^nC_B^0,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p338-002-9d00cdc217333a90", "chapter": "appendix-02", "source_pdf_page": 338, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 92, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nM^n=2N^n+C_B^n+2(T-1),\n\\qquad\nM^0=2N^0+C_B^0+2(T-1),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p338-003-9415d995f599dd7d", "chapter": "appendix-02", "source_pdf_page": 338, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 98, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nN^n=\\frac12\\bigl((k^{2n}-1)M^0-(k^n-1)C_B^0\\bigr)+N^0,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p338-004-e5b62d8e0b5c4324", "chapter": "appendix-02", "source_pdf_page": 338, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 101, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nN_1^n=\\frac12\\bigl((k^{2n}-1)M^0+(k^n+1)C_B^0\\bigr)+N_1^0,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p338-005-9c8cf9baf7b9192c", "chapter": "appendix-02", "source_pdf_page": 338, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 104, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nM^n=k^{2n}M^0,\n\\qquad C_B^0=N_1^0-N^0\n\\qquad(M^0=M,\\ldots).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p341-001-592afc00d7e6d949", "chapter": "appendix-02", "source_pdf_page": 341, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 171, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nX_m(\\cdot),\\quad Y_m(\\cdot),\n\\qquad X_m(i),Y_m(i):\\text{第 }i\\text{ 个结点的坐标}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p341-002-6f1cd78f8c2bfc6a", "chapter": "appendix-02", "source_pdf_page": 341, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 176, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nNu_m(\\cdot,\\cdot),\n\\qquad Nu_m(1,j),Nu_m(2,j),Nu_m(3,j):\\text{第 }j\\text{ 个三角形的结点编号}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p342-001-846a2f8c3d5befb4", "chapter": "appendix-02", "source_pdf_page": 342, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 190, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nTABV(\\cdot,\\cdot),\n\\qquad TABV(1,i),TABV(2,i),TABV(3,i),TABV(4,i),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p342-002-4f1c63b8cba1d014", "chapter": "appendix-02", "source_pdf_page": 342, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 200, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nM=\\gamma(\\widehat M)\n=\n\\begin{pmatrix}G(1,1)&G(2,1)\\\\G(1,2)&G(2,2)\\end{pmatrix}\\widehat M\n+\\begin{pmatrix}G(3,1)\\\\G(3,2)\\end{pmatrix}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p343-001-5411b44b7c3dc89e", "chapter": "appendix-02", "source_pdf_page": 343, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 215, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n\\begin{pmatrix}G(1,1)&G(2,1)\\\\G(1,2)&G(2,2)\\end{pmatrix}\n&=\n\\begin{pmatrix}(M_1-M_3)_1&(M_2-M_3)_1\\\\(M_1-M_3)_2&(M_2-M_3)_2\\end{pmatrix}\n\\begin{pmatrix}(\\widehat M_1-\\widehat M_3)_1&(\\widehat M_2-\\widehat M_3)_1\\\\(\\widehat M_1-\\widehat M_3)_2&(\\widehat M_2-\\widehat M_3)_2\\end{pmatrix}^{-1}\\\\\n&=\n\\begin{pmatrix}(M_1-M_3)_1&(M_2-M_3)_1\\\\(M_1-M_3)_2&(M_2-M_3)_2\\end{pmatrix}\\widehat C,\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p343-002-268725321e499abd", "chapter": "appendix-02", "source_pdf_page": 343, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 226, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{pmatrix}G(3,1)\\\\G(3,2)\\end{pmatrix}\n=M_1-\n\\begin{pmatrix}G(1,1)&G(2,1)\\\\G(1,2)&G(2,2)\\end{pmatrix}\\widehat M_1.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p343-003-8c2701474ca8735a", "chapter": "appendix-02", "source_pdf_page": 343, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 232, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\widehat M=\\gamma^{-1}(M)\n=\n\\begin{pmatrix}G1(1,1)&G1(2,1)\\\\G1(1,2)&G1(2,2)\\end{pmatrix}M\n+\\begin{pmatrix}G1(3,1)\\\\G1(3,2)\\end{pmatrix}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p343-004-08ce9a826f97a755", "chapter": "appendix-02", "source_pdf_page": 343, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 240, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nv_1=\\lambda_1+\\lambda_2-\\lambda_3,\n\\quad\nv_2=\\lambda_2+\\lambda_3-\\lambda_1,\n\\quad\nv_3=\\lambda_3+\\lambda_1-\\lambda_2.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p343-005-dd7b61ba785387e9", "chapter": "appendix-02", "source_pdf_page": 343, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 248, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lambda_1(M)=\\widehat x_2(\\widehat M),\n\\quad\n\\lambda_2(M)=1-\\widehat x_1(\\widehat M)-\\widehat x_2(\\widehat M),\n\\quad\n\\lambda_3(M)=\\widehat x_2(\\widehat M),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p343-006-c65847db16940e7f", "chapter": "appendix-02", "source_pdf_page": 343, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 256, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\int_{\\widehat T}\\widehat x_1^{i_1}\\widehat x_2^{i_2}\\,d\\widehat x_1d\\widehat x_2\n=\\frac{i_1!i_2!}{(i_1+i_2+2)!}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p343-007-b95a1b8320faa582", "chapter": "appendix-02", "source_pdf_page": 343, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 261, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\operatorname{area}T=\\frac12\\det G,\n\\qquad\n\\int_Tv_1\\,dM=\\frac13\\operatorname{area}(T),\n\\qquad\n\\int_Tv_iv_j\\,dM=\\frac13\\delta_{ij}\\operatorname{area}(T).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p343-008-26de96ed9cef0f78", "chapter": "appendix-02", "source_pdf_page": 343, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 269, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\frac{\\partial\\lambda_i}{\\partial x_j}\n=\\sum_{k=1,2}\\frac{\\partial\\widehat x_k}{\\partial x_j}\n\\frac{\\partial(\\lambda_i\\circ\\gamma)}{\\partial\\widehat x_k}\n=\\sum_{k=1,2}G1(j,k)\n\\frac{\\partial(\\lambda_i\\circ\\gamma)}{\\partial\\widehat x_k}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p344-001-301f1e721763d1fc", "chapter": "appendix-02", "source_pdf_page": 344, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 279, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\frac{\\partial\\lambda_2}{\\partial x_j}=G1(j,2),\n\\qquad\n\\frac{\\partial\\lambda_2}{\\partial x_j}=-G1(j,1)-G1(j,2),\n\\qquad\n\\frac{\\partial\\lambda_3}{\\partial x_j}=G1(j,1),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p344-002-a9babc8de53a8e2a", "chapter": "appendix-02", "source_pdf_page": 344, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 287, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\frac{\\partial v_1}{\\partial x_j}=-2G1(j,1),\n\\qquad\n\\frac{\\partial v_2}{\\partial x_j}=-2G1(j,2),\n\\qquad\n\\frac{\\partial v_3}{\\partial x_j}=2G1(j,1)+2G1(j,2).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p344-003-a87697193550667b", "chapter": "appendix-02", "source_pdf_page": 344, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 296, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\int_Tf(M)v_i(M)\\,dM\n\\simeq\\frac{\\operatorname{area}(T)}3f(P_i),\n\\qquad i=1,2,3.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p344-004-502518c34420127a", "chapter": "appendix-02", "source_pdf_page": 344, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 317, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\{(w_i,0),(0,w_i):i=1,\\ldots,N_m\\},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p344-005-820801e21dc9ff24", "chapter": "appendix-02", "source_pdf_page": 344, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 321, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nu_h=\n\\begin{pmatrix}\\displaystyle\\sum_{i=1}^{N_m}X_iw_i\\\\[2mm]\n\\displaystyle\\sum_{i=1}^{N_m}Y_iw_i\\end{pmatrix},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p344-006-16aeadba0ce9ae5c", "chapter": "appendix-02", "source_pdf_page": 344, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 327, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\nu\\sum_{j=1}^{N_m}X_j\\alpha_{jk}\n=\\int_\\Omega f_xw_k\\,dM\n+\\sum_T\\pi_h(T)\\operatorname{area}(T)\\frac{\\partial w_k}{\\partial x}(T),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p344-007-d341a3df6f3ab621", "chapter": "appendix-02", "source_pdf_page": 344, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 332, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\nu\\sum_{j=1}^{N_m}Y_j\\alpha_{jk}\n=\\int_\\Omega f_yw_k\\,dM\n+\\sum_T\\pi_h(T)\\operatorname{area}(T)\\frac{\\partial w_k}{\\partial y}(T),\n\\qquad 1\\leq k\\leq N_m,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p344-008-a7fb657025751073", "chapter": "appendix-02", "source_pdf_page": 344, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 339, "display_type": "numbered-equation", "source_number": "4.1", "label": "eq:app2-stiffness-coefficients", "latex": "\\begin{equation}\n\\alpha_{jk}=\\sum_{T(j,k)}\\operatorname{area}(T)\\nabla w_j(T)\\cdot\\nabla w_k(T)\n\\label{eq:app2-stiffness-coefficients}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p344-009-e6e46ea469865a6a", "chapter": "appendix-02", "source_pdf_page": 344, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 346, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n-\\sum_{j>N_m}X_j\\alpha_{jk},\n\\qquad\n-\\sum_{j>N}Y_j\\alpha_{jk}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p345-001-37fedfb4abea18ec", "chapter": "appendix-02", "source_pdf_page": 345, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 359, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\pi_h^0=\\{\\pi_h^0(T):T\\in\\mathcal T_h\\}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p345-002-f6e022c91cfb155e", "chapter": "appendix-02", "source_pdf_page": 345, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 363, "display_type": "numbered-equation", "source_number": "4.2", "label": "eq:app2-uzawa-velocity-expansion", "latex": "\\begin{equation}\nu_h^{n+1}=\n\\begin{pmatrix}\\displaystyle\\sum X_i^{n+1}w_i\\\\[1mm]\n\\displaystyle\\sum Y_i^{n+1}w_i\\end{pmatrix},\n\\label{eq:app2-uzawa-velocity-expansion}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p345-003-4e8ee037562e0454", "chapter": "appendix-02", "source_pdf_page": 345, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 370, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\nu\\sum_{j=1}^{N_m}X_j^{n+1}\\alpha_{jk}\n=\\int_\\Omega f_xw_k\\,dM\n-\\nu\\sum_{j>N_m}X_j\\alpha_{jk}\n+\\sum_T\\pi_h^n(T)\\operatorname{area}(T)\\frac{\\partial w_k}{\\partial x}(T),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p345-004-0f0c2f19ca676a8f", "chapter": "appendix-02", "source_pdf_page": 345, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 376, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\nu\\sum_{j=1}^{N_m}Y_j^{n+1}\\alpha_{jk}\n=\\int_\\Omega f_yw_k\\,dM\n-\\nu\\sum_{j>N_m}Y_j\\alpha_{jk}\n+\\sum_T\\pi_h^n(T)\\operatorname{area}(T)\\frac{\\partial w_k}{\\partial y}(T).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p345-005-d8f1a77f0030998c", "chapter": "appendix-02", "source_pdf_page": 345, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 383, "display_type": "numbered-equation", "source_number": "4.3", "label": "eq:app2-uzawa-pressure-update", "latex": "\\begin{equation}\n\\pi_h^{n+1}(T)=\\pi_h^n(T)-\\rho\\operatorname{div}(u_h^{n+1})(T),\n\\qquad\\forall T.\n\\label{eq:app2-uzawa-pressure-update}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p345-006-ecd4cd5c770026df", "chapter": "appendix-02", "source_pdf_page": 345, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 390, "display_type": "numbered-equation", "source_number": "4.4", "label": "eq:app2-linear-system", "latex": "\\begin{equation}\n\\sum_{j=1}^{N_m}Z_j\\alpha_{jk}=f_k,\n\\qquad k=1,\\ldots,N_m,\n\\label{eq:app2-linear-system}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p345-007-8752e279f23a69ab", "chapter": "appendix-02", "source_pdf_page": 345, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 399, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nZ_k^{n+1}=(1-\\omega)Z_k^n\n-\\frac{\\omega}{\\alpha_{kk}}\n\\left(\\sum_{j=1}^{k-1}\\alpha_{jk}Z_j^{n+1}\n+\\sum_{j=k+1}^{N_m}\\alpha_{jk}Z_j^n-\\frac1\\nu f_k\\right).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p345-008-c92feeac061917af", "chapter": "appendix-02", "source_pdf_page": 345, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 406, "display_type": "numbered-equation", "source_number": "4.5", "label": "eq:app2-sor-stopping-test", "latex": "\\begin{equation}\n\\max_k|Z_k^{n+1}-Z_k^n|<\\epsilon_{\\mathrm{rel}}.\n\\label{eq:app2-sor-stopping-test}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p345-009-c83a181aa140330d", "chapter": "appendix-02", "source_pdf_page": 345, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 412, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\sum_jZ_j\\alpha_{jk}=0\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p345-010-a9755d2ee49a6cab", "chapter": "appendix-02", "source_pdf_page": 345, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 416, "display_type": "numbered-equation", "source_number": "4.6", "label": "eq:app2-gauss-seidel-iteration", "latex": "\\begin{equation}\nZ_k^{n+1}=-\\frac1{\\alpha_{kk}}\n\\left(\\sum_{j=1}^{k-1}\\alpha_{jk}Z_j^{n+1}\n+\\sum_{j=k+1}^{N_m}\\alpha_{jk}Z_j^n\\right).\n\\label{eq:app2-gauss-seidel-iteration}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p346-001-25610b42e613d713", "chapter": "appendix-02", "source_pdf_page": 346, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 425, "display_type": "numbered-equation", "source_number": "4.7", "label": "eq:app2-spectral-bounds", "latex": "\\begin{equation}\n\\rho_p^{n+1}=\\min_k\\frac{Z_k^{n+1}}{Z_k^n},\n\\qquad\n\\rho_g^{n+1}=\\max_k\\frac{Z_k^{n+1}}{Z_k^n},\n\\label{eq:app2-spectral-bounds}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p346-002-a8f7e4a5f2c4478a", "chapter": "appendix-02", "source_pdf_page": 346, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 431, "display_type": "numbered-equation", "source_number": "4.8", "label": "eq:app2-optimal-relaxation-estimates", "latex": "\\begin{equation}\n\\omega_p^{n+1}=\\frac2{1+\\sqrt{1-\\rho_p^{n+1}}},\n\\qquad\n\\omega_g^{n+1}=\\frac2{1+\\sqrt{1-\\rho_g^{n+1}}}.\n\\label{eq:app2-optimal-relaxation-estimates}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p346-003-0361e3557df0ee1a", "chapter": "appendix-02", "source_pdf_page": 346, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 446, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nC_h^{(n)}=\\max_T|\\operatorname{div}(u_h^n)_T|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p346-004-93734232c801f51e", "chapter": "appendix-02", "source_pdf_page": 346, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 452, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\rho_{\\mathrm{opt}}=0.96.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p346-005-94078ab4ac97c908", "chapter": "appendix-02", "source_pdf_page": 346, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 462, "display_type": "numbered-equation", "source_number": "4.9", "label": "eq:app2-augmented-lagrangian-system", "latex": "\\begin{equation}\n\\nu((u_h,v_h))_h\n+\\frac1\\epsilon(\\operatorname{div}_hu_h,\\operatorname{div}_hv_h)\n-(\\pi_h,\\operatorname{div}_hv_h)\n=(f,v_h),\n\\qquad\\forall v_h\\in\\mathbf W_h.\n\\label{eq:app2-augmented-lagrangian-system}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p347-001-8106cf9496f240f4", "chapter": "appendix-02", "source_pdf_page": 347, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 480, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nu_h^{n+1}=\\begin{pmatrix}\\sum X_i^{(n+1)}w_i\\\\ \\sum Y_i^{(n+1)}w_i\\end{pmatrix},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p347-002-ecd8e1374b919929", "chapter": "appendix-02", "source_pdf_page": 347, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 484, "display_type": "numbered-equation", "source_number": "4.10", "label": "eq:app2-augmented-component-system", "latex": "\\begin{equation}\n\\begin{aligned}\n&\\nu\\sum_{j=1}^{N_m}X_j^{n+1}\\alpha_{jk}\n+\\frac1\\epsilon\\sum_{j=1}^{N_{1m}}\n\\{X_j^{n+1}(D_{hx}w_j,D_{hx}w_k)\n+Y_j^{n+1}(D_{hy}w_j,D_{hx}w_k)\\},\\\\\n&\\nu\\sum_{j=1}^{N_m}Y_j^{n+1}\\alpha_{jk}\n+\\frac1\\epsilon\\sum_{j=1}^{N_{1m}}\n\\{X_j^{n+1}(D_{hx}w_j,D_{hy}w_k)\n+Y_j^{n+1}(D_{hy}w_j,D_{hy}w_k)\\}.\n\\end{aligned}\n\\label{eq:app2-augmented-component-system}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p348-001-f63715caf3fb80bf", "chapter": "appendix-02", "source_pdf_page": 348, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 513, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\widetilde{\\mathbf W}_h:\\ H^1(\\Omega)\\text{ 的逼近},\n\\qquad\n\\widetilde W_h:\\ H^1(\\Omega)\\text{ 的逼近},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p348-002-c526950931507b5e", "chapter": "appendix-02", "source_pdf_page": 348, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 518, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\mathbf W_h:\\ H_0^1(\\Omega)\\text{ 的逼近},\n\\qquad\nW_h:\\ H_0^1(\\Omega)\\text{ 的逼近}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p349-001-8c6055ad61a7d1d2", "chapter": "appendix-02", "source_pdf_page": 349, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 527, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nS_k=\\int_{\\Omega_h}v_k^2\\,dM,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p349-002-aa4c8c9a2628b684", "chapter": "appendix-02", "source_pdf_page": 349, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 531, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\int_{\\Omega_h}v_kv_\\ell\\,dM=0,\n\\qquad k\\neq\\ell.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p349-003-2a6ef065caa18130", "chapter": "appendix-02", "source_pdf_page": 349, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 536, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nD_hv=D_{hx}v_x+D_{hy}v_y.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p349-004-5e6c52a0313622bb", "chapter": "appendix-02", "source_pdf_page": 349, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 548, "display_type": "numbered-equation", "source_number": "5.1", "label": "eq:app2-navier-stokes-uzawa-velocity", "latex": "\\begin{equation}\n\\nu((u_h^{m+1},v_h))_h\n+b_h(u_h^{m+1},u_h^{m+1},v_h)\n+\\frac1\\epsilon(D_hu_h^{m+1},D_hv_h)\n=(p_h^m,D_hv_h)+(f,v_h),\n\\quad\\forall v_h\\in\\mathbf W_h.\n\\label{eq:app2-navier-stokes-uzawa-velocity}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p349-005-11364152d41cf56d", "chapter": "appendix-02", "source_pdf_page": 349, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 557, "display_type": "numbered-equation", "source_number": "5.2", "label": "eq:app2-navier-stokes-uzawa-pressure", "latex": "\\begin{equation}\np_h^{m+1}=p_h^m-\\rho D_hu_h^{m+1}.\n\\label{eq:app2-navier-stokes-uzawa-pressure}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p349-006-c12b4b16c7e17844", "chapter": "appendix-02", "source_pdf_page": 349, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 566, "display_type": "numbered-equation", "source_number": "5.3", "label": "eq:app2-arrow-hurwicz-velocity", "latex": "\\begin{equation}\n\\begin{aligned}\n&((u_h^{m+1}-u_h^m,v_h))_h\n+\\rho\\left[\n\\nu((u_h^m,v_h))_h\n+\\frac1\\epsilon(D_hu_h^{m+1},D_hv_h)\n+b_h(u_h^m,u_h^{m+1},v_h)\\right.\\\\\n&\\hspace{42mm}\\left.\n-(p_h^m,D_hv_h)-(f,v_h)\n\\right]=0,\n\\qquad\\forall v_h\\in\\mathbf W_h.\n\\end{aligned}\n\\label{eq:app2-arrow-hurwicz-velocity}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-02-p349-007-e0d2a089ae2e6a3b", "chapter": "appendix-02", "source_pdf_page": 349, "tex_file": "tex/chapters/appendix-02.tex", "tex_line": 581, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\alpha(p_h^{m+1}-p_h^m)+\\rho D_hu_h^{m+1}=0\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
