{"id": "formula-chapter-03-p199-007-207cd5e221800d3d", "chapter": 3, "source_pdf_page": 199, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 151, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lVert v_\\mu\\rVert_{L^{\\alpha_0}(0,T;X)}\n\\leq \\eta\\lVert v_\\mu\\rVert_{L^{\\alpha_0}(0,T;X_0)}\n+c_\\eta\\lVert v_\\mu\\rVert_{L^{\\alpha_0}(0,T;X_1)},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p199-008-88f22fc58e72fef9", "chapter": 3, "source_pdf_page": 199, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 157, "display_type": "numbered-equation", "source_number": "2.16", "label": "eq:ch3-compactness-banach-interpolation-bound", "latex": "\\begin{equation}\n\\lVert v_\\mu\\rVert_{L^{\\alpha_0}(0,T;X)}\n\\leq c\\eta+c_\\eta\\lVert v_\\mu\\rVert_{L^{\\alpha_0}(0,T;X_1)}.\n\\label{eq:ch3-compactness-banach-interpolation-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p199-009-b4bd1a3909d6d98a", "chapter": 3, "source_pdf_page": 199, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 163, "display_type": "numbered-equation", "source_number": "2.17", "label": "eq:ch3-compactness-banach-limsup", "latex": "\\begin{equation}\n\\lim_{\\mu\\to\\infty}\\lVert v_\\mu\\rVert_{L^{\\alpha_0}(0,T;X)}\\leq c\\eta.\n\\label{eq:ch3-compactness-banach-limsup}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p199-010-16cbcd5b7b911d1e", "chapter": 3, "source_pdf_page": 199, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 170, "display_type": "numbered-equation", "source_number": "2.18", "label": "eq:ch3-compactness-y-continuous-injection", "latex": "\\begin{equation}\nY\\subset C([0,T];X_1),\n\\label{eq:ch3-compactness-y-continuous-injection}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p199-011-7b6956a72e2607b9", "chapter": 3, "source_pdf_page": 199, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 177, "display_type": "numbered-equation", "source_number": "2.19", "label": "eq:ch3-compactness-banach-pointwise-bound", "latex": "\\begin{equation}\n\\lVert v_\\mu(t)\\rVert_{X_1}\\leq c,\n\\qquad\\forall t\\in[0,T],\\quad\\forall\\mu.\n\\label{eq:ch3-compactness-banach-pointwise-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p199-012-907dd7110509260f", "chapter": 3, "source_pdf_page": 199, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 183, "display_type": "numbered-equation", "source_number": "2.20", "label": "eq:ch3-compactness-banach-pointwise-convergence", "latex": "\\begin{equation}\nv_\\mu(t)\\longrightarrow0\\quad\\text{在 }X_1\\text{ 中强收敛},\n\\qquad\\mu\\to\\infty,\n\\label{eq:ch3-compactness-banach-pointwise-convergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p200-001-dc1bba0eb03a3f44", "chapter": 3, "source_pdf_page": 200, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 192, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nv_\\mu(0)=v_\\mu(t)-\\int_0^t v_\\mu'(\\tau)\\,d\\tau,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p200-002-bd22f85fc246dca6", "chapter": 3, "source_pdf_page": 200, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 196, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nv_\\mu(0)=\\frac1s\\left\\{\\int_0^s v_\\mu(t)\\,dt\n-\\int_0^s\\int_0^t v_\\mu'(\\tau)\\,d\\tau\\,dt\\right\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p200-003-8aa310c05efd2f1f", "chapter": 3, "source_pdf_page": 200, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 201, "display_type": "numbered-equation", "source_number": "2.21", "label": "eq:ch3-compactness-banach-decomposition", "latex": "\\begin{equation}\nv_\\mu(0)=a_\\mu+b_\\mu,\n\\label{eq:ch3-compactness-banach-decomposition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
