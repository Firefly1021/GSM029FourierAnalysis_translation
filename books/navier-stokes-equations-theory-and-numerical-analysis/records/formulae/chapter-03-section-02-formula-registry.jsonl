{"id": "formula-chapter-03-p200-009-0172e9544a4bb9c4", "chapter": 3, "source_pdf_page": 200, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 240, "display_type": "numbered-equation", "source_number": "2.25", "label": "eq:ch3-compactness-fourier-transform", "latex": "\\begin{equation}\n\\widehat v(\\tau)=\\int_{-\\infty}^{+\\infty}e^{-2i\\pi t\\tau}v(t)\\,dt.\n\\label{eq:ch3-compactness-fourier-transform}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p200-010-40b7dc4d0e689e0d", "chapter": 3, "source_pdf_page": 200, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 245, "display_type": "numbered-equation", "source_number": "2.26", "label": "eq:ch3-compactness-fractional-derivative", "latex": "\\begin{equation}\n\\widehat{D_t^\\gamma v}(\\tau)=(2\\pi\\tau)^\\gamma\\widehat v(\\tau).\n\\label{eq:ch3-compactness-fractional-derivative}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p200-011-54e826730d6a2256", "chapter": 3, "source_pdf_page": 200, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 251, "display_type": "numbered-equation", "source_number": "2.27", "label": "eq:ch3-compactness-fractional-space", "latex": "\\begin{equation}\n\\mathcal H^\\gamma(\\mathbb R;X_0,X_1)\n=\\{v\\in L^2(\\mathbb R;X_0),\\ D_t^\\gamma v\\in L^2(\\mathbb R;X_1)\\}.\n\\label{eq:ch3-compactness-fractional-space}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p200-012-1d9c8f28645d3483", "chapter": 3, "source_pdf_page": 200, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 258, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lVert v\\rVert_{\\mathcal H^\\gamma(\\mathbb R;X_0,X_1)}\n=\\left\\{\\lVert v\\rVert_{L^2(\\mathbb R;X_0)}^2\n+\\lVert |\\tau|^\\gamma\\widehat v\\rVert_{L^2(\\mathbb R;X_1)}^2\\right\\}^{1/2}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p201-001-54b67debe0d2273c", "chapter": 3, "source_pdf_page": 201, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 266, "display_type": "numbered-equation", "source_number": "2.28", "label": "eq:ch3-compactness-supported-fractional-space", "latex": "\\begin{equation}\n\\mathcal H_K^\\gamma(\\mathbb R;X_0,X_1)\n=\\{u\\in\\mathcal H^\\gamma(\\mathbb R;X_0,X_1),\\ \\operatorname{supp}u\\subset K\\}.\n\\label{eq:ch3-compactness-supported-fractional-space}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p201-002-cf7ed2469a68ae3f", "chapter": 3, "source_pdf_page": 201, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 283, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nv_\\mu=u_\\mu-u,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p201-003-4083d69a5b67833a", "chapter": 3, "source_pdf_page": 201, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 287, "display_type": "numbered-equation", "source_number": "2.29", "label": "eq:ch3-compactness-fractional-x0-weak", "latex": "\\begin{equation}\nv_\\mu\\longrightarrow0\\quad\\text{在 }L^2(\\mathbb R;X_0)\\text{ 中弱收敛},\n\\label{eq:ch3-compactness-fractional-x0-weak}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p201-004-45aa3832a55efd34", "chapter": 3, "source_pdf_page": 201, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 291, "display_type": "numbered-equation", "source_number": "2.30", "label": "eq:ch3-compactness-fractional-derivative-weak", "latex": "\\begin{equation}\n|\\tau|^\\gamma\\widehat v_\\mu\n\\longrightarrow0\\quad\\text{在 }L^2(\\mathbb R;X_1)\\text{ 中弱收敛}.\n\\label{eq:ch3-compactness-fractional-derivative-weak}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p201-005-f117f6c6518b013e", "chapter": 3, "source_pdf_page": 201, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 297, "display_type": "numbered-equation", "source_number": "2.31", "label": "eq:ch3-compactness-fractional-x-strong-goal", "latex": "\\begin{equation}\nv_\\mu\\longrightarrow0\\quad\\text{在 }L^2(\\mathbb R;X)\\text{ 中强收敛}.\n\\label{eq:ch3-compactness-fractional-x-strong-goal}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p201-006-86644fc2b2d6b1a8", "chapter": 3, "source_pdf_page": 201, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 303, "display_type": "numbered-equation", "source_number": "2.32", "label": "eq:ch3-compactness-fractional-x1-strong-goal", "latex": "\\begin{equation}\nv_\\mu\\longrightarrow0\\quad\\text{在 }L^2(\\mathbb R;X_1)\\text{ 中强收敛},\n\\label{eq:ch3-compactness-fractional-x1-strong-goal}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p201-007-97217ba1c1548108", "chapter": 3, "source_pdf_page": 201, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 308, "display_type": "numbered-equation", "source_number": "2.33", "label": "eq:ch3-compactness-fractional-interpolation", "latex": "\\begin{equation}\n\\lVert v_\\mu\\rVert_{L^2(\\mathbb R;X)}\n\\leq\\eta\\lVert v_\\mu\\rVert_{L^2(\\mathbb R;X_0)}\n+c_\\eta\\lVert v_\\mu\\rVert_{L^2(\\mathbb R;X_1)},\n\\label{eq:ch3-compactness-fractional-interpolation}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p201-008-88f5352c5e2ad1cb", "chapter": 3, "source_pdf_page": 201, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 315, "display_type": "numbered-equation", "source_number": "2.34", "label": "eq:ch3-compactness-fractional-interpolation-bound", "latex": "\\begin{equation}\n\\lVert v_\\mu\\rVert_{L^2(\\mathbb R;X)}\n\\leq c\\eta+c_\\eta\\lVert v_\\mu\\rVert_{L^2(\\mathbb R;X_1)}.\n\\label{eq:ch3-compactness-fractional-interpolation-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p201-009-cda4743ffa5bcac2", "chapter": 3, "source_pdf_page": 201, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 321, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lim_{\\mu\\to\\infty}\\lVert v_\\mu\\rVert_{L^2(\\mathbb R;X)}\\leq c\\eta.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p201-010-25e07fd11404225c", "chapter": 3, "source_pdf_page": 201, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 327, "display_type": "numbered-equation", "source_number": "2.35", "label": "eq:ch3-compactness-parseval-integral", "latex": "\\begin{equation}\nI_\\mu=\\int_{-\\infty}^{+\\infty}\\lVert v_\\mu(t)\\rVert_{X_1}^2\\,dt\n=\\int_{-\\infty}^{+\\infty}\\lVert\\widehat v_\\mu(\\tau)\\rVert_{X_1}^2\\,d\\tau,\n\\label{eq:ch3-compactness-parseval-integral}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p201-011-c54ca0e03ca7cb3d", "chapter": 3, "source_pdf_page": 201, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 333, "display_type": "numbered-equation", "source_number": "2.36", "label": "eq:ch3-compactness-parseval-goal", "latex": "\\begin{equation}\nI_\\mu\\longrightarrow0,\n\\qquad\\mu\\to\\infty.\n\\label{eq:ch3-compactness-parseval-goal}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p202-001-7d382a6aea241301", "chapter": 3, "source_pdf_page": 202, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 341, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\nI_\\mu\n&=\\int_{|\\tau|\\leq M}\\lVert\\widehat v_\\mu(\\tau)\\rVert_{X_1}^2\\,d\\tau\\\\\n&\\quad+\\int_{|\\tau|>M}(1+|\\tau|^{2\\gamma})\n\\lVert\\widehat v_\\mu(\\tau)\\rVert_{X_1}^2\n\\frac{d\\tau}{1+|\\tau|^{2\\gamma}}\\\\\n&\\leq\\frac{c}{1+M^{2\\gamma}}\n+\\int_{|\\tau|\\leq M}\\lVert\\widehat v_\\mu(\\tau)\\rVert_{X_1}^2\\,d\\tau,\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p202-002-9b00919c76a83290", "chapter": 3, "source_pdf_page": 202, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 355, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\frac{c}{1+M^{2\\gamma}}\\leq\\frac\\epsilon2.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p202-003-7be8bd68aae2f2c3", "chapter": 3, "source_pdf_page": 202, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 359, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nI_\\mu\\leq\\int_{|\\tau|\\leq M}\\lVert\\widehat v_\\mu(\\tau)\\rVert_{X_1}^2\\,d\\tau\n+\\frac\\epsilon2,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p202-004-9fe4328bdca82da2", "chapter": 3, "source_pdf_page": 202, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 364, "display_type": "numbered-equation", "source_number": "2.37", "label": "eq:ch3-compactness-low-frequency-goal", "latex": "\\begin{equation}\nJ_\\mu=\\int_{|\\tau|\\leq M}\\lVert\\widehat v_\\mu(\\tau)\\rVert_{X_1}^2\\,d\\tau\n\\longrightarrow0,\n\\qquad\\mu\\to\\infty,\n\\label{eq:ch3-compactness-low-frequency-goal}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p202-005-38264aeaffc705a7", "chapter": 3, "source_pdf_page": 202, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 373, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\widehat v_\\mu(\\tau)\n=\\int_{-\\infty}^{+\\infty}e^{-2i\\pi t\\tau}\\chi(t)v_\\mu(t)\\,dt.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p202-006-084f813f69a2333e", "chapter": 3, "source_pdf_page": 202, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 378, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lVert\\widehat v_\\mu(\\tau)\\rVert_{X_1}\n\\leq\\lVert v_\\mu\\rVert_{L^2(\\mathbb R;X_1)}\n\\lVert e^{-2i\\pi t\\tau}\\chi\\rVert_{L^2(\\mathbb R)},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p202-007-b431b62ede8c711d", "chapter": 3, "source_pdf_page": 202, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 383, "display_type": "numbered-equation", "source_number": "2.38", "label": "eq:ch3-compactness-fourier-pointwise-bound", "latex": "\\begin{equation}\n\\lVert\\widehat v_\\mu(\\tau)\\rVert_{X_1}\\leq\\mathrm{const}.\n\\label{eq:ch3-compactness-fourier-pointwise-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p202-008-121004dcccfff7a6", "chapter": 3, "source_pdf_page": 202, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 388, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n((\\widehat v_\\mu(\\tau),\\sigma))_{X_0}\n=\\int_{-\\infty}^{+\\infty}\n((v_\\mu(t),e^{-2i\\pi t\\tau}\\chi(t)\\sigma))_{X_0}\\,dt,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p203-001-5dc8133ea0b45636", "chapter": 3, "source_pdf_page": 203, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 413, "display_type": "numbered-equation", "source_number": "2.39", "label": "eq:ch3-compactness-zero-extension-derivative", "latex": "\\begin{equation}\n\\frac d{dt}\\widetilde u_m\n=\\widetilde g_m+u_m(0)\\delta_0-u_m(T)\\delta_T,\n\\label{eq:ch3-compactness-zero-extension-derivative}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p203-002-84727205464af320", "chapter": 3, "source_pdf_page": 203, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 419, "display_type": "numbered-equation", "source_number": "2.40", "label": "eq:ch3-compactness-extension-derivative-definition", "latex": "\\begin{equation}\ng_m=u_m'=u_m\\text{ 在 }[0,T]\\text{ 上的导数}.\n\\label{eq:ch3-compactness-extension-derivative-definition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p203-003-9a6a140568e98e60", "chapter": 3, "source_pdf_page": 203, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 424, "display_type": "numbered-equation", "source_number": "2.41", "label": "eq:ch3-compactness-extension-fourier-identity", "latex": "\\begin{equation}\n2i\\pi\\tau\\widehat u_m(\\tau)\n=\\widehat g_m(\\tau)+u_m(0)-u_m(T)\\exp(-2i\\pi\\tau T),\n\\label{eq:ch3-compactness-extension-fourier-identity}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p203-004-475ded550e51caac", "chapter": 3, "source_pdf_page": 203, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 432, "display_type": "numbered-equation", "source_number": "2.42", "label": "eq:ch3-compactness-extension-g-fourier-bound", "latex": "\\begin{equation}\n\\lVert\\widehat g_m(\\tau)\\rVert_{X_1}\\leq\\mathrm{const},\n\\qquad\\forall m,\\quad\\forall\\tau\\in\\mathbb R.\n\\label{eq:ch3-compactness-extension-g-fourier-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p203-005-6689618c16d34953", "chapter": 3, "source_pdf_page": 203, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 438, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lVert u_m(0)\\rVert_{X_1}\\leq\\mathrm{const},\n\\qquad\n\\lVert u_m(T)\\rVert_{X_1}\\leq\\mathrm{const},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p203-006-47b8fb6a124dde2c", "chapter": 3, "source_pdf_page": 203, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 444, "display_type": "numbered-equation", "source_number": "2.43", "label": "eq:ch3-compactness-extension-fourier-decay", "latex": "\\begin{equation}\n|\\tau|^2\\lVert\\widehat u_m(\\tau)\\rVert_{X_1}^2\\leq c,\n\\qquad\\forall m,\\quad\\forall\\tau\\in\\mathbb R.\n\\label{eq:ch3-compactness-extension-fourier-decay}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p203-007-5ef49dfe9e235278", "chapter": 3, "source_pdf_page": 203, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 450, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n|\\tau|^{2\\gamma}\\leq c_0(\\gamma)\n\\frac{1+\\tau^2}{1+|\\tau|^{2(1-\\gamma)}},\n\\qquad\\forall\\tau\\in\\mathbb R.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p203-008-0b3a4710724193bf", "chapter": 3, "source_pdf_page": 203, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 456, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n\\int_{-\\infty}^{+\\infty}|\\tau|^{2\\gamma}\n\\lVert\\widehat u_m(\\tau)\\rVert_{X_1}^2\\,d\\tau\n&\\leq c_0(\\gamma)\\int_{-\\infty}^{+\\infty}\n\\frac{1+\\tau^2}{1+|\\tau|^{2(1-\\gamma)}}\n\\lVert\\widehat u_m(\\tau)\\rVert_{X_1}^2\\,d\\tau\\\\\n&\\leq c_1\\int_{-\\infty}^{+\\infty}\n\\frac{d\\tau}{1+|\\tau|^{2(1-\\gamma)}}\n+c_0(\\gamma)\\int_{-\\infty}^{+\\infty}\n\\lVert\\widehat u_m(\\tau)\\rVert_{X_1}^2\\,d\\tau.\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p203-009-69efbe344752dbde", "chapter": 3, "source_pdf_page": 203, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 470, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\int_{-\\infty}^{+\\infty}\\frac{d\\tau}{1+|\\tau|^{2(\\gamma-1)}}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p203-010-f3a732e0af2e2ac3", "chapter": 3, "source_pdf_page": 203, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 474, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\int_{-\\infty}^{+\\infty}\\lVert\\widehat u_m(\\tau)\\rVert_{X_1}^2\\,d\\tau\n=\\int_0^T\\lVert u_m(t)\\rVert_{X_1}^2\\,dt,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p203-011-1f03d44a59d780a5", "chapter": 3, "source_pdf_page": 203, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 481, "display_type": "numbered-equation", "source_number": "2.44", "label": "eq:ch3-compactness-extension-fractional-bound", "latex": "\\begin{equation}\n\\int_{-\\infty}^{+\\infty}|\\tau|^{2\\gamma}\n\\lVert\\widehat u_m(\\tau)\\rVert_{X_1}^2\\,d\\tau\\leq c_2,\n\\label{eq:ch3-compactness-extension-fractional-bound}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
