{"id": "formula-chapter-03-p198-013-3174eab0b0a2b2a4", "chapter": 3, "source_pdf_page": 198, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 89, "display_type": "numbered-equation", "source_number": "2.9", "label": "eq:ch3-compactness-y-space", "latex": "\\begin{equation}\nY=Y(0,T;\\alpha_0,\\alpha_1;X_0,X_1),\n\\label{eq:ch3-compactness-y-space}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p198-014-561c6524e9f8dc96", "chapter": 3, "source_pdf_page": 198, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 93, "display_type": "numbered-equation", "source_number": "2.10", "label": "eq:ch3-compactness-y-definition", "latex": "\\begin{equation}\nY=\\left\\{v\\in L^{\\alpha_0}(0,T;X_0),\\quad\nv'=\\frac{dv}{dt}\\in L^{\\alpha_1}(0,T;X_1)\\right\\}.\n\\label{eq:ch3-compactness-y-definition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p199-001-3a6dc7d24bb87448", "chapter": 3, "source_pdf_page": 199, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 101, "display_type": "numbered-equation", "source_number": "2.11", "label": "eq:ch3-compactness-y-norm", "latex": "\\begin{equation}\n\\lVert v\\rVert_Y=\\lVert v\\rVert_{L^{\\alpha_0}(0,T;X_0)}\n+\\lVert v'\\rVert_{L^{\\alpha_1}(0,T;X_1)},\n\\label{eq:ch3-compactness-y-norm}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p199-002-7f0f0e4c86e88a73", "chapter": 3, "source_pdf_page": 199, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 107, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nY\\subset L^{\\alpha_0}(0,T;X),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p199-003-103bcda245a9bde2", "chapter": 3, "source_pdf_page": 199, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 122, "display_type": "numbered-equation", "source_number": "2.12", "label": "eq:ch3-compactness-y-weak-convergence", "latex": "\\begin{equation}\nu_\\mu\\longrightarrow u\\quad\\text{在 }Y\\text{ 中弱收敛},\n\\qquad\\mu\\to\\infty,\n\\label{eq:ch3-compactness-y-weak-convergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p199-004-77d553e9ba4241dc", "chapter": 3, "source_pdf_page": 199, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 128, "display_type": "numbered-equation", "source_number": "2.13", "label": "eq:ch3-compactness-component-weak-convergence", "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\nu_\\mu&\\longrightarrow u&&\\text{在 }L^{\\alpha_0}(0,T;X_0)\\text{ 中弱收敛},\\\\\nu_\\mu'&\\longrightarrow u'&&\\text{在 }L^{\\alpha_1}(0,T;X_1)\\text{ 中弱收敛}.\n\\end{aligned}\n\\right.\n\\label{eq:ch3-compactness-component-weak-convergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-03-p199-005-887a0ae9ba34a432", "chapter": 3, "source_pdf_page": 199, "tex_file": "tex/chapters/chapter-03/section-02.tex", "tex_line": 138, "display_type": "numbered-equation", "source_number": "2.14", "label": "eq:ch3-compactness-banach-strong-goal", "latex": "\\begin{equation}\nv_\\mu=u_\\mu-u\\longrightarrow0\n\\quad\\text{在 }L^{\\alpha_0}(0,T;X)\\text{ 中强收敛}.\n\\label{eq:ch3-compactness-banach-strong-goal}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
