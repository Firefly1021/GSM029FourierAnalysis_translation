{"id": "formula-appendix-01-p326-001-dbac031a95b33f79", "chapter": "appendix-01", "source_pdf_page": 326, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 17, "display_type": "numbered-equation", "source_number": "1.1", "label": "eq:app1-domain-regularity", "latex": "\\begin{equation}\n\\begin{minipage}{0.82\\textwidth}\n$\\Omega$ 连通且为 $C^2$ 类(见第 1 章 \\MBUnresolvedReference{equation}{(1.3)}), 其边界 $\\Gamma$ 有有限个连通分支, 记为 $\\Gamma_1,\\ldots,\\Gamma_k$ ($k\\geq1$).\n\\end{minipage}\n\\label{eq:app1-domain-regularity}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p326-002-04932e073dc8146b", "chapter": "appendix-01", "source_pdf_page": 326, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 24, "display_type": "numbered-equation", "source_number": "1.2", "label": "eq:app1-domain-cuts", "latex": "\\begin{equation}\n\\begin{minipage}{0.82\\textwidth}\n以 $\\Sigma_1,\\ldots,\\Sigma_N$ 表示 $N$ 个 $n-1$ 维 $C^2$ 类流形($N\\geq0$), 使 $i\\neq j$ 时 $\\Sigma_i\\cap\\Sigma_j=\\varnothing$, 且开集\n$\\dot\\Omega=\\Omega\\setminus\\Sigma$, $\\Sigma=\\bigcup_{i=1}^N\\Sigma_i$, 单连通并具有 Lipschitz 边界(即各 $\\Sigma_i$ 不与 $\\Gamma$ 相切).\n\\end{minipage}\n\\label{eq:app1-domain-cuts}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p326-003-2dfc106a5b2d4a23", "chapter": "appendix-01", "source_pdf_page": 326, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 32, "display_type": "numbered-equation", "source_number": "1.3", "label": "eq:app1-trace-quotient-norm", "latex": "\\begin{equation}\n\\lVert\\psi\\rVert_{H^{m-1/2}(\\Gamma)}\n=\\inf_{\\gamma_0u=\\psi}\\lVert u\\rVert_{H^m(\\Omega)}.\n\\label{eq:app1-trace-quotient-norm}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p327-001-9443af6c2b839e02", "chapter": "appendix-01", "source_pdf_page": 327, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 48, "display_type": "numbered-equation", "source_number": "1.4", "label": "eq:app1-l2-orthogonal-decomposition", "latex": "\\begin{equation}\nL^2(\\Omega)=H\\oplus H_1\\oplus H_2,\n\\label{eq:app1-l2-orthogonal-decomposition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p327-002-2a3f472b31111b2a", "chapter": "appendix-01", "source_pdf_page": 327, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 58, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\operatorname{curl}u=(-D_2u,D_1u),\n\\quad u:\\Omega\\to\\mathbb R,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p327-003-0586229acb62ed9d", "chapter": "appendix-01", "source_pdf_page": 327, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 62, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\operatorname{curl}u=D_1u_2-D_2u_1,\n\\quad u=\\{u_1,u_2\\}:\\Omega\\to\\mathbb R^2.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p327-004-c80faae58f7ae5f5", "chapter": "appendix-01", "source_pdf_page": 327, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 71, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n[\\theta]_i=\\theta|_{\\Sigma_i^+}-\\theta|_{\\Sigma_i^-}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p327-005-ed682cb3ea3a75df", "chapter": "appendix-01", "source_pdf_page": 327, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 75, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\begin{aligned}\n\\langle\\operatorname{div}u,\\varphi\\rangle\n&=-\\langle\\operatorname{grad}q,\\operatorname{grad}\\varphi\\rangle\n=-\\int_{\\dot\\Omega}\\operatorname{grad}q\\cdot\\operatorname{grad}\\varphi\\,dx\\\\\n&=-\\int_{\\partial\\dot\\Omega}\\varphi\\frac{\\partial q}{\\partial\\nu}\\,d\\Gamma\n=-\\sum_{i=1}^N\\int_{\\Sigma_i}\n\\left[\\frac{\\partial q}{\\partial\\nu_i}\\right]_i\\varphi\\,d\\Sigma=0.\n\\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p328-001-1366484d115bb95e", "chapter": "appendix-01", "source_pdf_page": 328, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 92, "display_type": "numbered-equation", "source_number": "1.5", "label": "eq:app1-kernel-boundary-normal", "latex": "\\begin{equation}\n\\frac{\\partial q}{\\partial\\nu}=0\\quad\\text{在 }\\Gamma\\text{ 上},\n\\label{eq:app1-kernel-boundary-normal}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p328-002-a7de55ca6c19307f", "chapter": "appendix-01", "source_pdf_page": 328, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 96, "display_type": "numbered-equation", "source_number": "1.6", "label": "eq:app1-kernel-jumps", "latex": "\\begin{equation}\n[q]_i=\\text{常数},\n\\qquad i=1,\\ldots,N,\n\\label{eq:app1-kernel-jumps}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p328-003-a448a3f70d75d3d5", "chapter": "appendix-01", "source_pdf_page": 328, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 101, "display_type": "numbered-equation", "source_number": "1.7", "label": "eq:app1-kernel-normal-jumps", "latex": "\\begin{equation}\n\\left[\\frac{\\partial q}{\\partial\\nu_i}\\right]_i=0,\n\\qquad i=1,\\ldots,N.\n\\label{eq:app1-kernel-normal-jumps}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p328-004-fc28e7307c18440f", "chapter": "appendix-01", "source_pdf_page": 328, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 114, "display_type": "numbered-equation", "source_number": "1.8", "label": "eq:app1-normalized-cut-potential", "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&\\Delta q_i=0\\quad\\text{在 }\\dot\\Omega\\text{ 中},\n&&\\frac{\\partial q_i}{\\partial\\nu}=0\\quad\\text{在 }\\Gamma\\text{ 上},\\\\\n&\\left[\\frac{\\partial q_i}{\\partial\\nu_j}\\right]_j=0,\n&&j=1,\\ldots,N,\\\\\n&[q_i]_j=0,\n&&j\\neq i,\\\\\n&[q_i]_i=1.\n\\end{aligned}\n\\right.\n\\label{eq:app1-normalized-cut-potential}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p328-005-4fffc050b7c8b307", "chapter": "appendix-01", "source_pdf_page": 328, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 132, "display_type": "numbered-equation", "source_number": "1.9", "label": "eq:app1-flux-normalized-cut-potential", "latex": "\\begin{equation}\n\\left\\{\n\\begin{aligned}\n&\\Delta q_i'=0\\quad\\text{在 }\\dot\\Omega\\text{ 中},\n&&\\frac{\\partial q_i'}{\\partial\\nu}=0\\quad\\text{在 }\\Gamma\\text{ 上},\\\\\n&\\left[\\frac{\\partial q_i'}{\\partial\\nu_j}\\right]_j=0,\n&&j=1,\\ldots,N,\\\\\n&[q_i']_j=0,\n&&j\\neq i,\\\\\n&[q_i']_i=\\text{未定常数},\n&&\\int_{\\Sigma_i}\\frac{\\partial q_i'}{\\partial\\nu_i}\\,d\\Sigma=1.\n\\end{aligned}\n\\right.\n\\label{eq:app1-flux-normalized-cut-potential}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p328-006-40be449e8fcfe488", "chapter": "appendix-01", "source_pdf_page": 328, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 148, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nX_i=\\{p\\in H^1(\\dot\\Omega):[p]_i=\\text{常数},\n\\ [p]_j=0, j\\neq i\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p328-007-632ed619fbfb4827", "chapter": "appendix-01", "source_pdf_page": 328, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 153, "display_type": "numbered-equation", "source_number": "1.10", "label": "eq:app1-cut-variational-problem", "latex": "\\begin{equation}\n\\int_\\Omega\\operatorname{grad}q_i'\\cdot\\operatorname{grad}p\\,dx\n=[p]_i,\n\\qquad\\forall p\\in X_i.\n\\label{eq:app1-cut-variational-problem}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p329-001-54c9713fa1cce63d", "chapter": "appendix-01", "source_pdf_page": 329, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 165, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\beta_i=\\int_{\\Sigma_i}\\frac{\\partial q_i}{\\partial\\nu_i}\\,d\\Sigma\\neq0,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p329-002-f01ccada8954dd8a", "chapter": "appendix-01", "source_pdf_page": 329, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 179, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\Delta r=0\\text{ 在 }\\dot\\Omega\\text{ 中},\n\\quad\\frac{\\partial r}{\\partial\\nu}=0\\text{ 在 }\\Gamma\\text{ 上},\n\\quad\\left[\\frac{\\partial r}{\\partial\\nu_i}\\right]_i=0,\n\\quad[r]_i=0.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p329-003-ee22a6d9ff0a4d62", "chapter": "appendix-01", "source_pdf_page": 329, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 200, "display_type": "numbered-equation", "source_number": "1.11", "label": "eq:app1-H0-flux-characterization", "latex": "\\begin{equation}\nH_0=\\left\\{v\\in H:\\int_{\\Sigma_i}v\\cdot\\nu\\,d\\Sigma=0,\n\\ i=1,\\ldots,N\\right\\}.\n\\label{eq:app1-H0-flux-characterization}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p329-004-92b098a95c38c968", "chapter": "appendix-01", "source_pdf_page": 329, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 209, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n(v,\\operatorname{grad}q_i)\n=\\int_{\\dot\\Omega}v\\cdot\\operatorname{grad}q_i\\,dx\n=\\int_{\\partial\\dot\\Omega}v\\cdot\\nu q_i\\,d\\Gamma\n=\\int_{\\Sigma_i}v\\cdot\\nu\\,d\\Sigma.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p330-001-316f87c9969fe44b", "chapter": "appendix-01", "source_pdf_page": 330, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 238, "display_type": "numbered-equation", "source_number": "1.12", "label": "eq:app1-full-l2-decomposition", "latex": "\\begin{equation}\nL^2(\\Omega)=H_c\\oplus H_0\\oplus H_1\\oplus H_2,\n\\label{eq:app1-full-l2-decomposition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p330-002-87d31e3cc5d1f7f7", "chapter": "appendix-01", "source_pdf_page": 330, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 242, "display_type": "numbered-equation", "source_number": "1.13", "label": "eq:app1-full-kernel-decomposition", "latex": "\\begin{equation}\n\\operatorname{Ker}(\\operatorname{curl})=H_c\\oplus H_1\\oplus H_2,\n\\label{eq:app1-full-kernel-decomposition}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p330-003-776917e346e5d729", "chapter": "appendix-01", "source_pdf_page": 330, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 253, "display_type": "numbered-equation", "source_number": "1.14", "label": "eq:app1-H2-projection", "latex": "\\begin{equation}\nu_2=P_{H_2}u=\\operatorname{grad}p,\n\\label{eq:app1-H2-projection}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p330-004-bface00c180391ab", "chapter": "appendix-01", "source_pdf_page": 330, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 258, "display_type": "numbered-equation", "source_number": "1.15", "label": "eq:app1-H2-dirichlet-problem", "latex": "\\begin{equation}\n\\Delta p=\\operatorname{div}u\\in H^{-1}(\\Omega),\n\\qquad p\\in H_0^1(\\Omega)\n\\label{eq:app1-H2-dirichlet-problem}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p330-005-5ec95e727d36c0a1", "chapter": "appendix-01", "source_pdf_page": 330, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 264, "display_type": "numbered-equation", "source_number": "1.16", "label": "eq:app1-H1-projection", "latex": "\\begin{equation}\nu_1=P_{H_1}u=\\operatorname{grad}q,\n\\label{eq:app1-H1-projection}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p330-006-f67ef753af5da5bf", "chapter": "appendix-01", "source_pdf_page": 330, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 269, "display_type": "numbered-equation", "source_number": "1.17", "label": "eq:app1-H1-neumann-problem", "latex": "\\begin{equation}\n\\Delta q=0\\quad\\text{在 }\\Omega\\text{ 中},\n\\qquad\\frac{\\partial q}{\\partial\\nu}=\\gamma_\\nu(u-\\operatorname{grad}p)\n\\quad\\text{在 }\\Gamma\\text{ 上}\n\\label{eq:app1-H1-neumann-problem}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p330-007-0bac69e0a558bea4", "chapter": "appendix-01", "source_pdf_page": 330, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 278, "display_type": "numbered-equation", "source_number": "1.18", "label": "eq:app1-Hc-projection-system", "latex": "\\begin{equation}\n\\sum_{i=1}^N\\alpha_{ij}a_i\n=\\int_{\\Sigma_j}u\\cdot\\nu\\,d\\Sigma,\n\\qquad1\\leq j\\leq N,\n\\label{eq:app1-Hc-projection-system}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p330-008-6e0179aabda70a15", "chapter": "appendix-01", "source_pdf_page": 330, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 285, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\alpha_{ij}=\\int_{\\Sigma_j}\\frac{\\partial q_i}{\\partial\\nu_j}\\,d\\Sigma\n=\\int_{\\Sigma_i}\\frac{\\partial q_j}{\\partial\\nu_i}\\,d\\Sigma\n=(\\operatorname{grad}q_i,\\operatorname{grad}q_j).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p331-001-fb4168280432b2ec", "chapter": "appendix-01", "source_pdf_page": 331, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 302, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\operatorname{curl}H^1(\\Omega)\n=\\operatorname{curl}(H^1(\\Omega)\\cap H_0).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p331-002-21d15b350b55bda9", "chapter": "appendix-01", "source_pdf_page": 331, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 316, "display_type": "numbered-equation", "source_number": "1.19", "label": "eq:app1-curl-H1-estimate", "latex": "\\begin{equation}\n\\lVert u\\rVert_{H^1(\\Omega)}\\leq c_0|\\operatorname{curl}u|,\n\\label{eq:app1-curl-H1-estimate}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p331-003-1cd90f448fa57290", "chapter": "appendix-01", "source_pdf_page": 331, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 320, "display_type": "numbered-equation", "source_number": "1.20", "label": "eq:app1-curl-L2-estimate", "latex": "\\begin{equation}\n|u|\\leq c_0|\\operatorname{curl}u|.\n\\label{eq:app1-curl-L2-estimate}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p331-004-5e77f20863eba281", "chapter": "appendix-01", "source_pdf_page": 331, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 328, "display_type": "numbered-equation", "source_number": "1.21", "label": "eq:app1-div-curl-trace-space", "latex": "\\begin{equation}\n\\{u\\in H^1(\\Omega):\\gamma_\\nu u=u\\cdot\\nu|_\\Gamma=0\\}\n=\\{u\\in L^2(\\Omega):\\operatorname{div}u,\\operatorname{curl}u\\in L^2(\\Omega),\n\\ \\gamma_\\nu u=0\\text{ 在 }\\Gamma\\text{ 上}\\},\n\\label{eq:app1-div-curl-trace-space}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p331-005-af56cc3c710f6f50", "chapter": "appendix-01", "source_pdf_page": 331, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 335, "display_type": "numbered-equation", "source_number": "1.22", "label": "eq:app1-div-curl-H1-estimate", "latex": "\\begin{equation}\n\\lVert u\\rVert_{H^1(\\Omega)}\n\\leq c_1\\{|u|+|\\operatorname{div}u|+|\\operatorname{curl}u|\\}.\n\\label{eq:app1-div-curl-H1-estimate}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p331-006-d79bea608300c99f", "chapter": "appendix-01", "source_pdf_page": 331, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 343, "display_type": "numbered-equation", "source_number": "1.23", "label": "eq:app1-curl-contradiction-sequence", "latex": "\\begin{equation}\n|u_m|>m|\\operatorname{curl}u_m|,\n\\qquad\\forall m.\n\\label{eq:app1-curl-contradiction-sequence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p331-007-00592f608ac0057c", "chapter": "appendix-01", "source_pdf_page": 331, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 367, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n(\\operatorname{curl}H^1(\\Omega))^\\perp\n=\\{u\\in L^2(\\Omega):u=\\operatorname{grad}p,\n\\ p\\in H^1(\\Omega),\\ p\\text{ 在每个 }\\Gamma_i\\text{ 上为常数}\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p331-008-b2ae0a252062e07a", "chapter": "appendix-01", "source_pdf_page": 331, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 376, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n(u,\\operatorname{curl}\\varphi)=0,\n\\qquad\\forall\\varphi\\in\\mathcal D(\\Omega),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p331-009-996bf0e9e097082c", "chapter": "appendix-01", "source_pdf_page": 331, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 381, "display_type": "numbered-equation", "source_number": "1.24", "label": "eq:app1-generalized-curl-stokes", "latex": "\\begin{equation}\n(u,\\operatorname{curl}\\varphi)\n=(\\operatorname{curl}u,\\varphi)\n+\\langle u\\wedge\\nu|_\\Gamma,\\gamma_0\\varphi\\rangle,\n\\qquad\\forall\\varphi\\in H^1(\\Omega).\n\\label{eq:app1-generalized-curl-stokes}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p332-001-11aa3bdd4edd8653", "chapter": "appendix-01", "source_pdf_page": 332, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 391, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n(\\operatorname{curl}H^1(\\Omega))^\\perp\n=\\{u\\in L^2(\\Omega):\\operatorname{curl}u=0,\n\\ u\\wedge\\nu|_\\Gamma=0\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p332-002-0e6b96231a0bb9cd", "chapter": "appendix-01", "source_pdf_page": 332, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 403, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\operatorname{curl}H^1(\\Omega)\n=\\left\\{u\\in L^2(\\Omega):\\operatorname{div}u=0,\n\\ \\int_{\\Gamma_i}u\\cdot\\nu\\,d\\Gamma=0,\n\\ \\forall i\\right\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p332-003-ed90fcc67cf48339", "chapter": "appendix-01", "source_pdf_page": 332, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 413, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n(u,v)=\\int_\\Omega u\\cdot\\operatorname{grad}p\\,dx\n=\\int_\\Gamma\\gamma_\\nu u\\,p\\,d\\Gamma\n=\\sum_{i=1}^kp(\\Gamma_i)\\int_{\\Gamma_i}\\gamma_\\nu u\\,d\\Gamma.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p332-004-a6ef5eb04379cbec", "chapter": "appendix-01", "source_pdf_page": 332, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 425, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\operatorname{curl}H^1(\\Omega)\n=\\{u\\in L^2(\\Omega):\\operatorname{div}u=0\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p332-005-87fd67032ec25109", "chapter": "appendix-01", "source_pdf_page": 332, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 446, "display_type": "numbered-equation", "source_number": "1.25", "label": "eq:app1-div-curl-regularity-space", "latex": "\\begin{equation}\n\\begin{aligned}\nH^m(\\Omega)=\\{u\\in L^2(\\Omega):\n&\\operatorname{curl}u\\in H^{m-1}(\\Omega),\n\\ \\operatorname{div}u\\in H^{m-1}(\\Omega),\\\\\n&\\gamma_\\nu u\\in H^{m-1/2}(\\Gamma)\\},\n\\end{aligned}\n\\label{eq:app1-div-curl-regularity-space}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p332-006-bcb8ba5b5f6edd85", "chapter": "appendix-01", "source_pdf_page": 332, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 456, "display_type": "numbered-equation", "source_number": "1.26", "label": "eq:app1-div-curl-regularity-estimate", "latex": "\\begin{equation}\n\\lVert u\\rVert_{H^m(\\Omega)}\n\\leq c_2\\{|u|+\\lVert\\operatorname{curl}u\\rVert_{H^{m-1}(\\Omega)}\n+|\\operatorname{div}u|_{H^{m-1}(\\Omega)}\n+|\\gamma_\\nu u|_{H^{m-1/2}(\\Gamma)}\\}.\n\\label{eq:app1-div-curl-regularity-estimate}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p333-001-ff9d9551c4bfd03d", "chapter": "appendix-01", "source_pdf_page": 333, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 468, "display_type": "numbered-equation", "source_number": "1.27", "label": "eq:app1-neumann-regularity-problem", "latex": "\\begin{equation}\n\\Delta p=\\operatorname{div}u\\quad\\text{在 }\\Omega\\text{ 中},\n\\qquad\\frac{\\partial p}{\\partial\\nu}=u\\cdot\\nu\n\\quad\\text{在 }\\Gamma\\text{ 上}\n\\label{eq:app1-neumann-regularity-problem}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p333-002-4dae84694c9fa910", "chapter": "appendix-01", "source_pdf_page": 333, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 475, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\lVert p\\rVert_{H^2(\\Omega)/\\mathbb R}\n\\leq c_3\\left\\{|\\Delta p|_{L^2(\\Omega)}\n+\\left|\\frac{\\partial p}{\\partial\\nu}\\right|_{H^{1/2}(\\Gamma)}\\right\\}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p333-003-05009e79484ef744", "chapter": "appendix-01", "source_pdf_page": 333, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 483, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nv,\\operatorname{curl}v,\\operatorname{div}v\\in L^2(\\Omega),\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p333-004-08dcabe7060733ba", "chapter": "appendix-01", "source_pdf_page": 333, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 486, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nv\\cdot\\nu\n=D^{m-1}(u\\cdot\\nu)\n-\\sum_{i=1}^{m-1}\\binom{m-1}{i}D^i\\nu\\,D^{m-1-i}u\n\\in H^{1/2}(\\Gamma).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p333-005-04132c0699610ccc", "chapter": "appendix-01", "source_pdf_page": 333, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 501, "display_type": "numbered-equation", "source_number": "1.28", "label": "eq:app1-div-curl-projected-estimate", "latex": "\\begin{equation}\n\\begin{aligned}\n\\lVert u-P_{H_c}u\\rVert_{H^m(\\Omega)}\n\\leq c_3\\{&\\lVert\\operatorname{curl}u\\rVert_{H^{m-1}(\\Omega)}\n+|\\operatorname{div}u|_{H^{m-1}(\\Omega)}\\\\\n&+|\\gamma_\\nu u|_{H^{m-1/2}(\\Gamma)}\\}.\n\\end{aligned}\n\\label{eq:app1-div-curl-projected-estimate}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p333-006-aa80dbbad05ae61c", "chapter": "appendix-01", "source_pdf_page": 333, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 521, "display_type": "numbered-equation", "source_number": "2.1", "label": "eq:app1-boundary-component-flux", "latex": "\\begin{equation}\n\\int_{\\Gamma_i}\\varphi\\cdot\\nu\\,d\\Gamma=0,\n\\qquad i=1,\\ldots,k.\n\\label{eq:app1-boundary-component-flux}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p333-007-92574d3df99a3e3f", "chapter": "appendix-01", "source_pdf_page": 333, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 531, "display_type": "numbered-equation", "source_number": "2.2", "label": "eq:app1-boundary-curl-trace", "latex": "\\begin{equation}\n\\varphi\\in\\gamma_0\\{\\operatorname{curl}H^2(\\Omega)\\}.\n\\label{eq:app1-boundary-curl-trace}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p334-001-62ad266b17ab0863", "chapter": "appendix-01", "source_pdf_page": 334, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 538, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n-\\Delta\\Phi+\\operatorname{grad}\\pi=0,\n\\quad\\operatorname{div}\\Phi=0\\text{ 在 }\\Omega\\text{ 中},\n\\quad\\Phi=\\varphi\\text{ 在 }\\Gamma\\text{ 上},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p334-002-7c7b5bebe2305e24", "chapter": "appendix-01", "source_pdf_page": 334, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 550, "display_type": "numbered-equation", "source_number": "2.3", "label": "eq:app1-total-boundary-flux", "latex": "\\begin{equation}\n\\int_\\Gamma\\varphi\\cdot\\nu\\,d\\Gamma=0,\n\\label{eq:app1-total-boundary-flux}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p334-003-dfb8bc4fbed540b4", "chapter": "appendix-01", "source_pdf_page": 334, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 573, "display_type": "numbered-equation", "source_number": "2.4", "label": "eq:app1-boundary-lifting-domain", "latex": "\\begin{equation}\n\\dot H^{3/2}(\\Gamma)\n=\\left\\{\\varphi\\in H^{3/2}(\\Gamma):\n\\int_{\\Gamma_i}\\varphi\\cdot\\nu\\,d\\Gamma=0,\n\\ i=1,\\ldots,k\\right\\}\n\\label{eq:app1-boundary-lifting-domain}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p334-004-cd5ca8cb4d087e5b", "chapter": "appendix-01", "source_pdf_page": 334, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 581, "display_type": "numbered-equation", "source_number": "2.5", "label": "eq:app1-boundary-lifting-divergence", "latex": "\\begin{equation}\n\\operatorname{div}\\Lambda_\\delta\\varphi=0\n\\quad\\text{在 }\\Omega\\text{ 中},\n\\label{eq:app1-boundary-lifting-divergence}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p334-005-3b50fd852d62d673", "chapter": "appendix-01", "source_pdf_page": 334, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 586, "display_type": "numbered-equation", "source_number": "2.6", "label": "eq:app1-boundary-lifting-trace", "latex": "\\begin{equation}\n\\gamma_0\\Lambda_\\delta\\varphi=\\varphi\n\\quad\\text{在 }\\Gamma\\text{ 上},\n\\label{eq:app1-boundary-lifting-trace}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p334-006-178b4f867e1b9dfc", "chapter": "appendix-01", "source_pdf_page": 334, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 591, "display_type": "numbered-equation", "source_number": "2.7", "label": "eq:app1-boundary-lifting-trilinear", "latex": "\\begin{equation}\n|b(v,\\Lambda_\\delta\\varphi,v)|\n\\leq\\delta\\lVert\\varphi\\rVert_{H^{3/2}(\\Gamma)}\\lVert v\\rVert^2,\n\\qquad\\forall\\varphi\\in\\dot H^{3/2}(\\Gamma),\n\\quad\\forall v\\in V.\n\\label{eq:app1-boundary-lifting-trilinear}\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p334-007-7fda7fc204f0075d", "chapter": "appendix-01", "source_pdf_page": 334, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 602, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n\\operatorname{curl}H^2(\\Omega)\n=\\{u\\in H^1(\\Omega):\\operatorname{div}u=0,\n\\ \\int_{\\Gamma_i}u\\cdot\\nu\\,d\\Gamma=0,\n\\ \\forall i\\},\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-appendix-01-p335-001-96ab73cb924c392a", "chapter": "appendix-01", "source_pdf_page": 335, "tex_file": "tex/chapters/appendix-01.tex", "tex_line": 618, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\nu(x,t)=\\varphi(x,y),\n\\qquad x\\in\\Gamma,\\quad 0<t<T.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
