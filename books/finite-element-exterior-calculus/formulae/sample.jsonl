{"id": "formula-c215d71e662066eb", "source_latex": "\n\\begin{aligned}\nF^1\\operatorname{grad}\\phi([x_0,x_1])\n&=\\int_{[x_0,x_1]}\\operatorname{grad}\\phi\\cdot t\n&&\\text{{(definition of $F^1$)}}\\\\\n&=\\phi(x_1)-\\phi(x_0)\n&&\\text{{(fundamental theorem of calculus)}}\\\\\n&=F^0\\phi([x_1]-[x_0])\n&&\\text{{(definition of $F^0$)}}\\\\\n&=F^0\\phi(\\partial_1[x_0,x_1])\n&&\\text{{(definition of $\\partial_1$)}}\\\\\n&=\\partial^0F^0\\phi([x_0,x_1])\n&&(\\partial^0=\\partial'_1).\n\\end{aligned}\n", "tokens": ["\\begin", "{", "a", "l", "i", "g", "n", "e", "d", "}", "F", "^", "1", "\\operatorname", "{", "g", "r", "a", "d", "}", "\\phi", "(", "[", "x", "_", "0", ",", "x", "_", "1", "]", ")", "&", "=", "\\int", "_", "{", "[", "x", "_", "0", ",", "x", "_", "1", "]", "}", "\\operatorname", "{", "g", "r", "a", "d", "}", "\\phi", "\\cdott", "&", "&", "F", "^", "1", "\\\\", "&", "=", "\\phi", "(", "x", "_", "1", ")", "-", "\\phi", "(", "x", "_", "0", ")", "&", "&", "\\\\", "&", "=", "F", "^", "0", "\\phi", "(", "[", "x", "_", "1", "]", "-", "[", "x", "_", "0", "]", ")", "&", "&", "F", "^", "0", "\\\\", "&", "=", "F", "^", "0", "\\phi", "(", "\\partial", "_", "1", "[", "x", "_", "0", ",", "x", "_", "1", "]", ")", "&", "&", "\\partial", "_", "1", "\\\\", "&", "=", "\\partial", "^", "0", "F", "^", "0", "\\phi", "(", "[", "x", "_", "0", ",", "x", "_", "1", "]", ")", "&", "&", "(", "\\partial", "^", "0", "=", "\\partial", "'", "_", "1", ")", ".", "\\end", "{", "a", "l", "i", "g", "n", "e", "d", "}"], "source_location": {"page": 28, "bbox": [55, 54, 430, 671]}, "confidence": 0.99, "review_status": "reviewed", "label": null, "number": null}
