\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ajbook-page-layout}[2026/11/18 Shared AJbook page layout]
\RequirePackage{etoolbox}

% AJbook configures geometry at the end of the preamble. Apply this profile
% after the class defaults and before any page (including the cover) is set.
\AtEndPreamble{%
  \geometry{%
    reset,
    a4paper,
    includehead,
    top=6mm,
    bottom=18mm,
    textwidth=170mm,
    headheight=5ex,
    headsep=5ex
  }%
  \setlength{\parskip}{0pt}%
  \raggedbottom
}
\endinput
