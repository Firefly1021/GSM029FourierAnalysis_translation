# Python caches and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# LaTeX intermediate files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb

# Logs (retain the directory marker)
logs/*
!logs/.gitkeep

# Temporary page images (retain the directory marker)
workspace/pages/*
!workspace/pages/.gitkeep

# OCR and other temporary results (retain the directory marker)
workspace/raw-text/*
!workspace/raw-text/.gitkeep
workspace/layout/*
!workspace/layout/.gitkeep
workspace/formula-images/*
!workspace/formula-images/.gitkeep
workspace/temporary/*
!workspace/temporary/.gitkeep

# Final build caches (retain required directory markers)
output/cache/
output/.cache/
tex/generated/*
!tex/generated/.gitkeep

# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*.swo
