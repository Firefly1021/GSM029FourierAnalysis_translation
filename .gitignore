# Python caches and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# LaTeX intermediate files
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.log
*.lot
*.nav
*.out
*.run.xml
*.snm
*.synctex.gz
*.toc
*.vrb
*.xdv

# Per-book logs: keep directory markers only
books/*/logs/*
!books/*/logs/.gitkeep

# Per-book page, OCR, layout, formula-image, and build caches
books/*/workspace/pages/*
!books/*/workspace/pages/.gitkeep
books/*/workspace/raw-text/*
!books/*/workspace/raw-text/.gitkeep
books/*/workspace/layout/*
!books/*/workspace/layout/.gitkeep
books/*/workspace/formula-images/*
!books/*/workspace/formula-images/.gitkeep
books/*/workspace/temporary/*
!books/*/workspace/temporary/.gitkeep

# Per-book generated/build caches; required TeX/Bib sources remain trackable
books/*/output/cache/
books/*/output/.cache/
books/*/tex/generated/cache/
books/*/.build/

# Recoverable pre-consolidation checkouts and duplicate old-main snapshots
shared/.legacy-worktrees/
shared/.migration-backup/
shared/out/
shared/input/
shared/config/runtime.local.json

# Temporary comparison copies and superseded cover previews, not deliverables
shared/qa/feec-cover-20261023/before.pdf
shared/qa/feec-cover-20261023/first-cover.png
shared/qa/feec-cover-20261023/after-title.png

# Editor and operating-system files
.DS_Store
Thumbs.db
*.swp
*.swo
