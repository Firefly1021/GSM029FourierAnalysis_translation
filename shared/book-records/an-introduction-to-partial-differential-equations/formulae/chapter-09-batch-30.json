    {
      "formula_id": "math:interior-full-cutoff-integration-chain:001",
      "source_latex": "\\[\\begin{aligned}\n\\int_\\Omega\\zeta^2|\\Delta u|^2\\,\\mathrm{d}\\bm{x}\n&=\\sum_{i,j=1}^n\\int_\\Omega u_{x_ix_i}u_{x_jx_j}\\zeta^2\\,\\mathrm{d}\\bm{x}\\\\\n&=-\\sum_{i,j=1}^n\\int_\\Omega u_{x_i}u_{x_jx_ix_j}\\zeta^2\\,\\mathrm{d}\\bm{x}\\\\\n&\\quad-\\sum_{i,j=1}^n\\int_\\Omega u_{x_i}u_{x_jx_j}2\\zeta\\zeta_{x_i}\\,\\mathrm{d}\\bm{x}\\\\\n&=\\sum_{i,j=1}^n\\int_\\Omega u_{x_ix_j}u_{x_jx_i}\\zeta^2\\,\\mathrm{d}\\bm{x}\\\\\n&\\quad+\\sum_{i,j=1}^n\\int_\\Omega u_{x_i}u_{x_jx_i}2\\zeta\\zeta_{x_j}-u_{x_i}u_{x_jx_j}2\\zeta\\zeta_{x_i}\\,\\mathrm{d}\\bm{x}.\n\\end{aligned}\\]",
      "kind": "display",
      "source_locations": [
        {
