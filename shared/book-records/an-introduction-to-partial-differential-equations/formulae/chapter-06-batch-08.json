    {
      "formula_id": "math:bessel-parseval-full-proof:004",
      "source_latex": "\\[\n\\begin{aligned}\n0&\\leq\\left\\|x-\\sum_{i\\in J}(x_i,x)x_i\\right\\|^2\\\\\n&=\\left(x-\\sum_{i\\in J}(x_i,x)x_i,x-\\sum_{l\\in J}(x_l,x)x_l\\right)\\\\\n&=\\|x\\|^2-\\sum_{i\\in J}(x_i,x)(x,x_i)-\\sum_{l\\in J}(x,x_l)(x_l,x)\\\\\n&\\quad+\\left(\\sum_{i\\in J}(x_i,x)x_i,\\sum_{l\\in J}(x_l,x)x_l\\right)\\\\\n&=\\|x\\|^2-2\\sum_{i\\in J}|(x_i,x)|^2+\\sum_{i\\in J}\\sum_{l\\in J}\\overline{(x_i,x)}(x_l,x)(x_i,x_l)\\\\\n&=\\|x\\|^2-\\sum_{i\\in J}|(x_i,x)|^2.\n\\end{aligned}\n\\]",
      "kind": "display",
      "source_locations": [
