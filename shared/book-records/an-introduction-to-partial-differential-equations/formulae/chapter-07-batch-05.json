    {
      "formula_id": "math:fractional-order-sobolev-intrinsic-inner-product:003",
      "source_latex": "\\begin{equation}\\label{eq:fractional-sobolev-intrinsic-inner-product}\n\\begin{aligned}\n(u,v)_s&=(u,v)_{[s]}\\\\\n&\\quad+\\sum_{|\\alpha|=[s]}\\int_{\\mathbb{R}^m}\\int_{\\mathbb{R}^m}\n\\dfrac{(D^\\alpha\\bar u(\\bm{x})-D^\\alpha\\bar u(\\bm{y}))(D^\\alpha v(\\bm{x})-D^\\alpha v(\\bm{y}))}{|\\bm{x}-\\bm{y}|^{m+2(s-[s])}}\\,\\mathrm{d}\\bm{x}\\,\\mathrm{d}\\bm{y}.\n\\end{aligned}\n\\end{equation}",
