    {
      "formula_id": "math:second-order-garding-entire-proof:001",
      "source_latex": "\\[\\begin{aligned}\nB[u,u]&:=-\\sum_{i,j=1}^n\\int_\\Omega a_{ij}(\\bm{x})u_{x_i}u_{x_j}\\,\\mathrm{d}\\bm{x}\\\\\n&\\quad+\\sum_{i=1}^n\\int_\\Omega b_i(\\bm{x})u_{x_i}u\\,\\mathrm{d}\\bm{x}+\\int_\\Omega c(\\bm{x})u^2\\,\\mathrm{d}\\bm{x}\\\\\n&\\geq\\theta\\int_\\Omega|\\nabla u|^2\\,\\mathrm{d}\\bm{x}-\\max\\|b_i\\|_{L^\\infty(\\Omega)}\\int_\\Omega|\\nabla u|\\,|u|\\,\\mathrm{d}\\bm{x}\\\\\n&\\quad-\\|c\\|_{L^\\infty(\\Omega)}\\int_\\Omega|u|^2\\,\\mathrm{d}\\bm{x}.\n\\end{aligned}\\]",
      "kind": "display",
