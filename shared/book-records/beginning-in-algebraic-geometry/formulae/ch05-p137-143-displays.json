    "latex": "\\begin{aligned}\n      \\Bigl(\\sum_{\\alpha}b_{\\alpha}x^{\\alpha}\\Bigr)+\n      \\Bigl(\\sum_{\\alpha}c_{\\alpha}x^{\\alpha}\\Bigr)\n        &=\\sum_{\\alpha}(b_{\\alpha}+c_{\\alpha})x^{\\alpha},\\\\\n      r\\cdot\\Bigl(\\sum_{\\alpha}b_{\\alpha}x^{\\alpha}\\Bigr)\n        &=\\sum_{\\alpha}(rb_{\\alpha})x^{\\alpha}.\n    \\end{aligned}"
  },
