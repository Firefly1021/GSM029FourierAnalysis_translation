    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 13,
    "latex": "X\\times Y=\\mathcal{V}(y-x^{2},z-1)\\subseteq\\mathbb{A}^{3}"
  },
  {
    "id": "ch08-sec02-display-02",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
