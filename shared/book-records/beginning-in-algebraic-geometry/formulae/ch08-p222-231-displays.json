      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 21,
    "latex": "X\\times Y=\\mathcal{V}(x)\\cup\\mathcal{V}(y)\\subseteq\\mathbb{A}^{3},"
  },
  {
    "id": "ch08-sec02-display-03",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 34,
    "latex": "\\label{eq:product-as-union-of-two-varieties}\n  X\\times Y=Z_{1}\\cup Z_{2}."
  },
  {
    "id": "ch08-sec02-display-04",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 39,
    "latex": "\\{a\\}\\times Y\\subseteq X\\times Y."
  },
  {
    "id": "ch08-sec02-display-05",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 43,
    "latex": "\\{a\\}\\times Y\n    =\\bigl((\\{a\\}\\times Y)\\cap Z_{1}\\bigr)\\cup\n     \\bigl((\\{a\\}\\times Y)\\cup Z_{2}\\bigr)."
  },
  {
    "id": "ch08-sec02-display-06",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 49,
    "latex": "(\\{a\\}\\times Y)\\cap Z_{1}=\\{a\\}\\times Y\n  \\quad\\text{或}\\quad\n  (\\{a\\}\\times Y)\\cap Z_{2}=\\{a\\}\\times Y."
  },
  {
    "id": "ch08-sec02-display-07",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 55,
    "latex": "X_{1}=\\{a\\in X\\mid\\{a\\}\\times Y\\subseteq Z_{1}\\}\n  \\quad\\text{且}\\quad\n  X_{2}=\\{a\\in X\\mid\\{a\\}\\times Y\\subseteq Z_{2}\\},"
  },
  {
    "id": "ch08-sec02-display-08",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 61,
    "latex": "\\label{eq:base-as-union-of-full-fiber-loci}\n  X_{1}\\cup X_{2}=X."
  },
  {
    "id": "ch08-sec02-display-09",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 65,
    "latex": "Z_{1}=\\mathcal{V}(f_{1},\\ldots,f_{r})"
  },
  {
    "id": "ch08-sec02-display-10",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 69,
    "latex": "(X_{1})_{b}=\\mathcal{V}\\bigl(f_{1}(x,b),\\ldots,f_{r}(x,b)\\bigr)\\subseteq\\mathbb{A}^{m},"
  },
  {
    "id": "ch08-sec02-display-11",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 73,
    "latex": "(X_{1})_{b}=\\{a\\in\\mathbb{A}^{m}\\mid(a,b)\\in Z_{1}\\}."
  },
  {
    "id": "ch08-sec02-display-12",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 77,
    "latex": "X_{1}=\\{a\\in X\\mid(a,b)\\in Z_{1}\\text{ 对所有 }b\\in Y\\}\n    =X\\cap\\bigcap_{b\\in Y}(X_{1})_{b},"
  },
  {
    "id": "ch08-sec02-display-13",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 96,
    "latex": "\\dim(X\\times Y)=\\dim(X)+\\dim(Y)."
  },
  {
    "id": "ch08-sec02-display-14",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 110,
    "latex": "\\mathcal{V}(f)\\cap(X\\times Y)=(\\mathcal{V}(f)\\cap X)\\times Y."
  },
  {
    "id": "ch08-sec02-display-15",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 114,
    "latex": "\\begin{aligned}\n    \\dim(X\\times Y)&=\\dim(\\mathcal{V}(f)\\cap(X\\times Y))+1\\\\\n      &=\\dim((\\mathcal{V}(f)\\cap X)\\times Y)+1\\\\\n      &=(\\dim(X)-1)+\\dim(Y)+1=\\dim(X)+\\dim(Y),\n  \\end{aligned}"
  },
  {
    "id": "ch08-sec02-display-16",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 128,
    "latex": "L_{(a,b)}(X\\times Y)=L_{a}X\\times L_{b}Y\n  \\quad\\text{且}\\quad\n  T_{(a,b)}(X\\times Y)=T_{a}X\\oplus T_{b}Y."
  },
  {
    "id": "ch08-sec02-display-17",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 136,
    "latex": "\\mathcal{I}(X\\times Y)=\\langle f_{1},\\ldots,f_{k},g_{1},\\ldots,g_{\\ell}\\rangle."
  },
  {
    "id": "ch08-sec02-display-18",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 140,
    "latex": "\\begin{aligned}\n    L_{a}X&=\\mathcal{V}(L_{a}f_{1},\\ldots,L_{a}f_{k}),\\\\\n    L_{b}Y&=\\mathcal{V}(L_{b}g_{1},\\ldots,L_{b}g_{\\ell}),\\\\\n    L_{(a,b)}(X\\times Y)&=\\mathcal{V}(L_{a}f_{1},\\ldots,L_{a}f_{k},L_{b}g_{1},\\ldots,L_{b}g_{\\ell}),\n  \\end{aligned}"
  },
  {
    "id": "ch08-sec02-display-19",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 150,
    "latex": "T_{a}X=\\{\\overrightarrow{aa'}\\mid a'\\in L_{a}X\\}\\subseteq K^{m}\n  \\quad\\text{且}\\quad\n  T_{b}Y=\\{\\overrightarrow{bb'}\\mid b'\\in L_{b}Y\\}\\subseteq K^{n}."
  },
  {
    "id": "ch08-sec02-display-20",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 156,
    "latex": "\\bigl(\\overrightarrow{aa'},\\overrightarrow{bb'}\\bigr)"
  },
  {
    "id": "ch08-sec02-display-21",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 160,
    "latex": "\\bigl(\\overrightarrow{aa'},\\overrightarrow{bb'}\\bigr)\n    =\\overrightarrow{(a,b)(a',b')}."
  },
  {
    "id": "ch08-sec02-display-22",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 165,
    "latex": "T_{a}X\\oplus T_{b}Y\n    =\\{\\overrightarrow{(a,b)(a',b')}\\mid(a',b')\\in L_{a}X\\times L_{b}Y\\}\n    =T_{(a,b)}(X\\times Y),"
  },
  {
    "id": "ch08-sec02-display-23",
    "unit": "ch08-sec02",
    "source_pdf_page_range": [
      227,
      231
    ],
    "printed_page_range": [
      220,
      224
    ],
    "tex_path": "tex/chapters/ch08-sec02.tex",
    "tex_line": 180,
    "latex": "\\begin{aligned}\n    \\dim(X\\times Y)&=\\dim(X)+\\dim(Y)\\\\\n      &=\\dim(T_{a}X)+\\dim(T_{b}Y)\\\\\n      &=\\dim(T_{a}X\\oplus T_{b}Y)\\\\\n      &=\\dim(T_{(a,b)}(X\\times Y)),\n  \\end{aligned}"
  }
]
