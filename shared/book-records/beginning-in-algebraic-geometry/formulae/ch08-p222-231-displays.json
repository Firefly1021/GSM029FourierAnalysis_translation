    ],
    "tex_path": "tex/chapters/ch08-sec01.tex",
    "tex_line": 126,
    "latex": "K[X]\\star K[Y]=K[X\\times Y]."
  },
  {
    "id": "ch08-sec01-display-19",
    "unit": "ch08-sec01",
    "source_pdf_page_range": [
