      219
    ],
    "tex_path": "tex/chapters/ch08-sec01.tex",
    "tex_line": 130,
    "latex": "K[x]\\star K[y]=K[x,y],"
  },
  {
    "id": "ch08-sec01-display-20",
    "unit": "ch08-sec01",
    "source_pdf_page_range": [
      223,
      226
    ],
    "printed_page_range": [
      216,
      219
    ],
    "tex_path": "tex/chapters/ch08-sec01.tex",
    "tex_line": 136,
    "latex": "\\begin{aligned}\n    (a_{1},b_{1})+(a_{2},b_{2})&=(a_{1}+a_{2},b_{1}+b_{2}),\\\\\n    (a_{1},b_{1})\\cdot(a_{2},b_{2})&=(a_{1}a_{2},b_{1}b_{2}),\n  \\end{aligned}"
  },
  {
    "id": "ch08-sec01-display-21",
