    "tex_path": "tex/chapters/ch08-sec01.tex",
    "tex_line": 82,
    "latex": "\\langle\\mathcal{I}(X)\\rangle+\\langle\\mathcal{I}(Y)\\rangle\\subseteq\\mathcal{I}(X\\times Y)."
  },
  {
    "id": "ch08-sec01-display-12",
    "unit": "ch08-sec01",
