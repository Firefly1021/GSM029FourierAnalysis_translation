    "tex_path": "tex/chapters/ch08-sec01.tex",
    "tex_line": 57,
    "latex": "\\mathcal{I}(X\\times Y)=\\langle\\mathcal{I}(X)\\rangle+\\langle\\mathcal{I}(Y)\\rangle,"
