    ],
    "printed_page_range": [
      216,
      219
    ],
    "tex_path": "tex/chapters/ch08-sec01.tex",
    "tex_line": 91,
    "latex": "\\begin{aligned}\n    h&=f_{1}g_{1}+\\cdots+f_{j}g_{j}+f_{j+1}g_{j+1}+\\cdots+f_{k}g_{k}\\\\\n     &\\in\\langle\\mathcal{I}(X)\\rangle+\\langle\\mathcal{I}(Y)\\rangle,\n  \\end{aligned}"
  },
  {
    "id": "ch08-sec01-display-14",
    "unit": "ch08-sec01",
    "source_pdf_page_range": [
      223,
      226
    ],
    "printed_page_range": [
      216,
      219
    ],
    "tex_path": "tex/chapters/ch08-sec01.tex",
    "tex_line": 100,
    "latex": "g=h(a,y)=f_{1}(a)g_{1}+f_{2}(a)g_{2}+\\cdots+f_{k}(a)g_{k}\n    \\in K[y_{1},\\ldots,y_{n}]."
  },
  {
    "id": "ch08-sec01-display-15",
    "unit": "ch08-sec01",
    "source_pdf_page_range": [
      223,
      226
    ],
    "printed_page_range": [
      216,
      219
    ],
    "tex_path": "tex/chapters/ch08-sec01.tex",
    "tex_line": 105,
    "latex": "g_{1}=f_{1}(a)^{-1}\\bigl(g-f_{2}(a)g_{2}-\\cdots-f_{k}(a)g_{k}\\bigr)."
  },
  {
    "id": "ch08-sec01-display-16",
    "unit": "ch08-sec01",
    "source_pdf_page_range": [
      223,
      226
    ],
    "printed_page_range": [
      216,
      219
    ],
    "tex_path": "tex/chapters/ch08-sec01.tex",
    "tex_line": 109,
    "latex": "\\begin{aligned}\n    h={}&\\bigl(f_{2}-f_{1}(a)^{-1}f_{2}(a)f_{1}\\bigr)g_{2}+\\cdots\\\\\n        &{}+\\bigl(f_{k}-f_{1}(a)^{-1}f_{k}(a)f_{1}\\bigr)g_{k}+f_{1}(a)^{-1}f_{1}g.\n  \\end{aligned}"
  },
  {
    "id": "ch08-sec01-display-17",
    "unit": "ch08-sec01",
    "source_pdf_page_range": [
