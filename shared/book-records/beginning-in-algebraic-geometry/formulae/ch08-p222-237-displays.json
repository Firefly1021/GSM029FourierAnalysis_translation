    "tex_path": "tex/chapters/ch08-sec01.tex",
    "tex_line": 87,
    "latex": "\\label{eq:polynomial-sum-of-separated-products}\n  h=f_{1}g_{1}+\\cdots+f_{k}g_{k}"
  },
  {
    "id": "ch08-sec01-display-13",
