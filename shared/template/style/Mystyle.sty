\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{Mystyle}[2026/01/26 My Math Analysis Package]

\RequirePackage{amsmath, cases, esint,amssymb, mathrsfs, mathtools,physics2,url,stmaryrd,xparse,empheq}
\RequirePackage[scr=boondoxo]{mathalpha}
\RequirePackage{geometry,fontspec}
\RequirePackage[most]{tcolorbox}
