\NewDocumentCommand{\Wkp}{ O{\Omega} m m }{W^{#2,#3}(#1)}

\def\Xint#1{\mathchoice
  {\XXint\displaystyle\textstyle{#1}}%
  {\XXint\textstyle\scriptstyle{#1}}%
  {\XXint\scriptstyle\scriptscriptstyle{#1}}%
  {\XXint\scriptscriptstyle\scriptscriptstyle{#1}}%
  \!\int}
\def\XXint#1#2#3{{\setbox0=\hbox{$#1{#2#3}{\int}$}
  \vcenter{\hbox{$#2#3$}}\kern-.5\wd0}}
\def\ddashint{\Xint=}
\def\fint{\Xint-}

\newcounter{statement}[section]
\renewcommand{\thestatement}{\thesection.\arabic{statement}}

% \newcounter{thmcount}[section]
% \renewcommand{\thethmcount}{\thesection.\arabic{thmcount}}

\NewDocumentEnvironment{Theorem}{g}
{
    \vspace{0.1cm}
    \refstepcounter{statement}
    \begin{tcolorbox}[
        enhanced,
        breakable,
        colback=KuangNei,
        colframe=KuangNei,
        boxrule=0pt,
        arc=3mm,
        outer arc=3mm,
        boxsep=0pt,
        left=4mm,
        right=4mm,
        top=2.5mm,
        bottom=2.5mm,
        before skip=10pt,
        after skip=10pt
    ]
    {\sffamily\bfseries\color{PageColor}
     Theorem~\thestatement
     \IfValueT{#1}{{\mdseries\ (#1)}}}
    \par
    \kaishu
}
{
    \end{tcolorbox}
    \vspace{0.1cm}
}

\NewDocumentEnvironment{Definition}{g}
{
    \refstepcounter{statement}

    {\sffamily
     \bfseries
     \color{PageColor}
     \fontsize{10.95}{13.2}\selectfont
     Definition~\thestatement
     \IfValueT{#1}{
         {\mdseries\ (#1)}
     }
    }
    \kaishu
}
{
    \par
}

