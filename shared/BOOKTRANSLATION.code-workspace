{
  "folders": [
    {
      "name": "Finite Element Exterior Calculus",
      "path": "../books/finite-element-exterior-calculus"
    },
    {
      "name": "Finite Element Methods for Navier-Stokes Equations: Theory and Algorithms",
      "path": "../books/finite-element-methods-for-navier-stokes-equations-theory-and-algorithms"
    },
    {
      "name": "Fourier Analysis",
      "path": "../books/fourier-analysis"
    },
    {
      "name": "Krylov Subspace Methods for Linear Systems",
      "path": "../books/krylov-subspace-methods-for-linear-systems"
    },
    {
      "name": "Mathematical Tools for the Study of the Incompressible Navier-Stokes Equations and Related Models",
      "path": "../books/mathematical-tools-for-the-study-of-the-incompressible-navier-stokes-equations-and-related-models"
    },
    {
      "name": "Navier Stokes Equations Theory and Numerical Analysis",
      "path": "../books/navier-stokes-equations-theory-and-numerical-analysis"
    },
    {
      "name": "The Mathematical Theory of Finite Element Methods",
      "path": "../books/the-mathematical-theory-of-finite-element-methods"
    },
    {
      "name": "共享项目",
      "path": "."
    }
  ],
  "tasks": {
    "version": "2.0.0",
    "tasks": [{
      "label": "编译所选书籍",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder:共享项目}/scripts/mathbook.ps1", "build-book", "${input:book-id}"],
      "problemMatcher": [],
      "group": {"kind": "build", "isDefault": true}
    }],
    "inputs": [{
      "id": "book-id", "type": "pickString", "description": "选择要编译的书籍",
      "options": ["finite-element-exterior-calculus", "finite-element-methods-for-navier-stokes-equations-theory-and-algorithms", "fourier-analysis", "krylov-subspace-methods-for-linear-systems", "mathematical-tools-for-the-study-of-the-incompressible-navier-stokes-equations-and-related-models", "navier-stokes-equations-theory-and-numerical-analysis", "the-mathematical-theory-of-finite-element-methods"]
    }]
  },
  "settings": {
    "files.exclude": {
      ".legacy-worktrees": true,
      ".migration-backup": true
    }
  }
}
