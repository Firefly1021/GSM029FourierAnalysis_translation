{"id": "formula-chapter-02-p052-001-1bb861c156f06e5e", "chapter": 2, "source_pdf_page": 52, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 4, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n M^+f(t)=\\sup_{h>0}\\frac1h\\int_t^{t+h}|f(s)|\\,ds,\n \\qquad\n M^-f(t)=\\sup_{h>0}\\frac1h\\int_{t-h}^{t}|f(s)|\\,ds.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p052-002-6a78c06ba0264c0d", "chapter": 2, "source_pdf_page": 52, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 12, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n f^*(t)=\\inf\\{\\lambda:a_f(\\lambda)\\le t\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p052-003-a11d9c2583a49d80", "chapter": 2, "source_pdf_page": 52, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 18, "display_type": "numbered-equation", "source_number": "2.13", "label": "eq:ch2-one-sided-rearrangement", "latex": "\\begin{equation}\n\\label{eq:ch2-one-sided-rearrangement}\n |\\{x:M^-f(x)>\\lambda\\}|\\le |\\{x:f^{**}(x)>\\lambda\\}|.\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p052-004-30cacae181d063d7", "chapter": 2, "source_pdf_page": 52, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 29, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\lim_{x\\to+\\infty}F(x)=-\\infty,\n \\qquad\n \\lim_{x\\to-\\infty}F(x)=+\\infty.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p052-005-c12108e83997654d", "chapter": 2, "source_pdf_page": 52, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 38, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n E(\\lambda)=\\frac1\\lambda\\int_{E(\\lambda)}|f(x)|\\,dx,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p053-001-9d5932604761ccfb", "chapter": 2, "source_pdf_page": 53, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 45, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n c_n(Mf)^*(t)\\le f^{**}(t)\\le C_n(Mf)^*(t),\n \\qquad t\\in\\mathbb R^+.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p053-002-dd4c8642a44ce0f4", "chapter": 2, "source_pdf_page": 53, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 54, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|f\\|_{p,q}=\\left(\\frac qp\\int_0^\\infty[t^{1/p}f^*(t)]^q\\frac{dt}{t}\\right)^{1/q}<\\infty,\n \\quad 1\\le p<\\infty,\\ 1\\le q<\\infty,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p053-003-bcaa17cf6529d0bc", "chapter": 2, "source_pdf_page": 53, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 59, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|f\\|_{p,\\infty}=\\sup_{t>0}t^{1/p}f^*(t)<\\infty,\n \\quad 1\\le p\\le\\infty.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p053-004-ae6a5e4d68881124", "chapter": 2, "source_pdf_page": 53, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 64, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|f\\|_{p,p}=\\|f^*\\|_p=\\|f\\|_p,\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p053-005-cda5db092c6379f3", "chapter": 2, "source_pdf_page": 53, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 70, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|Tf\\|_{p,\\infty}\\le C\\|f\\|_p.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p053-006-9e8eeeb593eea9a5", "chapter": 2, "source_pdf_page": 53, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 74, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|\\widehat f\\|_{p',p}\\le \\bar B_p\\|f\\|_p.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p054-001-5b1a5231d568a75f", "chapter": 2, "source_pdf_page": 54, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 92, "display_type": "numbered-equation", "source_number": "2.14", "label": "eq:ch2-maximal-restricted-upper", "latex": "\\begin{equation}\n\\label{eq:ch2-maximal-restricted-upper}\n |\\{x\\in\\mathbb R^n:Mf(x)>\\lambda\\}|\\le\\frac C\\lambda\\int_{\\{x:|f(x)|>\\lambda/2\\}}|f(x)|\\,dx,\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p054-002-d603e0fec76fd977", "chapter": 2, "source_pdf_page": 54, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 96, "display_type": "numbered-equation", "source_number": "2.15", "label": "eq:ch2-maximal-restricted-lower", "latex": "\\begin{equation}\n\\label{eq:ch2-maximal-restricted-lower}\n |\\{x\\in\\mathbb R^n:Mf(x)>\\lambda\\}|\\ge\\frac c\\lambda\\int_{\\{x:|f(x)|>\\lambda\\}}|f(x)|\\,dx.\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p054-003-008d22a28bdd3d2b", "chapter": 2, "source_pdf_page": 54, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 103, "display_type": "numbered-equation", "source_number": "2.16", "label": "eq:ch2-luxemburg-norm", "latex": "\\begin{equation}\n\\label{eq:ch2-luxemburg-norm}\n \\|f\\|_{L\\log L(\\Omega)}=\\inf\\left\\{\\lambda>0:\\int_\\Omega\\frac{|f(x)|}{\\lambda}\\log^+\\left(\\frac{|f(x)|}{\\lambda}\\right)dx\\le1\\right\\}.\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p055-001-6806a96ad00dd407", "chapter": 2, "source_pdf_page": 55, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 113, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|Mf\\|_p\\le C_p\\|f\\|_p,\\qquad 1<p<\\infty.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p055-002-fafe558ba40d7734", "chapter": 2, "source_pdf_page": 55, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 117, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n M_Bf(x)=\\sup_{r>0}\\frac1{|rB|}\\int_{rB}|f(x-y)|\\,dy.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p055-003-f007b7f691cfc7de", "chapter": 2, "source_pdf_page": 55, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 121, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|M_Bf\\|_p\\le C_p\\|f\\|_p.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p056-001-f9400e80e142f5ed", "chapter": 2, "source_pdf_page": 56, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 136, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\bigcup_{j\\in\\mathcal J}B_j\\subset\\bigcup_k5B_k.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p056-002-abf640ab7f077e3d", "chapter": 2, "source_pdf_page": 56, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 145, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n A\\subset\\bigcup_jB_j,\n \\qquad\n \\sum_j\\chi_{B_j}(x)\\le C_n.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p056-003-63e428fdc7e348d5", "chapter": 2, "source_pdf_page": 56, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 153, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n M_\\mu f(x)=\\sup_{r>0}\\frac1{\\mu(B_r)}\\int_{B_r}|f(x-y)|\\,d\\mu(y).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p057-001-904c80b8ba6fb8fd", "chapter": 2, "source_pdf_page": 57, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 164, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\Gamma_a(x)=\\{(y,t):|y-x|<at\\}.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p057-002-bea23ca45483f975", "chapter": 2, "source_pdf_page": 57, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 168, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\lim_{\\substack{(y,t)\\to(x,0)\\\\(y,t)\\in\\Gamma_a(x)}}u(y,t)=f(x)\n \\quad\\text{a.e. }x\\in\\mathbb R^n.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p057-003-5d5bd778ac4b8572", "chapter": 2, "source_pdf_page": 57, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 173, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n u_a^*(x)=\\sup_{(y,t)\\in\\Gamma_a(x)}|u(y,t)|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p057-004-846470a520e5eaf5", "chapter": 2, "source_pdf_page": 57, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 177, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n u_a^*(x)\\le C_aMf(x).\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p057-005-51104d6b4d0d59c9", "chapter": 2, "source_pdf_page": 57, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 185, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n M_sf(x)=\\sup_{h_1,\\ldots,h_n>0}\\frac1{|R(h_1,\\ldots,h_n)|}\\int_{R(h_1,\\ldots,h_n)}|f(x-y)|\\,dy.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p058-001-c1172d897610eb17", "chapter": 2, "source_pdf_page": 58, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 191, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n |\\{x\\in\\mathbb R^n:M_sf(x)>\\lambda\\}|\\le C\\int\\frac{|f(x)|}{\\lambda}\\left(1+\\log^+\\frac{|f(x)|}{\\lambda}\\right)^{n-1}dx.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p058-002-809711c4a05a0f32", "chapter": 2, "source_pdf_page": 58, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 195, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\lim_{\\max(h_i)\\to0}\\frac1{|R(h_1,\\ldots,h_n)|}\\int_{R(h_1,\\ldots,h_n)}f(x-y)\\,dy=f(x)\\quad\\text{a.e.}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p058-003-fcdd9f7d022bb602", "chapter": 2, "source_pdf_page": 58, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 205, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\mathcal K_Nf(x)=\\sup_{x\\in R\\in\\mathcal R_N}\\frac1{|R|}\\int_R|f|.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p058-004-9c48694d06fa8811", "chapter": 2, "source_pdf_page": 58, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 209, "display_type": "numbered-equation", "source_number": "2.17", "label": "eq:ch2-kakeya-trivial-bound", "latex": "\\begin{equation}\n\\label{eq:ch2-kakeya-trivial-bound}\n \\mathcal K_Nf(x)\\le C_nN^{n-1}Mf(x).\n\\end{equation}", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p059-001-0750518cbcd0452e", "chapter": 2, "source_pdf_page": 59, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 217, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\|\\mathcal K_Nf\\|_p\\le C_nN^{(n-1)/p}\\|f\\|_p,\n \\qquad 1<p<\\infty.\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
{"id": "formula-chapter-02-p059-002-52244d25160ad17c", "chapter": 2, "source_pdf_page": 59, "tex_file": "tex/chapters/chapter-02-tail.tex", "tex_line": 222, "display_type": "unnumbered-display", "source_number": null, "label": null, "latex": "\\[\n \\begin{aligned}\n p\\ge n:&\\quad \\|\\mathcal K_Nf\\|_p\\le C_n(\\log N)^{\\alpha_p}\\|f\\|_p,\\\\\n 1<p\\le n:&\\quad \\|\\mathcal K_Nf\\|_p\\le C_nN^{n/p-1}(\\log N)^{\\alpha_p}\\|f\\|_p.\n \\end{aligned}\n\\]", "token_checks": {"subscripts": "visually-checked", "superscripts": "visually-checked", "relations": "visually-checked", "signs": "visually-checked", "delimiters": "visually-checked", "domains_and_ranges": "visually-checked"}, "review_status": "reviewed"}
