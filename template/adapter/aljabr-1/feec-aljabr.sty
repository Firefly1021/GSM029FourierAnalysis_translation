\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{feec-aljabr}[2026/10/21 FEEC-only AJbook integration]
% Upstream AJbook stays unmodified. Do not load Mystyle in this profile.
\RequirePackage{xparse}
\RequirePackage{tikz-cd,needspace,refcount,bm,mathrsfs,stmaryrd}
\RequirePackage{enumitem,tabularx,array,multirow,float}
\usetikzlibrary{matrix,decorations.pathreplacing,calc,arrows.meta,positioning}
% Verbatim visual setting from Template-AJbook.tex, not a new style choice.
\renewcommand*\arraystretch{1.5}
\numberwithin{equation}{chapter}
\newcounter{statement}[chapter]
\renewcommand{\thestatement}{\thechapter.\arabic{statement}}
\newcounter{booksummary}[chapter]
\renewcommand{\thebooksummary}{\thechapter.\arabic{booksummary}}
\newcommand{\BookCite}[1]{\begingroup\hypersetup{linkcolor=\@citecolor}\hyperref[bib:source-#1]{[\ref*{bib:source-#1}]}\endgroup}
\newcommand{\BookNumber}[1]{\begingroup\hypersetup{linkcolor=\@citecolor}\hyperref[bib:source-#1]{\ref*{bib:source-#1}}\endgroup}
\newcommand{\BookContentsEntry}[2]{\addtocontents{toc}{\protect\contentsline{chapter}{#1}{\protect\pageref*{#2}}{\getrefbykeydefault{#2}{anchor}{}}}}
\providecommand{\MathBookSourcePage}[1]{}
\providecommand{\MathBookFormulaID}[1]{}
\providecommand{\MathBookReviewStatus}[1]{}
\providecommand{\MBUnresolvedReference}[2]{#2}
% AJbook's own heading/contents depths, paragraph and line-breaking defaults
% remain authoritative. Do not add geometry, font-size or spacing overrides.
% Source summary boxes use exactly the upstream wenxintishi visual keys.
% Only its fixed heading is omitted: the source's Box heading is already
% present in the unchanged content, rather than an invented reading hint.
\newtcolorbox{MBSourceBox}{
    breakable,
    enhanced,
    width = \textwidth,
    colback = white, colbacktitle = white,
    colframe = gray!50, boxrule=0.2mm,
    coltitle = black,
    fonttitle = \sffamily,
    attach boxed title to top left = {yshift=-\tcboxedtitleheight/2, xshift=\tcboxedtitlewidth/4},
    boxed title style = {boxrule=0pt, colframe=white},
    before skip = 0.5cm,
    top = 3mm,
    bottom = 3mm,
    title={}
}
% English names and the original chapter-shared statement numbers are semantic
% requirements; theorem fonts and spacing otherwise come from AJbook.
\AtBeginDocument{%
  \theoremstyle{plain}\theoremsymbol{}%
  \theoremheaderfont{\sffamily\bfseries\thmheiti}%
  \theoremseparator{\ }\theorembodyfont{\fangsong}%
  \newtheorem{AJTheorem}[statement]{Theorem}%
  \newtheorem{AJDefinition}[statement]{Definition}%
  \newtheorem{AJLemma}[statement]{Lemma}%
  \newtheorem{AJProposition}[statement]{Proposition}%
  \newtheorem{AJCorollary}[statement]{Corollary}%
  \theorembodyfont{\songti}%
  \newtheorem{AJExample}[statement]{Example}%
  \newtheorem{AJRemark}[statement]{Remark}%
  \newtheorem{AJExercise}[statement]{Exercise}%
  \theoremstyle{nonumberplain}\theorembodyfont{}%
  \theoremheaderfont{\sffamily\bfseries\CJKfamily{pffont}}%
  \theoremseparator{\enspace}%
  \theoremsymbol{\openbox}\newtheorem{AJProof}{Proof}%
}
\NewDocumentEnvironment{Theorem}{g}{\IfValueTF{#1}{\begin{AJTheorem}[#1]}{\begin{AJTheorem}}}{\end{AJTheorem}}
\NewDocumentEnvironment{Definition}{g}{\IfValueTF{#1}{\begin{AJDefinition}[#1]}{\begin{AJDefinition}}}{\end{AJDefinition}}
\NewDocumentEnvironment{Lemma}{g}{\IfValueTF{#1}{\begin{AJLemma}[#1]}{\begin{AJLemma}}}{\end{AJLemma}}
\NewDocumentEnvironment{Proposition}{g}{\IfValueTF{#1}{\begin{AJProposition}[#1]}{\begin{AJProposition}}}{\end{AJProposition}}
\NewDocumentEnvironment{Corollary}{g}{\IfValueTF{#1}{\begin{AJCorollary}[#1]}{\begin{AJCorollary}}}{\end{AJCorollary}}
\NewDocumentEnvironment{Example}{g}{\IfValueTF{#1}{\begin{AJExample}[#1]}{\begin{AJExample}}}{\end{AJExample}}
\NewDocumentEnvironment{Remark}{g}{\IfValueTF{#1}{\begin{AJRemark}[#1]}{\begin{AJRemark}}}{\end{AJRemark}}
\NewDocumentEnvironment{Exercise}{g}{\IfValueTF{#1}{\begin{AJExercise}[#1]}{\begin{AJExercise}}}{\end{AJExercise}}
\NewDocumentEnvironment{Proof}{}{\begin{AJProof}}{\end{AJProof}}
\endinput
