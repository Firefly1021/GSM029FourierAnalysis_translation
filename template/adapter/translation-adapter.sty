% The source book numbers displayed equations by chapter rather than subsection.
\counterwithout{equation}{subsection}
\numberwithin{equation}{section}

% The source uses one sequence for theorem-like statements. Sharing thmcount
% preserves that sequence while retaining the user's section-based reset rule.
\RenewDocumentEnvironment{Theorem}{o}
{
    \refstepcounter{thmcount}
    \begin{tcolorbox}[
        enhanced,
        breakable,
        colback=KuangNei,
        frame hidden,
        boxrule=0pt,
        sharpish corners,
        before skip=10pt,
        after skip=10pt
    ]
    \noindent
    \textbf{定理~\thethmcount}%
    \IfValueT{#1}{\textbf{~(#1)}}%
    \textbf{:}\quad
    \kaishu
}
{
    \end{tcolorbox}
}

