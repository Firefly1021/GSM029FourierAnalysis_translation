% Compatibility for the unchanged reference TeX, which still requests the
% former body-color name after the user renamed it in Mystyle.sty.
\providecolor{ZhengWen}{RGB}{32,100,100}

% The source book numbers displayed equations by chapter rather than subsection.
\counterwithout{equation}{subsection}
\numberwithin{equation}{section}

% Mystyle.sty now defines a single section-scoped statement counter shared by
% every theorem-like environment. Reusing it preserves the user's numbering and
% makes every translated object referenceable through \label and \ref.
\RenewDocumentEnvironment{Theorem}{g}
{
    \vspace{0.1cm}
    \refstepcounter{statement}
    \begin{tcolorbox}[
        enhanced,
        breakable,
        colback=KuangNei,
        colframe=KuangNei,
        boxrule=0pt,
        arc=3mm,
        outer arc=3mm,
        boxsep=0pt,
        left=4mm,
        right=4mm,
        top=2.5mm,
        bottom=2.5mm,
        before skip=10pt,
        after skip=10pt
    ]
    {\sffamily\bfseries\color{PageColor}
     定理~\thestatement
     \IfValueT{#1}{{\mdseries\ (#1)}}\textbf{:}}
    \par
    \kaishu
}
{
    \end{tcolorbox}
    \vspace{0.1cm}
}

