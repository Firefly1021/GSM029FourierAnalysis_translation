{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mathbook/text-block.schema.json",
  "title": "Text Block",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "block_type", "source_text", "source_location", "confidence", "review_status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "block_type": {"type": "string"},
    "source_text": {"type": "string"},
    "translated_text": {"type": ["string", "null"]},
    "source_location": {"$ref": "#/$defs/sourceLocation"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "review_status": {"$ref": "#/$defs/reviewStatus"},
    "formula_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "bbox": {
      "type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4
    },
    "sourceLocation": {
      "type": "object", "additionalProperties": false, "required": ["page"],
      "properties": {"page": {"type": "integer", "minimum": 1}, "bbox": {"$ref": "#/$defs/bbox"}}
    },
    "reviewStatus": {"enum": ["not-reviewed", "needs-review", "reviewed", "approved", "rejected"]}
  }
}

