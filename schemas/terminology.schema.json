{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mathbook/terminology.schema.json",
  "title": "Terminology, Proper Name, or Notation Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "source_form", "canonical_form", "first_occurrence", "confidence", "review_status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["term", "proper-name", "notation"]},
    "source_form": {"type": "string", "minLength": 1},
    "canonical_form": {"type": ["string", "null"]},
    "context": {"type": ["string", "null"]},
    "language_or_script": {"type": ["string", "null"]},
    "preserve_exactly": {"type": "boolean"},
    "first_occurrence": {"$ref": "#/$defs/sourceLocation"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "review_status": {"enum": ["unreviewed", "needs-review", "approved", "rejected"]},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "sourceLocation": {
      "type": "object", "additionalProperties": false, "required": ["page"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "bbox": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4}
      }
    }
  }
}

