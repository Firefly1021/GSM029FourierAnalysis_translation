{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mathbook/qa-issue.schema.json",
  "title": "QA Issue",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "severity", "message", "confidence", "review_status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "category": {"enum": ["template", "extraction", "structure", "formula", "terminology", "proper-name", "translation", "latex", "source"]},
    "severity": {"enum": ["info", "warning", "error", "blocking"]},
    "message": {"type": "string", "minLength": 1},
    "source_file": {"type": ["string", "null"]},
    "source_location": {
      "type": ["object", "null"], "additionalProperties": false,
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "bbox": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}], "minItems": 4, "maxItems": 4},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "review_status": {"enum": ["not-reviewed", "needs-review", "reviewed", "resolved", "wont-fix"]},
    "details": {"type": "object"}
  }
}

